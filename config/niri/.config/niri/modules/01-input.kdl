input{
  keyboard{
    xkb{
      layout "us,latam"
      options "grp:alt_shift_toggle"
    }
    numlock
  }
  touchpad{
    tap
    dwt
    natural-scroll
    accel-speed 0.1
    accel-profile "adaptive"
    disabled-on-external-mouse
  }
  trackpoint{
    accel-speed 0.2
    accel-profile "flat"
  }
  mouse{
    accel-profile "flat"
    accel-speed 0.2
  }
}
