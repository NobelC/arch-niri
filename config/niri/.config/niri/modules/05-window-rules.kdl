// --- REGLAS GENERALES ---

// Aplica esquinas redondeadas, fuerza el modo columna (sin fullscreen ni flotante por defecto) y usa el 100% de ancho
window-rule {
    geometry-corner-radius 10
    clip-to-geometry true
    open-floating false
    open-fullscreen false
    default-column-width { proportion 1.0; }
}

// --- REGLAS ESPECÍFICAS ---

// Abre utilidades de audio, red y Bluetooth como ventanas flotantes
window-rule {
    match app-id=r#"^(pavucontrol|nm-connection-editor|blueman-manager)$"#
    open-floating true
}

// Mantiene flotantes las ventanas Picture-in-Picture del navegador
window-rule {
    match title="^Picture-in-Picture$"
    open-floating true
}

// Oculta KeePassXC al compartir pantalla o grabar video
window-rule {
    match app-id=r#"^org\.keepassxc\.KeePassXC$"#
    block-out-from "screen-capture"
}

window-rule {
    match app-id=r#"^mpv$"#
    open-fullscreen true
}

window-rule {
    match app-id=r#"^tui\.(float|popup)$"#
    open-floating true
    default-column-width { proportion 0.50; }
    default-window-height { proportion 0.60; }
}
