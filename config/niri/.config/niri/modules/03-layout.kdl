prefer-no-csd
layout {
  // Espaciado
  gaps 10
  // Centrado automático de las columnas
  center-focused-column "never"
  // Anchos definidos al pulsar mod + R
  preset-column-widths {
    proportion 0.33333
    proportion 0.5
    proportion 0.66667
    proportion 1.0
  }
  default-column-width { proportion 1.0; }
  focus-ring {
    off
  }
  border {
    width 3
  }
  shadow {
    on
    softness 0
    spread 0
    offset x=7 y=7
    color "#000000d9"
  }
}

overview {
  zoom 0.65
  workspace-shadow {
    on
    softness 28
    spread 4
    offset x=0 y=8
    color "#00000077"
  }
}

// Coloca swaybg (wallpaper difuminado) exclusivamente en el backdrop del Overview
layer-rule {
  match namespace="^wallpaper$"
  place-within-backdrop true
}
