#!/usr/bin/env bash
set -euo pipefail

INTERNAL="eDP-1"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/arch-niri"
CONFIG_FILE="${CONFIG_DIR}/displays.json"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/quickshell"
HOMES_FILE="${STATE_DIR}/window-homes.json"
CLAMSHELL_FLAG="${STATE_DIR}/clamshell-active"

HDMI_SINK="alsa_output.pci-0000_00_1f.3.pro-output-3"
LAPTOP_SINK="alsa_output.pci-0000_00_1f.3.pro-output-0"

mkdir -p "$CONFIG_DIR" "$STATE_DIR"
[[ -f "$CONFIG_FILE" ]] || echo '{"primary":"eDP-1","monitors":{}}' > "$CONFIG_FILE"
[[ -f "$HOMES_FILE" ]] || echo '{}' > "$HOMES_FILE"

get_outputs_json() {
  niri msg -j outputs 2>/dev/null || echo '{}'
}

get_enabled_count() {
  get_outputs_json | jq '[.[] | select(.logical != null)] | length' 2>/dev/null || echo 0
}

has_external_output() {
  get_outputs_json \
    | jq -e --arg int "$INTERNAL" 'to_entries | any(.key != $int)' >/dev/null 2>&1
}

get_primary() {
  local raw prim
  raw="$(get_outputs_json)"
  prim="$(jq -r '.primary // "eDP-1"' "$CONFIG_FILE")"

  # Prioriza el primary configurado SOLO si existe y está encendido (logical != null)
  if jq -e --arg p "$prim" 'has($p) and (.[$p].logical != null)' <<< "$raw" >/dev/null 2>&1; then
    echo "$prim"
  elif jq -e --arg int "$INTERNAL" 'has($int) and (.[$int].logical != null)' <<< "$raw" >/dev/null 2>&1; then
    echo "$INTERNAL"
  else
    jq -r 'to_entries | map(select(.value.logical != null)) | .[0].key // (keys[0] // "")' <<< "$raw"
  fi
}

refresh_quickshell() {
  qs ipc call displays refresh >/dev/null 2>&1 || true
}

# Guarda en qué monitor y workspace (idx) vive cada ventana mientras hay ≥2 pantallas encendidas
save_window_snapshot() {
  [[ -f "$CLAMSHELL_FLAG" ]] && return 0
  local enabled
  enabled="$(get_enabled_count)"
  (( enabled >= 2 )) || return 0

  local wins wss tmp
  wins="$(niri msg -j windows 2>/dev/null || echo '[]')"
  wss="$(niri msg -j workspaces 2>/dev/null || echo '[]')"

  tmp="$(mktemp)"
  jq -n --argjson wins "$wins" --argjson wss "$wss" '
    ($wss | map({(.id | tostring): {output: .output, idx: .idx}}) | add // {}) as $wmap |
    reduce $wins[] as $w ({};
      ($wmap[$w.workspace_id | tostring]) as $ws |
      if $ws then
        .[$w.id | tostring] = {output: $ws.output, idx: $ws.idx}
      else . end
    )
  ' > "$tmp" && mv "$tmp" "$HOMES_FILE"
}

# Mueve ventanas a su monitor y workspace original tras abrir la tapa
restore_window_homes() {
  [[ -f "$HOMES_FILE" ]] || return 0
  local raw wins orig_focus win_id target_out target_idx
  raw="$(get_outputs_json)"
  wins="$(niri msg -j windows 2>/dev/null || echo '[]')"
  orig_focus="$(jq -r '.[] | select(.is_focused == true) | .id // empty' <<< "$wins" | head -n1)"

  while IFS=$'\t' read -r win_id target_out target_idx; do
    [[ -n "$win_id" && -n "$target_out" && -n "$target_idx" ]] || continue
    # Solo mover si el monitor destino está conectado y encendido
    jq -e --arg o "$target_out" 'has($o) and (.[$o].logical != null)' <<< "$raw" >/dev/null 2>&1 || continue

    niri msg action focus-window --id "$win_id" >/dev/null 2>&1 || continue
    niri msg action move-window-to-monitor "$target_out" >/dev/null 2>&1 || true
    niri msg action move-window-to-workspace "$target_idx" >/dev/null 2>&1 || true
  done < <(jq -r --slurpfile homes "$HOMES_FILE" '
    .[] | (.id | tostring) as $id |
    ($homes[0][$id] // null) as $h |
    select($h != null) |
    "\($id)\t\($h.output)\t\($h.idx)"
  ' <<< "$wins")

  [[ -n "$orig_focus" ]] && niri msg action focus-window --id "$orig_focus" >/dev/null 2>&1 || true
}

# Al desconectar HDMI: mueve ventanas que estaban en el monitor externo al mismo idx en eDP-1
relocate_disconnected_windows() {
  [[ -f "$HOMES_FILE" ]] || return 0
  local wins orig_focus win_id target_idx
  wins="$(niri msg -j windows 2>/dev/null || echo '[]')"
  orig_focus="$(jq -r '.[] | select(.is_focused == true) | .id // empty' <<< "$wins" | head -n1)"

  while IFS=$'\t' read -r win_id target_idx; do
    [[ -n "$win_id" && -n "$target_idx" ]] || continue
    niri msg action focus-window --id "$win_id" >/dev/null 2>&1 || continue
    niri msg action move-window-to-monitor "$INTERNAL" >/dev/null 2>&1 || true
    niri msg action move-window-to-workspace "$target_idx" >/dev/null 2>&1 || true
  done < <(jq -r --arg int "$INTERNAL" --slurpfile homes "$HOMES_FILE" '
    .[] | (.id | tostring) as $id |
    ($homes[0][$id] // null) as $h |
    select($h != null and $h.output != $int) |
    "\($id)\t\($h.idx)"
  ' <<< "$wins")

  [[ -n "$orig_focus" ]] && niri msg action focus-window --id "$orig_focus" >/dev/null 2>&1 || true
  echo '{}' > "$HOMES_FILE"
}

sync_audio() {
  local mode="${1:-auto}"
  local raw has_hdmi cur_default target_sink=""

  if [[ "$mode" == "auto" ]]; then
    raw="$(get_outputs_json)"
    if jq -e 'keys | any(startswith("HDMI-"))' <<< "$raw" >/dev/null 2>&1; then
      has_hdmi=1
    else
      has_hdmi=0
    fi
  elif [[ "$mode" == "hdmi" ]]; then
    has_hdmi=1
  else
    has_hdmi=0
  fi

  cur_default="$(pactl get-default-sink 2>/dev/null || true)"

  if [[ "$has_hdmi" == "1" ]]; then
    if pactl list short sinks 2>/dev/null | awk '{print $2}' | grep -qx "$HDMI_SINK"; then
      target_sink="$HDMI_SINK"
    else
      target_sink="$(pactl list short sinks 2>/dev/null | awk '/pro-output-3|hdmi-stereo/ {print $2; exit}')"
    fi

    if [[ -n "$target_sink" && "$cur_default" != "$target_sink" ]]; then
      pactl set-default-sink "$target_sink" 2>/dev/null || true
    fi
  else
    if [[ "$cur_default" == "$HDMI_SINK" || "$cur_default" == *"hdmi-stereo"* ]]; then
      if pactl list short sinks 2>/dev/null | awk '{print $2}' | grep -qx "$LAPTOP_SINK"; then
        pactl set-default-sink "$LAPTOP_SINK" 2>/dev/null || true
      fi
    fi
  fi
}

cmd_list() {
  local raw cfg prim
  raw="$(get_outputs_json)"
  cfg="$(cat "$CONFIG_FILE")"
  prim="$(get_primary)"

  jq -n --argjson raw "$raw" --argjson cfg "$cfg" --arg prim "$prim" '
    def norm_tf($t):
      if $t == "90" or $t == "Rotated90" then "90"
      elif $t == "180" or $t == "Rotated180" then "180"
      elif $t == "270" or $t == "Rotated270" then "270"
      else "normal" end;

    ($raw | to_entries | map(
      .value as $o |
      (($o.make // "") + "::" + ($o.model // "") + "::" + ($o.serial // $o.name)) as $fp |
      ($cfg.monitors[$fp] // {}) as $saved |
      ($o.modes[$o.current_mode // 0] // null) as $cm |
      {
        name: $o.name,
        make: ($o.make // ""),
        model: ($o.model // ""),
        fingerprint: $fp,
        isPrimary: ($o.name == $prim),
        enabled: ($o.logical != null),
        width: ($o.logical.width // ($cm.width // 0)),
        height: ($o.logical.height // ($cm.height // 0)),
        x: ($o.logical.x // 0),
        y: ($o.logical.y // 0),
        scale: ($o.logical.scale // 1.0),
        transform: norm_tf($o.logical.transform // "Normal"),
        currentMode: (if $cm then "\($cm.width)x\($cm.height)@\($cm.refresh_rate / 1000)" else "" end),
        workMode: (if $o.name == $prim then "primary" else ($saved.workMode // "extend") end),
        position: ($saved.position // "right"),
        hasSaved: ($cfg.monitors | has($fp)),
        modes: (
          ($o.modes // [])
          | map("\(.width)x\(.height)@\(.refresh_rate / 1000)")
          | unique
        )
      }
    ) | sort_by(if .isPrimary then 0 else 1 end, .name)) as $list |
    {
      primary: $prim,
      count: ($list | map(select(.enabled)) | length),
      outputs: $list
    }
  '
}

apply_mirror() {
  local target="$1" prim="$2"
  pkill -x wl-mirror 2>/dev/null || true
  [[ "$target" == "$prim" ]] && return 0
  setsid -f wl-mirror --fullscreen-output "$target" "$prim" >/dev/null 2>&1
}

apply_output_config() {
  local name="$1" mode="$2" scale="$3" transform="$4" work_mode="$5" position="$6" save="${7:-1}"
  local raw fp prim

  raw="$(get_outputs_json)"
  jq -e --arg n "$name" 'has($n)' <<< "$raw" >/dev/null 2>&1 || return 1

  fp="$(jq -r --arg n "$name" '.[$n] | "\(.make // "")::\(.model // "")::\(.serial // .name)"' <<< "$raw")"
  prim="$(get_primary)"

  niri msg output "$name" on >/dev/null 2>&1 || true
  [[ -n "$mode" ]] && niri msg output "$name" mode "$mode" >/dev/null 2>&1 || true
  [[ -n "$scale" ]] && niri msg output "$name" scale "$scale" >/dev/null 2>&1 || true
  [[ -n "$transform" ]] && niri msg output "$name" transform "$transform" >/dev/null 2>&1 || true

  if [[ "$name" != "$prim" ]]; then
    raw="$(get_outputs_json)"
    read -r px py pw ph sw sh < <(jq -r --arg p "$prim" --arg s "$name" '
      (.[$p].logical // {x:0,y:0,width:1366,height:768}) as $pl |
      (.[$s].logical // {x:0,y:0,width:1920,height:1080}) as $sl |
      "\($pl.x) \($pl.y) \($pl.width) \($pl.height) \($sl.width) \($sl.height)"
    ' <<< "$raw")

    local tx="$px" ty="$py"
    case "$position" in
      left)  tx=$(( px - sw )); ty=$py ;;
      above) tx=$px; ty=$(( py - sh )) ;;
      below) tx=$px; ty=$(( py + ph )) ;;
      *)     tx=$(( px + pw )); ty=$py ;;
    esac
    niri msg output "$name" position set "$tx" "$ty" >/dev/null 2>&1 || true

    if [[ "$work_mode" == "mirror" && ! -f "$CLAMSHELL_FLAG" ]]; then
      apply_mirror "$name" "$prim"
    else
      pkill -x wl-mirror 2>/dev/null || true
    fi
  fi

  if [[ "$save" == "1" ]]; then
    local tmp
    tmp="$(mktemp)"
    jq \
      --arg fp "$fp" \
      --arg name "$name" \
      --arg mode "$mode" \
      --arg scale "$scale" \
      --arg transform "$transform" \
      --arg workMode "$work_mode" \
      --arg position "$position" \
      '.monitors[$fp] = {
        lastOutput: $name,
        mode: $mode,
        scale: ($scale | tonumber? // 1.0),
        transform: $transform,
        workMode: $workMode,
        position: $position
      }' "$CONFIG_FILE" > "$tmp" && mv "$tmp" "$CONFIG_FILE"
  fi
}

cmd_restore() {
  local raw fp name mode scale transform work_mode position
  raw="$(get_outputs_json)"

  while IFS= read -r name; do
    [[ -n "$name" ]] || continue
    [[ -f "$CLAMSHELL_FLAG" && "$name" == "$INTERNAL" ]] && continue
    fp="$(jq -r --arg n "$name" '.[$n] | "\(.make // "")::\(.model // "")::\(.serial // .name)"' <<< "$raw")"
    if jq -e --arg fp "$fp" '.monitors | has($fp)' "$CONFIG_FILE" >/dev/null 2>&1; then
      read -r mode scale transform work_mode position < <(jq -r --arg fp "$fp" '
        .monitors[$fp] | "\(.mode // "") \(.scale // 1.0) \(.transform // "normal") \(.workMode // "extend") \(.position // "right")"
      ' "$CONFIG_FILE")
      apply_output_config "$name" "$mode" "$scale" "$transform" "$work_mode" "$position" 0 || true
    fi
  done < <(jq -r 'keys[]' <<< "$raw")
}

cmd_primary() {
  local name="${1:-$INTERNAL}" tmp
  tmp="$(mktemp)"
  jq --arg p "$name" '.primary = $p' "$CONFIG_FILE" > "$tmp" && mv "$tmp" "$CONFIG_FILE"
  cmd_restore
  refresh_quickshell
}

cmd_lid_close() {
  if ! has_external_output; then
    return 0
  fi

  # 1. Congelar mapa actual de ventanas antes de apagar eDP-1
  save_window_snapshot
  touch "$CLAMSHELL_FLAG"

  # 2. Salir de mirror si estaba activo y apagar la pantalla interna
  pkill -x wl-mirror 2>/dev/null || true
  niri msg output "$INTERNAL" off >/dev/null 2>&1 || true

  # 3. Asegurar barra en el monitor externo
  sleep 0.25
  refresh_quickshell
}

cmd_lid_open() {
  rm -f "$CLAMSHELL_FLAG"
  niri msg output "$INTERNAL" on >/dev/null 2>&1 || true
  sleep 0.35

  if has_external_output; then
    cmd_restore
    sleep 0.25
    restore_window_homes
  else
    relocate_disconnected_windows
  fi

  refresh_quickshell
}

cmd_watch() {
  local prev="" cur prev_ext="" cur_ext
  while true; do
    cur="$(get_outputs_json | jq -r 'to_entries | map("\(.key)=\(.value.make):\(.value.model):\(.value.serial // "")") | sort | join("|")' 2>/dev/null || true)"
    if [[ -n "$cur" && "$cur" != "$prev" ]]; then
      [[ -n "$prev" ]] && sleep 0.4

      if has_external_output; then
        cur_ext="1"
      else
        cur_ext="0"
      fi

      if [[ "$prev_ext" == "1" && "$cur_ext" == "0" ]]; then
        # Se desconectó el monitor externo: devolver todo al original y al mismo idx en eDP-1
        pkill -x wl-mirror 2>/dev/null || true
        rm -f "$CLAMSHELL_FLAG"
        niri msg output "$INTERNAL" on >/dev/null 2>&1 || true
        sleep 0.25
        relocate_disconnected_windows
        sync_audio laptop
        refresh_quickshell
      else
        cmd_restore
        if [[ "$cur_ext" != "$prev_ext" ]]; then
          if [[ "$cur_ext" == "1" ]]; then
            sync_audio hdmi
          else
            sync_audio laptop
          fi
        fi
        refresh_quickshell
      fi

      prev_ext="$cur_ext"
      prev="$cur"
    fi

    # Snapshot continuo mientras ambos monitores están encendidos
    save_window_snapshot
    sleep 2
  done
}

case "${1:-list}" in
  list)       cmd_list ;;
  apply)      apply_output_config "${2:?}" "${3:-}" "${4:-1.0}" "${5:-normal}" "${6:-extend}" "${7:-right}" 1; refresh_quickshell ;;
  primary)    cmd_primary "${2:?}" ;;
  restore)    cmd_restore; refresh_quickshell ;;
  audio-sync) sync_audio "${2:-auto}" ;;
  lid-close)  cmd_lid_close ;;
  lid-open)   cmd_lid_open ;;
  watch)      cmd_watch ;;
  *)
    echo "Uso: display-manager [list|apply|primary|restore|audio-sync|lid-close|lid-open|watch]" >&2
    exit 1
    ;;
esac
