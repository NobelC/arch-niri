#!/usr/bin/env bash
set -euo pipefail

DOTFILES_DIR="$HOME/Projects/arch-niri"
PACKAGES_DIR="$DOTFILES_DIR/packages"
WEBAPPS_FILE="$PACKAGES_DIR/webapps.tsv"
ICONS_DIR="$HOME/Pictures/WebAppIcons"
BUILD_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/pake-builds"

mkdir -p "$PACKAGES_DIR" "$ICONS_DIR" "$BUILD_DIR"
touch "$WEBAPPS_FILE"

usage() {
  cat <<'EOF'
Uso:
  webapp add "<Nombre>" "<URL>" [nombre_icono] [flags_pake]
  webapp remove "<Nombre>"
  webapp sync
  webapp list

Ejemplos:
  webapp add "Syncthing" "http://127.0.0.1:8384/"
  webapp add "Spotify" "https://open.spotify.com" "spotify" "--width 1280 --height 820"
EOF
}

slugify() {
  echo "$1" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/-/g; s/^-+|-+$//g'
}

resolve_icon() {
  local icon_arg="${1:-}"
  local slug="$2"
  local found=""

  if [[ -n "$icon_arg" ]]; then
    if [[ -f "$icon_arg" ]]; then
      realpath "$icon_arg"
      return 0
    elif [[ -f "$ICONS_DIR/$icon_arg" ]]; then
      realpath "$ICONS_DIR/$icon_arg"
      return 0
    fi

    found=$(find "$ICONS_DIR" -maxdepth 1 -type f \( -iname "$icon_arg" -o -iname "$icon_arg.*" \) | head -n 1 || true)
    if [[ -n "$found" ]]; then
      realpath "$found"
      return 0
    fi
  fi

  found=$(find "$ICONS_DIR" -maxdepth 1 -type f -iname "$slug.*" | head -n 1 || true)
  if [[ -n "$found" ]]; then
    realpath "$found"
    return 0
  fi

  echo ""
}

build_and_install_one() {
  local name="$1"
  local url="$2"
  local icon_raw="${3:-}"
  local extra_flags="${4:-}"
  local slug
  slug="$(slugify "$name")"
  local pkg_name="webapp-$slug"

  if ! command -v pake &>/dev/null; then
    echo "✗ 'pake' no está instalado. Instálalo primero (paru -S pake-cli)." >&2
    exit 1
  fi

  local resolved_icon
  resolved_icon="$(resolve_icon "$icon_raw" "$slug")"

  local workdir="$BUILD_DIR/$slug"
  rm -rf "$workdir"
  mkdir -p "$workdir"

  echo "-> Construyendo WebApp '$name' ($url) como '$pkg_name' con Pake..."
  local pake_cmd=(pake "$url" --name "$pkg_name" --targets zst)

  if [[ -n "$resolved_icon" ]]; then
    echo "   Icono: $resolved_icon"
    pake_cmd+=(--icon "$resolved_icon")
  fi

  if [[ -n "$extra_flags" ]]; then
    local -a flags_arr=()
    read -ra flags_arr <<< "$extra_flags"
    pake_cmd+=("${flags_arr[@]}")
  fi

  (
    cd "$workdir"
    "${pake_cmd[@]}"
  )

  local pkg_file
  pkg_file=$(find "$workdir" -maxdepth 3 -type f -name "*.pkg.tar.*" | head -n 1 || true)

  if [[ -n "$pkg_file" ]]; then
    echo "-> Instalando paquete generado: $(basename "$pkg_file")"
    sudo pacman -U --noconfirm "$pkg_file"
  else
    echo "✗ No se encontró el paquete generado en $workdir" >&2
    return 1
  fi

  echo "✓ WebApp '$name' instalada correctamente como paquete '$pkg_name'."
}

register_webapp() {
  local name="$1"
  local url="$2"
  local icon_raw="${3:-}"
  local extra_flags="${4:-}"
  local slug
  slug="$(slugify "$name")"

  local stored_icon="$icon_raw"
  local resolved
  resolved="$(resolve_icon "$icon_raw" "$slug")"
  if [[ -n "$resolved" ]]; then
    if [[ "$resolved" == "$ICONS_DIR/"* ]]; then
      stored_icon="$(basename "$resolved")"
    else
      stored_icon="${resolved/#$HOME\//~/}"
    fi
  fi

  grep -v -F "${name}"$'\t' "$WEBAPPS_FILE" > "$WEBAPPS_FILE.tmp" || true
  mv "$WEBAPPS_FILE.tmp" "$WEBAPPS_FILE"

  printf "%s\t%s\t%s\t%s\n" "$name" "$url" "$stored_icon" "$extra_flags" >> "$WEBAPPS_FILE"
  echo "✓ Registrada en packages/webapps.tsv"
}

subcmd="${1:-}"
case "$subcmd" in
  add)
    [[ $# -lt 3 ]] && { usage; exit 1; }
    name="$2"
    url="$3"
    icon="${4:-}"
    extra_flags="${5:-}"
    register_webapp "$name" "$url" "$icon" "$extra_flags"
    build_and_install_one "$name" "$url" "$icon" "$extra_flags"
    bash "$DOTFILES_DIR/scripts/sync-packages"
    ;;
  remove)
    [[ $# -lt 2 ]] && { usage; exit 1; }
    name="$2"
    slug="$(slugify "$name")"
    grep -v -F "${name}"$'\t' "$WEBAPPS_FILE" > "$WEBAPPS_FILE.tmp" || true
    mv "$WEBAPPS_FILE.tmp" "$WEBAPPS_FILE"
    sudo pacman -Rns --noconfirm "webapp-$slug" 2>/dev/null || sudo pacman -Rns --noconfirm "$slug" 2>/dev/null || true
    bash "$DOTFILES_DIR/scripts/sync-packages"
    echo "✓ WebApp '$name' eliminada del sistema y del repositorio."
    ;;
  sync)
    while IFS=$'\t' read -r name url icon extra_flags; do
      [[ -z "$name" || "$name" =~ ^# ]] && continue
      slug="$(slugify "$name")"
      icon_expanded="${icon/#\~\//$HOME/}"
      if pacman -Qi "webapp-$slug" &>/dev/null; then
        echo "· [$name] Ya instalada, omitiendo."
      else
        build_and_install_one "$name" "$url" "${icon_expanded:-}" "${extra_flags:-}"
      fi
    done < "$WEBAPPS_FILE"
    ;;
  list)
    column -t -s $'\t' "$WEBAPPS_FILE" 2>/dev/null || cat "$WEBAPPS_FILE"
    ;;
  *)
    usage
    exit 1
    ;;
esac
