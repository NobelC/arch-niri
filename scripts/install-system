#!/usr/bin/env bash
set -euo pipefail

if [[ $EUID -ne 0 ]]; then
  echo "✗ Este script debe ejecutarse con sudo:" >&2
  echo "  sudo bash $0" >&2
  exit 1
fi

REAL_USER="${SUDO_USER:-}"
if [[ -z "$REAL_USER" || "$REAL_USER" == "root" ]]; then
  echo "✗ Ejecuta el script usando 'sudo' desde tu usuario normal (no directamente como root)." >&2
  exit 1
fi

REAL_HOME="$(getent passwd "$REAL_USER" | cut -d: -f6)"
DOTFILES_DIR="$REAL_HOME/Projects/arch-niri"
PACKAGES_DIR="$DOTFILES_DIR/packages"
SCRIPTS_DIR="$DOTFILES_DIR/scripts"
ICONS_DIR="$REAL_HOME/Pictures/WebAppIcons"

run_as_user() {
  sudo -u "$REAL_USER" HOME="$REAL_HOME" "$@"
}

read_pkg_list() {
  local file="$1"
  [[ -f "$file" ]] || return 0
  sed -E 's/#.*$//; s/^[[:space:]]+//; s/[[:space:]]+$//' "$file" | grep -v '^$' || true
}

install_pacman_hook() {
  mkdir -p /etc/pacman.d/hooks
  sed "s|/home/NobelC/Projects/arch-niri/scripts/sync-packages|/usr/bin/env SUDO_USER=$REAL_USER /usr/bin/bash $SCRIPTS_DIR/sync-packages|" \
    "$DOTFILES_DIR/system/pacman-hooks/99-arch-niri-sync.hook" > /etc/pacman.d/hooks/99-arch-niri-sync.hook
  chmod 644 /etc/pacman.d/hooks/99-arch-niri-sync.hook
}

install_grub_theme() {
  echo "-> Configurando tema GRUB (hacker-box) y soporte grub-btrfs..."
  if [[ "$(stat -f -c %T / 2>/dev/null || true)" == "btrfs" ]]; then
    pacman -S --needed --noconfirm grub-btrfs 2>/dev/null || true
    if [[ -f /etc/default/grub-btrfs/config ]]; then
      sed -i 's|^#*GRUB_BTRFS_SNAPSHOT_DIR=.*|GRUB_BTRFS_SNAPSHOT_DIR="/.snapshots"|' /etc/default/grub-btrfs/config
    fi
  fi

  if [[ -d "$DOTFILES_DIR/system/grub/hacker-box" ]] && [[ -f /etc/default/grub ]]; then
    mkdir -p /boot/grub/themes
    rm -rf /boot/grub/themes/hacker-box /boot/grub/themes/CyberGRUB-2077 /boot/grub/themes/neo-brutalist
    cp -r "$DOTFILES_DIR/system/grub/hacker-box" /boot/grub/themes/
    chmod -x /etc/grub.d/31_efi_bootnext 2>/dev/null || true

    python3 - << 'PYGRUB'
from pathlib import Path
g = Path("/etc/default/grub")
gtxt = g.read_text()
updates = {
    "GRUB_GFXMODE": "1366x768,auto",
    "GRUB_GFXPAYLOAD_LINUX": "keep",
    "GRUB_THEME": '"/boot/grub/themes/hacker-box/theme.txt"',
}
seen = set()
out = []
for line in gtxt.splitlines():
    s = line.lstrip("#").strip()
    matched = False
    for k, v in updates.items():
        if s.startswith(k + "="):
            out.append(f"{k}={v}")
            seen.add(k)
            matched = True
            break
    if not matched:
        out.append(line)
for k, v in updates.items():
    if k not in seen:
        out.append(f"{k}={v}")
g.write_text("\n".join(out) + "\n")
PYGRUB
  fi
}

install_plymouth_theme() {
  echo "-> Configurando splash Plymouth (hacker-minimal)..."
  pacman -S --needed --noconfirm plymouth 2>/dev/null || true

  if [[ -d "$DOTFILES_DIR/system/plymouth/hacker-minimal" ]]; then
    mkdir -p /usr/share/plymouth/themes/hacker-minimal
    cp -rf "$DOTFILES_DIR/system/plymouth/hacker-minimal/"* /usr/share/plymouth/themes/hacker-minimal/
    plymouth-set-default-theme hacker-minimal 2>/dev/null || true
  fi

  if [[ -f /etc/mkinitcpio.conf ]]; then
    python3 - << 'PYMK'
from pathlib import Path
import re
m = Path("/etc/mkinitcpio.conf")
mtxt = m.read_text()
def patch(match):
    hooks = match.group(1).split()
    if "plymouth" in hooks:
        return match.group(0)
    if "sd-encrypt" in hooks:
        hooks.insert(hooks.index("sd-encrypt"), "plymouth")
    elif "encrypt" in hooks:
        hooks.insert(hooks.index("encrypt"), "plymouth")
    else:
        hooks.append("plymouth")
    return f"HOOKS=({' '.join(hooks)})"
m.write_text(re.sub(r"^HOOKS=\(([^)]+)\)", patch, mtxt, count=1, flags=re.MULTILINE))
PYMK
  fi

  if [[ -f /etc/default/grub ]]; then
    python3 - << 'PYSPLASH'
from pathlib import Path
import re
g = Path("/etc/default/grub")
gtxt = g.read_text()
def add_splash(match):
    val = match.group(1)
    if "splash" not in val.split():
        val = (val + " splash loglevel=3 rd.udev.log_level=3 vt.global_cursor_default=0").strip()
    return f'GRUB_CMDLINE_LINUX_DEFAULT="{val}"'
g.write_text(re.sub(r'^GRUB_CMDLINE_LINUX_DEFAULT="([^"]*)"', add_splash, gtxt, count=1, flags=re.MULTILINE))
PYSPLASH
  fi

  if [[ -d /boot/grub ]]; then
    mkinitcpio -P
    grub-mkconfig -o /boot/grub/grub.cfg
  fi
}

install_system_modules() {
  echo "-> Instalando módulos del sistema (net-trust + sys-update)..."
  if [[ -f "$DOTFILES_DIR/system/net-trust/install.sh" ]]; then
    SUDO_USER="$REAL_USER" bash "$DOTFILES_DIR/system/net-trust/install.sh"
  fi

  if [[ -f "$DOTFILES_DIR/system/mic-led/install.sh" ]]; then
    bash "$DOTFILES_DIR/system/mic-led/install.sh"
  fi

  if [[ -f "$DOTFILES_DIR/system/sys-update/sys-update-apply" ]]; then
    install -o root -g root -m 755 "$DOTFILES_DIR/system/sys-update/sys-update-apply" /usr/local/bin/sys-update-apply
    printf '%s ALL=(root) NOPASSWD: /usr/local/bin/sys-update-apply\n' "$REAL_USER" > /etc/sudoers.d/zz-sys-update
    chmod 440 /etc/sudoers.d/zz-sys-update
    visudo -cf /etc/sudoers.d/zz-sys-update
  fi
}

echo "============================================================"
echo "  Despliegue completo arch-niri (Usuario: $REAL_USER)"
echo "============================================================"

# 1. Crea carpeta de iconos de WebApps en Pictures
run_as_user mkdir -p "$ICONS_DIR"

# 2. Actualiza repositorios e instala paquetes oficiales (pacman)
mapfile -t PACMAN_PKGS < <(read_pkg_list "$PACKAGES_DIR/pacman.txt")
if [[ ${#PACMAN_PKGS[@]} -gt 0 ]]; then
  echo "-> [1/5] Instalando paquetes de pacman (${#PACMAN_PKGS[@]})..."
  pacman -Syu --needed --noconfirm "${PACMAN_PKGS[@]}"
fi

# 3. Verifica o compila 'paru' si aún no está instalado
if ! command -v paru &>/dev/null; then
  echo "-> [2/5] Instalando paru desde AUR..."
  pacman -S --needed --noconfirm base-devel git
  TMP_PARU="/tmp/paru-build-$REAL_USER"
  rm -rf "$TMP_PARU"
  run_as_user git clone https://aur.archlinux.org/paru.git "$TMP_PARU"
  (
    cd "$TMP_PARU"
    run_as_user makepkg -si --noconfirm
  )
  rm -rf "$TMP_PARU"
fi

# 4. Instala paquetes de AUR con paru (ejecutado como usuario real)
mapfile -t PARU_PKGS < <(read_pkg_list "$PACKAGES_DIR/paru.txt")
if [[ ${#PARU_PKGS[@]} -gt 0 ]]; then
  echo "-> [3/5] Instalando paquetes de AUR con paru (${#PARU_PKGS[@]})..."
  run_as_user paru -S --needed --noconfirm "${PARU_PKGS[@]}"
fi

NEO_LOGIN_REPO="https://github.com/Darsh-A/neologin-greetd"

install_neo_login() {
  echo "-> Instalando y configurando greetd + neo-login..."
  pacman -S --needed --noconfirm greetd cage noto-fonts-cjk

  if [[ ! -d /usr/share/neo-login ]]; then
    local tmp_neo="/tmp/neo-login-$REAL_USER"
    rm -rf "$tmp_neo"
    run_as_user git clone "${NEO_LOGIN_REPO}.git" "$tmp_neo"
    (
      cd "$tmp_neo"
      sed -i -E "s|https://github\.com/YOURUSER/[^\"' )]+|$NEO_LOGIN_REPO|g" PKGBUILD
      sed -i 's|source=("git+\$url.git")|source=("neo-login::git+$url.git")|' PKGBUILD
      run_as_user makepkg -si --noconfirm
    )
    rm -rf "$tmp_neo"
  fi

  mkdir -p /etc/greetd /etc/neo-login
  cp -f "$DOTFILES_DIR/system/greetd/config.toml" /etc/greetd/config.toml
  cp -f "$DOTFILES_DIR/system/neo-login/config.json" /etc/neo-login/config.json

  systemctl disable ly.service 2>/dev/null || systemctl disable ly@tty2.service 2>/dev/null || true
  systemctl enable greetd.service
}

# 5. Ejecuta auto-stow (enlaza dotfiles + valida y enlaza scripts)
echo "-> [4/5] Enlazando dotfiles y scripts con auto-stow..."
run_as_user bash "$SCRIPTS_DIR/auto-stow"

# 6. Sincroniza e instala todas las WebApps declaradas con Pake
echo "-> [5/5] Sincronizando WebApps de Pake..."
run_as_user bash "$SCRIPTS_DIR/webapp" sync

# 7. Instala el hook de pacman para mantener pacman.txt y paru.txt siempre al día
install_pacman_hook
run_as_user bash "$SCRIPTS_DIR/sync-packages"

install_neo_login
install_system_modules
install_grub_theme
install_plymouth_theme

# 8. Habilita servicios base del sistema
systemctl enable --now NetworkManager bluetooth 2>/dev/null || true
systemctl enable --now power-profiles-daemon 2>/dev/null || true

echo "============================================================"
echo "✓ Instalación completa finalizada sin errores."
echo "============================================================"
