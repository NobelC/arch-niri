#!/usr/bin/env bash
set -euo pipefail

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/quickshell"
LID_MODE_FILE="$STATE_DIR/lid-mode"
DIM_FLAG="/tmp/smart-idle-dimmed-$UID"

# --- Tiempos en segundos ---
# Batería: 2m atenuar -> 3m apagar pantalla -> 4m bloquear -> 10m suspender
BAT_DIM=120
BAT_DPMS=180
BAT_LOCK=240
BAT_SUSPEND=600

# Corriente (AC): 5m atenuar -> 8m apagar pantalla -> 10m bloquear (sin suspensión automática)
AC_DIM=300
AC_DPMS=480
AC_LOCK=600

is_awake_mode() {
  [[ -f "$LID_MODE_FILE" ]] && [[ "$(tr -d '[:space:]' < "$LID_MODE_FILE" 2>/dev/null)" == "awake" ]]
}

on_battery() {
  local bat
  for bat in /sys/class/power_supply/BAT*/status; do
    [[ -f "$bat" ]] || continue
    if grep -qi "Discharging" "$bat" 2>/dev/null; then
      return 0
    fi
  done
  return 1
}

is_inhibited() {
  # 1. Modo "Awake" activo desde DashboardMenu
  if is_awake_mode; then
    return 0
  fi

  # 2. Reproducción multimedia activa (MPRIS: navegador, mpv, Spotify, SimpMusic)
  if command -v playerctl >/dev/null 2>&1; then
    if playerctl -a status 2>/dev/null | grep -qx "Playing"; then
      return 0
    fi
  fi

  # 3. Grabaciones, llamadas o compilaciones pesadas en curso
  if pgrep -x "obs|wf-recorder|wl-screenrec|gpu-screen-reco|pw-record|makepkg|cargo|rustc|cc1plus|clang|ninja" >/dev/null 2>&1 \
     || pgrep -f '(^|/)(obs|wf-recorder|wl-screenrec|gpu-screen-recorder|pw-record)([[:space:]]|$)' >/dev/null 2>&1; then
    return 0
  fi

  return 1
}

do_dim() {
  is_inhibited && exit 0
  if [[ ! -f "$DIM_FLAG" ]] && command -v brightnessctl >/dev/null 2>&1; then
    brightnessctl -s >/dev/null 2>&1 || true
    brightnessctl set 10% >/dev/null 2>&1 || true
    touch "$DIM_FLAG"
  fi
}

do_undim() {
  if [[ -f "$DIM_FLAG" ]] && command -v brightnessctl >/dev/null 2>&1; then
    brightnessctl -r >/dev/null 2>&1 || true
    rm -f "$DIM_FLAG"
  fi
}

do_dpms_off() {
  is_inhibited && exit 0
  niri msg action power-off-monitors >/dev/null 2>&1 || true
}

do_dpms_on() {
  niri msg action power-on-monitors >/dev/null 2>&1 || true
  do_undim
}

do_lock() {
  is_inhibited && exit 0
  qs ipc call lock lock >/dev/null 2>&1 || true
}

do_suspend() {
  is_inhibited && exit 0
  on_battery || exit 0
  qs ipc call lock lock >/dev/null 2>&1 || true
  sleep 0.35
  systemctl suspend
}

start_swayidle() {
  pkill -x swayidle 2>/dev/null || true

  if on_battery; then
    swayidle -w \
      timeout "$BAT_DIM"     "$0 dim" \
        resume               "$0 undim" \
      timeout "$BAT_DPMS"    "$0 dpms-off" \
        resume               "$0 dpms-on" \
      timeout "$BAT_LOCK"    "$0 lock" \
      timeout "$BAT_SUSPEND" "$0 suspend" \
      before-sleep           "qs ipc call lock lock" \
      after-resume           "$0 dpms-on" &
  else
    swayidle -w \
      timeout "$AC_DIM"      "$0 dim" \
        resume               "$0 undim" \
      timeout "$AC_DPMS"     "$0 dpms-off" \
        resume               "$0 dpms-on" \
      timeout "$AC_LOCK"     "$0 lock" \
      before-sleep           "qs ipc call lock lock" \
      after-resume           "$0 dpms-on" &
  fi
}

run_daemon() {
  trap 'pkill -x swayidle 2>/dev/null || true; kill 0 2>/dev/null || true' EXIT

  local current_state new_state
  current_state="$(on_battery && echo "bat" || echo "ac")"
  start_swayidle

  # Recarga swayidle automáticamente al conectar o desconectar el cargador
  udevadm monitor --udev --subsystem-match=power_supply 2>/dev/null | \
  while IFS= read -r line; do
    if [[ "$line" == *"change"* ]]; then
      new_state="$(on_battery && echo "bat" || echo "ac")"
      if [[ "$new_state" != "$current_state" ]]; then
        current_state="$new_state"
        start_swayidle
      fi
    fi
  done
  return 1
}

case "${1:-daemon}" in
  daemon)   run_daemon ;;
  dim)      do_dim ;;
  undim)    do_undim ;;
  dpms-off) do_dpms_off ;;
  dpms-on)  do_dpms_on ;;
  lock)     do_lock ;;
  suspend)  do_suspend ;;
  status)
    echo "perfil:   $(on_battery && echo "batería (2m/3m/4m/10m)" || echo "corriente AC (5m/8m/10m/sin-suspensión)")"
    echo "inhibido: $(is_inhibited && echo sí || echo no)"
    echo "swayidle: $(pgrep -x swayidle >/dev/null && echo activo || echo detenido)"
    ;;
  *)
    echo "Uso: smart-idle [daemon|dim|undim|dpms-off|dpms-on|lock|suspend|status]" >&2
    exit 1
    ;;
esac
