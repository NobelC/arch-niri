#!/usr/bin/env bash
set -euo pipefail

IMG="${1:-}"
[[ -f "$IMG" ]] || exit 1

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/quickshell"
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/arch-niri/wallpapers"
mkdir -p "$STATE_DIR" "$CACHE_DIR"

# 1. Actualizar symlink de inmediato
ln -sfn "$IMG" "$STATE_DIR/current-wallpaper"

# Hash instantáneo por metadatos
hash="$(stat -c '%s-%Y-%n' "$IMG" | cksum | awk '{print $1}')"
cached_hex="$CACHE_DIR/${hash}.hex"
cached_overview="$CACHE_DIR/${hash}-overview.jpg"

# 2. Fondo + paleta EN PARALELO
awww img "$IMG" --transition-type wipe --transition-angle 30 --transition-fps 60 --transition-duration 0.30 >/dev/null 2>&1 &
PID_AWWW=$!

hex=""
[[ -f "$cached_hex" ]] && hex="$(tr -d '[:space:]' < "$cached_hex")"

if [[ "$hex" =~ ^#[0-9a-fA-F]{6}$ ]]; then
  # Cache hit (~0.21s)
  matugen color hex "$hex" >/dev/null 2>&1 &
  PID_MATUGEN=$!
else
  # Cache miss: aplica tema y guarda el hex para la próxima
  (
    json="$(matugen image "$IMG" --source-color-index 0 --resize-filter nearest --json hex 2>/dev/null || true)"
    extracted="$(printf '%s' "$json" | jq -r '[.colors.source_color | .. | strings | select(test("^#[0-9a-fA-F]{6}$"))] | first // empty' 2>/dev/null || true)"
    if [[ "$extracted" =~ ^#[0-9a-fA-F]{6}$ ]]; then
      printf '%s\n' "$extracted" > "$cached_hex"
    fi
  ) &
  PID_MATUGEN=$!
fi

# 3. Overview blur + limpieza automática de caché huérfana (en segundo plano desacoplado)
nohup nice -n 19 ionice -c 3 bash -c '
  img="$1"; cur_hash="$2"; cached_ov="$3"; cache_dir="$4"; state_dir="$5"

  if [[ ! -f "$cached_ov" ]]; then
    magick "$img" -resize 960x540^ -gravity center -extent 960x540 -blur 0x10 -quality 85 "$cached_ov" 2>/dev/null || true
  fi
  if [[ -f "$cached_ov" ]]; then
    cp -f "$cached_ov" "$state_dir/overview-wallpaper.jpg"
    pkill -x swaybg 2>/dev/null || true
    setsid -f swaybg -i "$state_dir/overview-wallpaper.jpg" -m fill >/dev/null 2>&1
  fi

  # Podar archivos huérfanos en caché (wallpapers borrados, editados o residuos viejos)
  wall_dir="$HOME/Pictures/Wallpapers"
  if [[ -d "$wall_dir" ]]; then
    declare -A valid_hashes=()
    valid_hashes["$cur_hash"]=1
    while IFS= read -r f; do
      fh="$(stat -c "%s-%Y-%n" "$f" | cksum | awk "{print \$1}")"
      valid_hashes["$fh"]=1
    done < <(find -L "$wall_dir" -maxdepth 2 -type f \
      \( -iname "*.jpg" -o -iname "*.jpeg" -o -iname "*.png" -o -iname "*.webp" -o -iname "*.avif" \) 2>/dev/null)

    shopt -s nullglob
    for cf in "$cache_dir"/*; do
      base="${cf##*/}"
      ch="${base%%[-.]*}"
      if [[ ( "$base" == *.hex || "$base" == *-overview.jpg ) && -n "${valid_hashes[$ch]:-}" ]]; then
        continue
      fi
      rm -f "$cf"
    done
  fi
' _ "$IMG" "$hash" "$cached_overview" "$CACHE_DIR" "$STATE_DIR" </dev/null >/dev/null 2>&1 &

wait "$PID_AWWW" "$PID_MATUGEN"
