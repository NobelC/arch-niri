#!/usr/bin/env bash
set -euo pipefail

ACTION="${1:-status}"
USER_NAME="${SYS_UPDATE_USER:-${SUDO_USER:-}}"
if [[ -z "$USER_NAME" || "$USER_NAME" == "root" ]]; then
  echo "✗ Error: define SYS_UPDATE_USER o ejecuta con sudo desde un usuario no-root (SUDO_USER)." >&2
  exit 1
fi

USER_HOME="$(getent passwd "$USER_NAME" | cut -d: -f6)"
REPO_DIR="${USER_HOME}/Projects/arch-niri"
STATE_DIR="${USER_HOME}/.local/state/quickshell"
STATE_FILE="${STATE_DIR}/sys-update.json"
HISTORY_FILE="${STATE_DIR}/sys-update-history.json"
LOG_FILE="${STATE_DIR}/sys-update.log"

mkdir -p "$STATE_DIR"
chown "${USER_NAME}:${USER_NAME}" "$STATE_DIR"

log_line() {
  printf '[%s] %s\n' "$(date '+%H:%M:%S')" "$*" >> "$LOG_FILE"
  chown "${USER_NAME}:${USER_NAME}" "$LOG_FILE" 2>/dev/null || true
}

load_averages() {
  if [[ -f "$HISTORY_FILE" ]]; then
    AVG_BASE="$(jq -r 'if length > 0 then ([.[].baseSec] | add / length | round) else 6 end' "$HISTORY_FILE" 2>/dev/null || echo 6)"
    AVG_REPO="$(jq -r '[.[] | select(.repoCount > 0) | (.repoSec / .repoCount)] | if length > 0 then (add / length) else 2.5 end' "$HISTORY_FILE" 2>/dev/null || echo 2.5)"
    AVG_AUR="$(jq -r '[.[] | select(.aurCount > 0) | (.aurSec / .aurCount)] | if length > 0 then (add / length) else 25.0 end' "$HISTORY_FILE" 2>/dev/null || echo 25.0)"
  else
    AVG_BASE=6
    AVG_REPO="2.5"
    AVG_AUR="25.0"
  fi
}

calc_eta() {
  local base_rem="$1" repo_rem="$2" aur_rem="$3"
  awk -v b="$base_rem" -v r="$repo_rem" -v ar="$AVG_REPO" -v a="$aur_rem" -v aa="$AVG_AUR" \
    'BEGIN { val = int(b + (r * ar) + (a * aa) + 0.5); if (val < 1) val = 1; print val }'
}

record_history() {
  local base_sec="$1" repo_count="$2" repo_sec="$3" aur_count="$4" aur_sec="$5" total_sec="$6"
  local tmp
  tmp="$(mktemp)"
  if [[ -f "$HISTORY_FILE" ]]; then
    jq --argjson base "$base_sec" --argjson rc "$repo_count" --argjson rs "$repo_sec" \
       --argjson ac "$aur_count" --argjson as "$aur_sec" --argjson tot "$total_sec" \
       --arg ts "$(date -Iseconds)" \
      '(. + [{ts: $ts, baseSec: $base, repoCount: $rc, repoSec: $rs, aurCount: $ac, aurSec: $as, totalSec: $tot}]) | .[-10:]' \
      "$HISTORY_FILE" > "$tmp" 2>/dev/null || \
    jq -n --argjson base "$base_sec" --argjson rc "$repo_count" --argjson rs "$repo_sec" \
       --argjson ac "$aur_count" --argjson as "$aur_sec" --argjson tot "$total_sec" \
       --arg ts "$(date -Iseconds)" \
      '[{ts: $ts, baseSec: $base, repoCount: $rc, repoSec: $rs, aurCount: $ac, aurSec: $as, totalSec: $tot}]' > "$tmp"
  else
    jq -n --argjson base "$base_sec" --argjson rc "$repo_count" --argjson rs "$repo_sec" \
       --argjson ac "$aur_count" --argjson as "$aur_sec" --argjson tot "$total_sec" \
       --arg ts "$(date -Iseconds)" \
      '[{ts: $ts, baseSec: $base, repoCount: $rc, repoSec: $rs, aurCount: $ac, aurSec: $as, totalSec: $tot}]' > "$tmp"
  fi
  mv "$tmp" "$HISTORY_FILE"
  chown "${USER_NAME}:${USER_NAME}" "$HISTORY_FILE"
}

write_progress() {
  local phase="$1" msg="$2" running="$3" pct="$4" eta="$5" snap="${6:-}"
  local tmp
  tmp="$(mktemp)"
  if [[ -f "$STATE_FILE" ]]; then
    jq --arg phase "$phase" --arg msg "$msg" --argjson running "$running" \
       --argjson pct "$pct" --argjson eta "$eta" --arg snap "$snap" \
      '.phase = $phase | .message = $msg | .running = $running | .progress = $pct | .etaSeconds = $eta | (if $snap != "" then .lastSnapshot = $snap else . end)' \
      "$STATE_FILE" > "$tmp" 2>/dev/null || \
    jq -n --arg phase "$phase" --arg msg "$msg" --argjson running "$running" \
       --argjson pct "$pct" --argjson eta "$eta" --arg snap "$snap" \
      '{count: 0, packages: [], orphanCount: 0, orphans: [], phase: $phase, message: $msg, running: $running, progress: $pct, etaSeconds: $eta, lastSnapshot: $snap, updatedAt: ""}' > "$tmp"
  else
    jq -n --arg phase "$phase" --arg msg "$msg" --argjson running "$running" \
       --argjson pct "$pct" --argjson eta "$eta" --arg snap "$snap" \
      '{count: 0, packages: [], orphanCount: 0, orphans: [], phase: $phase, message: $msg, running: $running, progress: $pct, etaSeconds: $eta, lastSnapshot: $snap, updatedAt: ""}' > "$tmp"
  fi
  mv "$tmp" "$STATE_FILE"
  chown "${USER_NAME}:${USER_NAME}" "$STATE_FILE"
}

create_pre_snapshot() {
  local ts fs_type snap_name=""
  ts="$(date '+%Y-%m-%d %H:%M')"
  fs_type="$(stat -f -c %T / 2>/dev/null || echo "unknown")"

  if [[ "$fs_type" == "btrfs" ]] && command -v btrfs >/dev/null 2>&1; then
    local snap_dir="/.snapshots"
    local snap_path="${snap_dir}/pre-update-latest"

    if [[ ! -d "$snap_dir" ]]; then
      btrfs subvolume create "$snap_dir" >/dev/null 2>&1 || mkdir -p "$snap_dir"
    fi
    if btrfs subvolume show "$snap_path" >/dev/null 2>&1; then
      btrfs subvolume delete "$snap_path" >/dev/null 2>&1 || true
    fi
    for old in "${snap_dir}"/pre-update-*; do
      [[ -e "$old" ]] || continue
      btrfs subvolume delete "$old" >/dev/null 2>&1 || rm -rf "$old" 2>/dev/null || true
    done
    if btrfs subvolume snapshot -r / "$snap_path" >/dev/null 2>&1; then
      snap_name="pre-update-latest (${ts})"
    fi
  else
    snap_name="NONE (${fs_type^^})"
  fi

  echo "$snap_name"
}

sync_repo_state() {
  if [[ -x "${REPO_DIR}/scripts/sync-packages" ]]; then
    timeout 25 sudo -u "$USER_NAME" HOME="$USER_HOME" bash "${REPO_DIR}/scripts/sync-packages" >> "$LOG_FILE" 2>&1 || true
  fi
  if [[ -x "${REPO_DIR}/scripts/auto-stow" ]]; then
    timeout 45 sudo -u "$USER_NAME" HOME="$USER_HOME" bash "${REPO_DIR}/scripts/auto-stow" >> "$LOG_FILE" 2>&1 || true
  fi
}

is_protected_pkg() {
  case "$1" in
    base|base-devel|linux|linux-zen|linux-lts|linux-firmware|systemd|systemd-libs|pacman|glibc|bash|sudo|filesystem|niri|quickshell|quickshell-git)
      return 0 ;;
    *) return 1 ;;
  esac
}

purge_pkg_files() {
  local pkg="$1"
  local base="$pkg"
  base="${base%-bin}"
  base="${base%-git}"
  base="${base%-appimage}"

  # Caché de pacman y paru para ese paquete
  rm -f /var/cache/pacman/pkg/"${pkg}"-[0-9]*.pkg.tar.* 2>/dev/null || true
  if [[ -d "${USER_HOME}/.cache/paru/clone/${pkg}" ]]; then
    rm -rf "${USER_HOME}/.cache/paru/clone/${pkg}"
    log_line "PURGED CACHE: ~/.cache/paru/clone/${pkg}"
  fi

  # Nunca autopurgar carpetas base del escritorio
  case "$base" in
    niri|quickshell|ghostty|nvim|neovim|yazi|mpv|btop|matugen|zsh|bash|gtk|gtk-3.0|gtk-4.0|systemd|pipewire|wireplumber|fontconfig|dconf|pulse|clangd|fastfetch)
      return 0 ;;
  esac

  local root_dir name cand
  for root_dir in "${USER_HOME}/.config" "${USER_HOME}/.cache" "${USER_HOME}/.local/share" "${USER_HOME}/.local/state"; do
    for name in "$pkg" "$base"; do
      [[ -n "$name" && "$name" != "." && "$name" != ".." && "$name" != */* ]] || continue
      cand="${root_dir}/${name}"
      if [[ -e "$cand" ]]; then
        rm -rf "$cand"
        log_line "PURGED PATH: ${cand/#$USER_HOME/\~}"
      fi
    done
  done
}

clean_orphans_cascade() {
  local round=1
  local -a orph=()
  while mapfile -t orph < <(pacman -Qtdq 2>/dev/null || true) && (( ${#orph[@]} > 0 )); do
    log_line "ORPHAN PASS #${round}: ${orph[*]}"
    if ! pacman -Rns --noconfirm "${orph[@]}" >> "$LOG_FILE" 2>&1; then
      log_line "WARN: pacman -Rns falló en ronda de huérfanos #${round}"
      break
    fi
    local op
    for op in "${orph[@]}"; do
      purge_pkg_files "$op"
    done
    round=$((round + 1))
    (( round > 8 )) && break
  done
}

refresh_user_views() {
  if [[ -x "${USER_HOME}/.local/bin/sys-update" ]]; then
    sudo -u "$USER_NAME" HOME="$USER_HOME" bash "${USER_HOME}/.local/bin/sys-update" installed >/dev/null 2>&1 || true
    sudo -u "$USER_NAME" HOME="$USER_HOME" bash "${USER_HOME}/.local/bin/sys-update" check >/dev/null 2>&1 || true
  fi
}

case "$ACTION" in
  upgrade)
    : > "$LOG_FILE"
    chown "${USER_NAME}:${USER_NAME}" "$LOG_FILE"
    log_line "=== SYSTEM UPGRADE STARTED ==="

    load_averages
    T_START=$SECONDS

    repo_count="$(pacman -Qu 2>/dev/null | wc -l || echo 0)"
    aur_count=0
    if command -v paru >/dev/null 2>&1; then
      aur_count="$(sudo -u "$USER_NAME" HOME="$USER_HOME" paru -Qua 2>/dev/null | wc -l || echo 0)"
    fi

    eta="$(calc_eta "$AVG_BASE" "$repo_count" "$aur_count")"
    write_progress "snapshot" "01 // CHECKING SYSTEM SNAPSHOT..." true 8 "$eta" ""
    SNAP_CREATED="$(create_pre_snapshot)"
    log_line "SNAPSHOT: ${SNAP_CREATED}"
    T_SNAP_END=$SECONDS
    snap_elapsed=$(( T_SNAP_END - T_START ))

    eta="$(calc_eta 3 "$repo_count" "$aur_count")"
    write_progress "upgrading" "02 // UPDATING OFFICIAL REPOS (PACMAN)..." true 22 "$eta" "$SNAP_CREATED"
    T_REPO_START=$SECONDS
    if ! pacman -Syu --noconfirm --needed >> "$LOG_FILE" 2>&1; then
      log_line "ERROR: pacman -Syu failed"
      write_progress "error" "ERROR // PACMAN UPGRADE FAILED" false 0 0 "$SNAP_CREATED"
      exit 1
    fi
    T_REPO_END=$SECONDS
    repo_elapsed=$(( T_REPO_END - T_REPO_START ))

    T_AUR_START=$SECONDS
    actual_aur=0
    if command -v paru >/dev/null 2>&1; then
      mapfile -t aur_pkgs < <(sudo -u "$USER_NAME" HOME="$USER_HOME" paru -Qua 2>/dev/null | awk '{print $1}' || true)
      total_aur=${#aur_pkgs[@]}
      actual_aur=$total_aur
      if (( total_aur > 0 )); then
        build_dir="/tmp/sys-update-aur-${USER_NAME}"
        rm -rf "$build_dir"
        mkdir -p "$build_dir"
        chown "${USER_NAME}:${USER_NAME}" "$build_dir"

        idx=0
        for pkg in "${aur_pkgs[@]}"; do
          rem_aur=$(( total_aur - idx ))
          if (( idx > 0 )); then
            obs_aur="$(awk -v el="$(( SECONDS - T_AUR_START ))" -v n="$idx" 'BEGIN { print el / n }')"
            AVG_AUR="$(awk -v obs="$obs_aur" -v hist="$AVG_AUR" 'BEGIN { print (obs * 0.7) + (hist * 0.3) }')"
          fi
          eta="$(calc_eta 4 0 "$rem_aur")"
          pct=$(( 30 + (idx * 55) / total_aur ))
          write_progress "upgrading" "02 // AUR [$((idx + 1))/${total_aur}]: ${pkg}" true "$pct" "$eta" "$SNAP_CREATED"
          log_line "BUILDING AUR: ${pkg}"

          sudo -u "$USER_NAME" HOME="$USER_HOME" \
            paru -S --aur --noconfirm --needed --clonedir "$build_dir" --builddir "$build_dir" --sudo /bin/true "$pkg" >> "$LOG_FILE" 2>&1 || true
          idx=$((idx + 1))
        done

        write_progress "upgrading" "03 // INSTALLING BUILT AUR PACKAGES..." true 90 5 "$SNAP_CREATED"
        mapfile -t built_files < <(find "$build_dir" -type f -name "*.pkg.tar.*" ! -name "*.sig" 2>/dev/null || true)
        if (( ${#built_files[@]} > 0 )); then
          if ! pacman -U --noconfirm --needed "${built_files[@]}" >> "$LOG_FILE" 2>&1; then
            rm -rf "$build_dir"
            log_line "ERROR: pacman -U failed"
            write_progress "error" "ERROR // AUR INSTALL FAILED" false 0 0 "$SNAP_CREATED"
            exit 1
          fi
        else
          still_pending="$(sudo -u "$USER_NAME" HOME="$USER_HOME" paru -Qua 2>/dev/null | wc -l || echo 0)"
          if (( still_pending > 0 )); then
            rm -rf "$build_dir"
            log_line "ERROR: AUR build failed"
            write_progress "error" "ERROR // AUR BUILD FAILED" false 0 0 "$SNAP_CREATED"
            exit 1
          fi
        fi
        rm -rf "$build_dir"
      fi
    fi
    T_AUR_END=$SECONDS
    aur_elapsed=$(( T_AUR_END - T_AUR_START ))

    write_progress "syncing" "04 // SYNCING PACKAGES & AUTO-STOW..." true 96 2 "$SNAP_CREATED"
    T_SYNC_START=$SECONDS
    sync_repo_state
    T_END=$SECONDS
    sync_elapsed=$(( T_END - T_SYNC_START ))

    base_total=$(( snap_elapsed + sync_elapsed ))
    total_elapsed=$(( T_END - T_START ))
    record_history "$base_total" "$repo_count" "$repo_elapsed" "$actual_aur" "$aur_elapsed" "$total_elapsed"

    log_line "=== UPGRADE COMPLETE (${total_elapsed}s) ==="
    tmp="$(mktemp)"
    mapfile -t rem_orph < <(pacman -Qtdq 2>/dev/null || true)
    jq -n \
      --arg snap "$SNAP_CREATED" \
      --arg ts "$(date '+%Y-%m-%d %H:%M')" \
      --argjson orph "$(printf '%s\n' "${rem_orph[@]:-}" | jq -Rn '[inputs | select(length > 0)]')" \
      '{count: 0, packages: [], orphanCount: ($orph | length), orphans: $orph, phase: "done", message: "05 // INSTALLATION COMPLETE", running: false, progress: 100, etaSeconds: 0, lastSnapshot: $snap, updatedAt: $ts}' > "$tmp"
    mv "$tmp" "$STATE_FILE"
    chown "${USER_NAME}:${USER_NAME}" "$STATE_FILE"
    ;;

  remove)
    shift
    if (( $# == 0 )); then
      echo "Uso: sys-update-apply remove <pkg1> [pkg2 ...]" >&2
      exit 1
    fi

    : > "$LOG_FILE"
    chown "${USER_NAME}:${USER_NAME}" "$LOG_FILE"
    log_line "=== PACKAGE PURGE STARTED ==="

    local_targets=()
    for arg in "$@"; do
      if [[ ! "$arg" =~ ^[a-zA-Z0-9@._+-]+$ ]]; then
        log_line "ERROR: invalid package name: $arg"
        write_progress "error" "ERROR // INVALID PACKAGE NAME" false 0 0 ""
        exit 1
      fi
      if is_protected_pkg "$arg"; then
        log_line "BLOCKED: protected system package: $arg"
        write_progress "error" "BLOCKED // PROTECTED PACKAGE: ${arg}" false 0 0 ""
        exit 1
      fi
      local_targets+=("$arg")
    done

    write_progress "snapshot" "01 // PRE-REMOVAL SNAPSHOT..." true 10 8 ""
    SNAP_CREATED="$(create_pre_snapshot)"
    log_line "SNAPSHOT: ${SNAP_CREATED}"

    write_progress "removing" "02 // RESOLVING DEPENDENCY ORDER..." true 25 6 "$SNAP_CREATED"
    mapfile -t ordered_pkgs < <(LC_ALL=C pacman -Rns --print-format '%n' "${local_targets[@]}" 2>> "$LOG_FILE" || true)
    if (( ${#ordered_pkgs[@]} == 0 )); then
      log_line "ERROR: dependency resolution failed (required by other packages)"
      write_progress "error" "ERROR // DEPENDENCY CONFLICT (SEE LOG)" false 0 0 "$SNAP_CREATED"
      exit 1
    fi
    log_line "SAFE REMOVAL ORDER (${#ordered_pkgs[@]}): ${ordered_pkgs[*]}"

    write_progress "removing" "03 // REMOVING ${#ordered_pkgs[@]} PKGS IN ORDER..." true 50 5 "$SNAP_CREATED"
    if ! pacman -Rns --noconfirm "${local_targets[@]}" >> "$LOG_FILE" 2>&1; then
      log_line "ERROR: pacman -Rns failed"
      write_progress "error" "ERROR // REMOVAL FAILED (SEE LOG)" false 0 0 "$SNAP_CREATED"
      exit 1
    fi

    write_progress "removing" "04 // PURGING RELATED PATHS & CACHES..." true 72 3 "$SNAP_CREATED"
    for p in "${ordered_pkgs[@]}"; do
      purge_pkg_files "$p"
    done

    write_progress "removing" "05 // CLEANING CASCADING ORPHANS..." true 86 2 "$SNAP_CREATED"
    clean_orphans_cascade

    write_progress "syncing" "06 // SYNCING PACKAGES..." true 95 1 "$SNAP_CREATED"
    sync_repo_state
    log_line "=== PURGE COMPLETE ==="

    write_progress "done" "PURGE COMPLETE (${#ordered_pkgs[@]} PKGS)" false 100 0 "$SNAP_CREATED"
    refresh_user_views
    ;;

  orphans)
    : > "$LOG_FILE"
    chown "${USER_NAME}:${USER_NAME}" "$LOG_FILE"
    log_line "=== ORPHAN CLEANUP STARTED ==="

    write_progress "snapshot" "01 // PRE-CLEANUP SNAPSHOT..." true 15 5 ""
    SNAP_CREATED="$(create_pre_snapshot)"
    log_line "SNAPSHOT: ${SNAP_CREATED}"

    write_progress "removing" "02 // REMOVING ORPHANS IN SAFE ORDER..." true 55 3 "$SNAP_CREATED"
    clean_orphans_cascade

    write_progress "syncing" "03 // SYNCING PACKAGES..." true 90 1 "$SNAP_CREATED"
    sync_repo_state
    log_line "=== ORPHAN CLEANUP COMPLETE ==="

    write_progress "done" "ORPHANS PURGED" false 100 0 "$SNAP_CREATED"
    refresh_user_views
    ;;

  *)
    echo "Uso: sys-update-apply [upgrade|remove <pkgs...>|orphans]" >&2
    exit 1
    ;;
esac
