Window.SetBackgroundTopColor(0.0, 0.0, 0.0);
Window.SetBackgroundBottomColor(0.0, 0.0, 0.0);

screen_w = Window.GetWidth();
screen_h = Window.GetHeight();

mode = Plymouth.GetMode();
in_password = 0;
tick = 0;

bar_w = 360;
bar_h = 2;
bar_x = screen_w / 2 - bar_w / 2;
bar_y = screen_h / 2 + 18;

track_img = Image("bar_track.png").Scale(bar_w, bar_h);
track_spr = Sprite(track_img);
track_spr.SetPosition(bar_x, bar_y, 1);

fill_base = Image("bar_white.png");
fill_spr = Sprite(fill_base.Scale(1, bar_h));
fill_spr.SetPosition(bar_x, bar_y, 2);

fun make_label(text, v) {
  img = Image.Text(text, v, v, v, 1.0, "JetBrainsMono Nerd Font 13");
  spr = Sprite(img);
  spr.SetX(screen_w / 2 - img.GetWidth() / 2);
  return spr;
}

header_txt = "SYSTEM // CRYPTROOT";
if (mode == "shutdown") header_txt = "SYSTEM // POWEROFF";
else if (mode == "reboot") header_txt = "SYSTEM // REBOOT";

title_spr = make_label(header_txt, 0.65);
title_spr.SetY(screen_h / 2 - 42);

prompt_spr = make_label("", 1.0);
prompt_spr.SetY(screen_h / 2 - 12);

dots_spr = make_label("", 1.0);
dots_spr.SetY(screen_h / 2 + 18);

fun refresh_callback() {
  if (in_password == 1) return;
  tick++;
  step = 4;
  if (mode == "shutdown" || mode == "reboot") step = 18;

  cur_w = tick * step;
  if (cur_w > bar_w) cur_w = bar_w;
  if (cur_w < 4) cur_w = 4;
  fill_spr.SetImage(fill_base.Scale(cur_w, bar_h));
  fill_spr.SetPosition(bar_x, bar_y, 2);
}
Plymouth.SetRefreshFunction(refresh_callback);

fun password_callback(prompt_text, bullets) {
  in_password = 1;
  track_spr.SetOpacity(0);
  fill_spr.SetOpacity(0);

  p_img = Image.Text("ENTER DISK PASSPHRASE", 1.0, 1.0, 1.0, 1.0, "JetBrainsMono Nerd Font 13");
  prompt_spr.SetImage(p_img);
  prompt_spr.SetX(screen_w / 2 - p_img.GetWidth() / 2);

  b_str = "";
  max_b = bullets;
  if (max_b > 28) max_b = 28;
  for (i = 0; i < max_b; i++) b_str += "─";
  if (bullets == 0) b_str = "[ _ ]";

  d_img = Image.Text(b_str, 1.0, 1.0, 1.0, 1.0, "JetBrainsMono Nerd Font 14");
  dots_spr.SetImage(d_img);
  dots_spr.SetX(screen_w / 2 - d_img.GetWidth() / 2);
}
Plymouth.SetDisplayPasswordFunction(password_callback);

fun normal_callback() {
  in_password = 0;
  tick = 0;
  empty = Image.Text("", 1, 1, 1);
  prompt_spr.SetImage(empty);
  dots_spr.SetImage(empty);
  track_spr.SetOpacity(1);
  fill_spr.SetOpacity(1);
}
Plymouth.SetDisplayNormalFunction(normal_callback);

fun message_callback(text) {}
Plymouth.SetMessageFunction(message_callback);
