import Quickshell.Services.Pam
import QtQuick

Singleton {
    id: root

    // ---------- Ajustes ----------
    property string pamService: "login"
    readonly property string home: Quickshell.env("HOME")
    readonly property string stateWallpaperFile: home + "/.local/state/quickshell/current-wallpaper"

    // ---------- Estado ----------
    property bool locked: false
    property string buffer: ""
    property string status: "idle"           // "idle" | "checking" | "error"
    property string message: ""
    readonly property bool busy: status === "checking"
    signal failed

    // ---------- Usuario ----------
    readonly property string user: Quickshell.env("USER") || "usuario"
    property string realName: ""
    readonly property string displayName: {
        const n = realName.trim();
        const base = n !== "" ? n.split(/\s+/)[0] : user;
        return base.charAt(0).toUpperCase() + base.slice(1);
    }

    Process {
        id: nameProc
        running: true
        command: ["sh", "-c", "getent passwd \"$USER\" | cut -d: -f5 | cut -d, -f1"]
        stdout: StdioCollector {
            onStreamFinished: root.realName = text.trim()
        }
    }

    // ---------- Wallpaper actual (swww, swaybg o archivo de estado) ----------
    property string currentWallpaper: ""

    Process {
        id: wallQueryProc
        command: [
            "bash", "-c",
            "if command -v awww >/dev/null 2>&1 && pgrep -x awww-daemon >/dev/null 2>&1; then " +
            "  awww query 2>/dev/null | head -n1 | sed -n 's/.*image: //p'; " +
            "elif command -v swww >/dev/null 2>&1 && pgrep -x swww-daemon >/dev/null 2>&1; then " +
            "  swww query 2>/dev/null | head -n1 | sed -n 's/.*image: //p'; " +
            "elif pgrep -x swaybg >/dev/null 2>&1; then " +
            "  ps -C swaybg -o args= | head -n1 | grep -oE '(-i|--image)[= ]+[^ ]+' | sed -E 's/^(-i|--image)[= ]+//'; " +
            "elif [ -L \"$HOME/.local/state/quickshell/current-wallpaper\" ]; then " +
            "  readlink -f \"$HOME/.local/state/quickshell/current-wallpaper\"; " +
            "elif [ -f \"$HOME/.local/state/quickshell/current-wallpaper\" ]; then " +
            "  cat \"$HOME/.local/state/quickshell/current-wallpaper\"; " +
            "fi"
        ]
        stdout: StdioCollector {
            onStreamFinished: {
                const p = this.text.trim().replace(/^["']|["']$/g, "");
                if (p !== "") {
                    root.currentWallpaper = p.replace(/^~/, root.home);
                }
            }
        }
    }

    // Vigila cambios si usas un archivo/symlink de estado para actualizar en vivo
    FileView {
        id: wallStateWatcher
        path: root.stateWallpaperFile
        watchChanges: true
        onFileChanged: root.refreshWallpaper()
    }

    // Mantiene la ruta del wallpaper actualizada antes de bloquear
    Timer {
        id: wallSyncTimer
        interval: 3000
        running: true
        repeat: true
        onTriggered: {
            if (!root.locked) {
                root.refreshWallpaper();
            }
        }
    }

    function refreshWallpaper() {
        if (!wallQueryProc.running) {
            wallQueryProc.running = true;
        }
    }

    Component.onCompleted: refreshWallpaper()

    // ---------- API ----------
    function lock() {
        if (locked)
            return;
        refreshWallpaper();
        buffer = "";
        status = "idle";
        message = "";
        locked = true;
    }

    function type(ch) {
        if (busy)
            return;
        if (status === "error")
            status = "idle";
        buffer += ch;
    }

    function backspace() {
        if (busy)
            return;
        buffer = buffer.slice(0, -1);
    }

    function clear() {
        if (busy)
            return;
        buffer = "";
        if (status === "error")
            status = "idle";
    }

    function submit() {
        if (busy || buffer.length === 0)
            return;
        status = "checking";
        message = "";
        pam.config = root.pamService;
        pam.start();
    }

    // ---------- Validación (PAM) ----------
    PamContext {
        id: pam
        config: root.pamService

        onPamMessage: {
            if (responseRequired)
                respond(root.buffer);
        }

        onCompleted: result => {
            if (result === PamResult.Success) {
                root.buffer = "";
                root.status = "idle";
                root.message = "";
                root.locked = false;
            } else {
                root.buffer = "";
                root.status = "error";
                root.message = result === PamResult.MaxTries ? "Too many attempts" : "Incorrect password";
                root.failed();
            }
        }

        onError: err => {
            root.buffer = "";
            root.status = "error";
            root.message = "Authentication error";
            root.failed();
        }
    }

    // ---------- IPC: qs ipc call lock lock ----------
    IpcHandler {
        target: "lock"
        function lock(): void {
            root.lock();
        }
        function isLocked(): bool {
            return root.locked;
        }
    }
}
</file>

<file path="config/quickshell/.config/quickshell/services/Network.qml">
pragma Singleton
import QtQuick
import Quickshell
import Quickshell.Io

Singleton {
    id: root

    property string connectionType: "none" // "wifi" | "ethernet" | "none"
    property string ssid: ""
    property int signal: 0
    property bool wifiEnabled: true

    Process {
        id: checkNet
        command: [
            "bash", "-c",
            "radio=$(nmcli radio wifi 2>/dev/null); " +
            "active=$(nmcli -t -f TYPE,STATE,CONNECTION dev 2>/dev/null | awk -F: '$2==\"connected\" {print $1\":\"$3; exit}'); " +
            "sig=$(nmcli -t -f ACTIVE,SIGNAL dev wifi 2>/dev/null | awk -F: '$1==\"yes\" {print $2; exit}'); " +
            "echo \"RADIO:${radio:-disabled}\"; " +
            "echo \"ACTIVE:${active:-none:}\"; " +
            "echo \"SIGNAL:${sig:-0}\""
        ]
        stdout: SplitParser {
            splitMarker: ""
            onRead: data => {
                const lines = data.trim().split("\n");
                let rEnabled = true;
                let cType = "none";
                let cName = "";
                let sigVal = 0;

                for (let i = 0; i < lines.length; i++) {
                    const line = lines[i];
                    if (line.startsWith("RADIO:")) {
                        rEnabled = (line.slice(6).trim() === "enabled");
                    } else if (line.startsWith("ACTIVE:")) {
                        const rest = line.slice(7);
                        const sep = rest.indexOf(":");
                        if (sep !== -1) {
                            const rawType = rest.slice(0, sep).trim();
                            cName = rest.slice(sep + 1).trim();
                            if (rawType === "802-11-wireless" || rawType === "wifi") {
                                cType = "wifi";
                            } else if (rawType === "802-3-ethernet" || rawType === "ethernet") {
                                cType = "ethernet";
                            } else {
                                cType = "none";
                            }
                        }
                    } else if (line.startsWith("SIGNAL:")) {
                        sigVal = parseInt(line.slice(7).trim()) || 0;
                    }
                }

                root.wifiEnabled = rEnabled;
                root.connectionType = cType;
                root.ssid = cName;
                root.signal = sigVal;
            }
        }
    }

    Timer {
        interval: 4000
        running: true
        repeat: true
        triggeredOnStart: true
        onTriggered: {
            if (!checkNet.running) checkNet.running = true;
        }
    }

    function refresh() {
        if (!checkNet.running) checkNet.running = true;
    }

    function toggleWifi() {
        const target = root.wifiEnabled ? "off" : "on";
        Quickshell.execDetached(["nmcli", "radio", "wifi", target]);
        refreshTimer.restart();
    }

    function openManager() {
        // Abre nmtui como popup flotante que se cierra solo al perder el foco
        Quickshell.execDetached(["ghostty", "--class=tui.popup", "-e", "nmtui"]);
    }

    Timer {
        id: refreshTimer
        interval: 800
        onTriggered: root.refresh()
    }
}
</file>

<file path="config/quickshell/.config/quickshell/services/Theme.qml">
pragma Singleton

import Quickshell
import Quickshell.Io
import QtQuick

Singleton {
    id: root

    readonly property string home: Quickshell.env("HOME")
    readonly property string colorsPath: home + "/.local/state/quickshell/colors.json"

    // ---------- Colores reactivos (Catppuccin Mocha por defecto) ----------
    property bool dark: true
    property color bg: "#1e1e2e"
    property color card: "#181825"
    property color cardAlt: "#313244"
    property color text: "#cdd6f4"
    property color sub: "#a6adc8"
    property color muted: "#6c7086"
    property color border: "#45475a"
    property color accent: "#cba6f7"
    property color accentSoft: "#89b4fa"
    property color highlight: "#f5c2e7"
    property color warn: "#f38ba8"

    // ---------- Tipografías globales ----------
    readonly property string fontFamily: "JetBrainsMono Nerd Font"
    readonly property string displayFont: "Anton"

    function applyJson(raw) {
        try {
            const c = JSON.parse(raw);
            if (typeof c.dark === "boolean") root.dark = c.dark;
            if (c.bg) root.bg = c.bg;
            if (c.card) root.card = c.card;
            if (c.cardAlt) root.cardAlt = c.cardAlt;
            if (c.text) root.text = c.text;
            if (c.sub) root.sub = c.sub;
            if (c.muted) root.muted = c.muted;
            if (c.border) root.border = c.border;
            if (c.accent) root.accent = c.accent;
            if (c.accentSoft) root.accentSoft = c.accentSoft;
            if (c.highlight) root.highlight = c.highlight;
            if (c.warn) root.warn = c.warn;
        } catch (e) {}
    }

    FileView {
        id: colorsFile
        path: root.colorsPath
        blockLoading: true
        watchChanges: true
        onFileChanged: reloadDebounce.restart()
        onLoaded: root.applyJson(this.text())
    }

    Timer {
        id: reloadDebounce
        interval: 80
        onTriggered: colorsFile.reload()
    }

    Component.onCompleted: {
        try {
            const initial = colorsFile.text();
            if (initial && initial.trim() !== "") {
                root.applyJson(initial);
            }
        } catch (e) {}
    }
}
</file>

