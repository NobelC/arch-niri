autoload -Uz edit-command-line
zle -N edit-command-line
bindkey '^X^E' edit-command-line

# Esc Esc: antepone/quita `sudo` (si la línea está vacía, usa el comando anterior)
_sudo_toggle() {
  [[ -z $BUFFER ]] && BUFFER=$history[$((HISTCMD-1))]
  if [[ $BUFFER == sudo\ * ]]; then BUFFER="${BUFFER#sudo }"; else BUFFER="sudo $BUFFER"; fi
  CURSOR=${#BUFFER}
}
zle -N _sudo_toggle
bindkey '\e\e' _sudo_toggle

# Ctrl+Z: con la línea vacía vuelve al trabajo suspendido (fg); si no, guarda lo escrito
_fg_toggle() {
  if (( ${#BUFFER} == 0 )); then BUFFER=fg; zle accept-line
  else zle push-input; zle clear-screen; fi
}
zle -N _fg_toggle
bindkey '^Z' _fg_toggle
</file>

<file path="config/zsh/.config/zsh/conf.d/50-aliases.zsh">
# ── 50-aliases ────────────────────────────────────────────────────────────────
# Para saltarte un alias puntualmente: \cat archivo   o   command cat archivo

# --- ls -> eza ---
if (( $+commands[eza] )); then
  alias ls='eza --icons=auto --group-directories-first'
  alias l='eza -1 --icons=auto --group-directories-first'
  alias ll='eza -lh --icons=auto --group-directories-first --git'
  alias la='eza -lah --icons=auto --group-directories-first --git'
  alias lt='eza --tree --level=2 --icons=auto --group-directories-first'
  alias lta='eza --tree --level=2 -a --icons=auto --group-directories-first --ignore-glob=.git'
else
  alias ls='ls --color=auto --group-directories-first'
  alias ll='ls -lh'
  alias la='ls -lAh'
fi

# --- cat -> bat (en una tubería se comporta como cat normal) ---
if (( $+commands[bat] )); then
  alias cat='bat --paging=never'
  alias catp='bat --paging=never --plain'     # sin números ni cabecera
  alias less='bat --paging=always'            # visor con colores (q para salir)
fi

# --- Herramientas modernas, si existen ---
(( $+commands[nvim] ))    && alias v='nvim' vi='nvim' vim='nvim'
alias grep='grep --color=auto'
(( $+commands[lazygit] )) && alias lg='lazygit'
(( $+commands[btop] ))    && alias top='btop'
alias diff='diff --color=auto'
alias ip='ip -color=auto'
alias df='df -h'
alias free='free -h'
alias mkdir='mkdir -pv'
alias cp='cp -iv'
alias mv='mv -iv'
alias rm='rm -I'
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'
alias -- -='cd -'
alias dirs='dirs -v'
alias h='history 1'
alias c='clear'
alias q='exit'
alias ping='gping'

# --- Arch / pacman / yay ---
if (( $+commands[yay] )); then
  alias update='yay -Syu'
  alias aur='yay -S --needed'
else
  alias update='sudo pacman -Syu'
fi
alias pac='sudo pacman -S --needed'
alias pacrm='sudo pacman -Rns'
alias orphans='pacman -Qtdq'
alias pkgclean='sudo pacman -Sc'

# --- Dotfiles / Hyprland ---
alias dots='cd "$DOTFILES"'
alias hyprlog='tail -f ${XDG_RUNTIME_DIR}/hypr/${HYPRLAND_INSTANCE_SIGNATURE}/hyprland.log'
alias reload='exec zsh'
</file>

<file path="config/zsh/.config/zsh/conf.d/55-git.zsh">
