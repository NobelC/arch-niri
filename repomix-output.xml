<file path="config/quickshell/.config/quickshell/services/Audio.qml">
pragma Singleton
import QtQuick
import Quickshell
import Quickshell.Io

Singleton {
    id: root

    property int volume: 0
    property bool muted: false
    property bool initialized: false

    signal osdTriggered()

    Process {
        id: checkAudio
        command: ["wpctl", "get-volume", "@DEFAULT_AUDIO_SINK@"]
        stdout: StdioCollector {
            onStreamFinished: {
                const trimmed = this.text.trim();
                const match = trimmed.match(/Volume:\s*([0-9.]+)/);
                let newVol = root.volume;
                if (match) {
                    newVol = Math.round(parseFloat(match[1]) * 100);
                }
                const newMuted = trimmed.includes("[MUTED]");

                if (root.initialized && (newVol !== root.volume || newMuted !== root.muted)) {
                    root.volume = newVol;
                    root.muted = newMuted;
                    root.osdTriggered();
                } else {
                    root.volume = newVol;
                    root.muted = newMuted;
                    root.initialized = true;
                }
            }
        }
    }

    Timer {
        interval: 300
        running: true
        repeat: true
        triggeredOnStart: true
        onTriggered: {
            if (!checkAudio.running) checkAudio.running = true;
        }
    }

    function refresh() {
        if (!checkAudio.running) checkAudio.running = true;
    }

    function toggleMute() {
        Quickshell.execDetached(["wpctl", "set-mute", "@DEFAULT_AUDIO_SINK@", "toggle"]);
        refreshTimer.restart();
    }

    function changeVolume(deltaPercent) {
        const sign = deltaPercent >= 0 ? "+" : "-";
        const absVal = Math.abs(deltaPercent);
        Quickshell.execDetached([
            "wpctl", "set-volume", "-l", "1.0",
            "@DEFAULT_AUDIO_SINK@", absVal + "%" + sign
        ]);
        refreshTimer.restart();
    }

    function openMixer() {
        Quickshell.execDetached([
            "bash", "-c",
            "if command -v wiremix >/dev/null; then " +
            "  ghostty --class=tui.popup -e wiremix; " +
            "elif command -v pulsemixer >/dev/null; then " +
            "  ghostty --class=tui.popup -e pulsemixer; " +
            "else " +
            "  ghostty --class=tui.popup -e alsamixer; " +
            "fi"
        ]);
    }

    Timer {
        id: refreshTimer
        interval: 80
        onTriggered: root.refresh()
    }
}
</file>

<file path="config/quickshell/.config/quickshell/services/Battery.qml">
pragma Singleton
import QtQuick
import Quickshell
import Quickshell.Io

Singleton {
    id: root

    property bool available: false
    property int capacity: 0
    property string status: "Unknown"
    readonly property bool charging: status === "Charging"
    readonly property bool full: status === "Full" || (status === "Not charging" && capacity >= 95)

    Process {
        id: checkBattery
        command: [
            "bash", "-c",
            "bat=$(ls -d /sys/class/power_supply/BAT* 2>/dev/null | head -n1); " +
            "if [ -n \"$bat\" ]; then " +
            "  echo \"AVAIL:1\"; " +
            "  echo \"CAP:$(cat \"$bat/capacity\" 2>/dev/null || echo 0)\"; " +
            "  echo \"STAT:$(cat \"$bat/status\" 2>/dev/null || echo Unknown)\"; " +
            "else " +
            "  echo \"AVAIL:0\"; " +
            "fi"
        ]
        stdout: StdioCollector {
            onStreamFinished: {
                const lines = this.text.trim().split("\n");
                let isAvail = false;
                let capVal = 0;
                let statVal = "Unknown";

                for (let i = 0; i < lines.length; i++) {
                    const line = lines[i];
                    if (line.startsWith("AVAIL:")) {
                        isAvail = (line.slice(6).trim() === "1");
                    } else if (line.startsWith("CAP:")) {
                        capVal = parseInt(line.slice(4).trim()) || 0;
                    } else if (line.startsWith("STAT:")) {
                        statVal = line.slice(5).trim();
                    }
                }

                root.available = isAvail;
                root.capacity = capVal;
                root.status = statVal;
            }
        }
    }

    Timer {
        interval: 5000
        running: true
        repeat: true
        triggeredOnStart: true
        onTriggered: {
            if (!checkBattery.running) checkBattery.running = true;
        }
    }

    function refresh() {
        if (!checkBattery.running) checkBattery.running = true;
    }
}
</file>

<file path="config/quickshell/.config/quickshell/services/Bluetooth.qml">
pragma Singleton
import QtQuick
import Quickshell
import Quickshell.Io

Singleton {
    id: root

    property bool powered: false
    property bool connected: false
    property string deviceName: ""
    property int connectedCount: 0

    // Consulta estado del adaptador y dispositivos conectados
    Process {
        id: checkBt
        command: [
            "bash", "-c",
            "powered=$(bluetoothctl show 2>/dev/null | awk '/Powered:/ {print $2}'); " +
            "devs=$(bluetoothctl devices Connected 2>/dev/null | sed -E 's/^Device [^ ]+ //'); " +
            "echo \"POWERED:${powered:-no}\"; " +
            "echo \"DEVS:${devs}\""
        ]
        stdout: SplitParser {
            splitMarker: ""
            onRead: data => {
                const lines = data.trim().split("\n");
                let isPowered = false;
                let devList = [];

                for (let i = 0; i < lines.length; i++) {
                    const line = lines[i];
                    if (line.startsWith("POWERED:")) {
                        isPowered = (line.slice(8).trim() === "yes");
                    } else if (line.startsWith("DEVS:")) {
                        const first = line.slice(5).trim();
                        if (first.length > 0) devList.push(first);
                    } else if (line.trim().length > 0) {
                        devList.push(line.trim());
                    }
                }

                root.powered = isPowered;
                root.connectedCount = devList.length;
                root.connected = devList.length > 0;
                root.deviceName = devList.length > 0 ? devList[0] : "";
            }
        }
    }

    // Actualización periódica ligera (cada 3s)
    Timer {
        interval: 3000
        running: true
        repeat: true
        triggeredOnStart: true
        onTriggered: {
            if (!checkBt.running) checkBt.running = true;
        }
    }

    function refresh() {
        if (!checkBt.running) checkBt.running = true;
    }

    function togglePower() {
        const targetState = root.powered ? "off" : "on";
        Quickshell.execDetached(["bluetoothctl", "power", targetState]);
        refreshTimer.restart();
    }

    function openManager() {
        Quickshell.execDetached([
            "bash", "-c",
            "bluetoothctl power on >/dev/null 2>&1; " +
            "ghostty --class=tui.popup -e bluetui"
        ]);
    }
    Timer {
        id: refreshTimer
        interval: 600
        onTriggered: root.refresh()
    }
}
</file>

<file path="config/quickshell/.config/quickshell/services/Brightness.qml">
pragma Singleton
import QtQuick
import Quickshell
import Quickshell.Io

Singleton {
    id: root

    property int brightness: 0
    property bool initialized: false

    signal osdTriggered()

    Process {
        id: checkBrightness
        command: [
            "bash", "-c",
            "cur=$(brightnessctl get 2>/dev/null || echo 0); " +
            "max=$(brightnessctl max 2>/dev/null || echo 100); " +
            "echo $(( cur * 100 / (max > 0 ? max : 1) ))"
        ]
        stdout: StdioCollector {
            onStreamFinished: {
                const val = parseInt(this.text.trim());
                if (!isNaN(val)) {
                    if (root.initialized && val !== root.brightness) {
                        root.brightness = val;
                        root.osdTriggered();
                    } else {
                        root.brightness = val;
                        root.initialized = true;
                    }
                }
            }
        }
    }

    // Sondeo ligero cada 300ms para detectar pulsaciones físicas de teclas de brillo al instante
    Timer {
        interval: 300
        running: true
        repeat: true
        triggeredOnStart: true
        onTriggered: {
            if (!checkBrightness.running) checkBrightness.running = true;
        }
    }

    function refresh() {
        if (!checkBrightness.running) checkBrightness.running = true;
    }
}
</file>

<file path="config/quickshell/.config/quickshell/services/CapsLock.qml">
pragma Singleton
import QtQuick
import Quickshell
import Quickshell.Io

Singleton {
    id: root

    property bool active: false
    property bool initialized: false

    signal osdTriggered()

    Process {
        id: checkCaps
        command: [
            "bash", "-c",
            "cat /sys/class/leds/*::capslock/brightness 2>/dev/null | grep -q 1 && echo 1 || echo 0"
        ]
        stdout: StdioCollector {
            onStreamFinished: {
                const newState = (this.text.trim() === "1");
                if (root.initialized && newState !== root.active) {
                    root.active = newState;
                    root.osdTriggered();
                } else {
                    root.active = newState;
                    root.initialized = true;
                }
            }
        }
    }

    // Sondeo ligero cada 150ms para reaccionar al instante al pulsar Caps Lock
    Timer {
        interval: 150
        running: true
        repeat: true
        triggeredOnStart: true
        onTriggered: {
            if (!checkCaps.running) checkCaps.running = true;
        }
    }
}
</file>

<file path="config/quickshell/.config/quickshell/services/Network.qml">
pragma Singleton
import QtQuick
import Quickshell
import Quickshell.Io

Singleton {
    id: root

    property string connectionType: "none" // "wifi" | "ethernet" | "none"
    property string ssid: ""
    property int signal: 0
    property bool wifiEnabled: true

    Process {
        id: checkNet
        command: [
            "bash", "-c",
            "radio=$(nmcli radio wifi 2>/dev/null); " +
            "active=$(nmcli -t -f TYPE,STATE,CONNECTION dev 2>/dev/null | awk -F: '$2==\"connected\" {print $1\":\"$3; exit}'); " +
            "sig=$(nmcli -t -f ACTIVE,SIGNAL dev wifi 2>/dev/null | awk -F: '$1==\"yes\" {print $2; exit}'); " +
            "echo \"RADIO:${radio:-disabled}\"; " +
            "echo \"ACTIVE:${active:-none:}\"; " +
            "echo \"SIGNAL:${sig:-0}\""
        ]
        stdout: SplitParser {
            splitMarker: ""
            onRead: data => {
                const lines = data.trim().split("\n");
                let rEnabled = true;
                let cType = "none";
                let cName = "";
                let sigVal = 0;

                for (let i = 0; i < lines.length; i++) {
                    const line = lines[i];
                    if (line.startsWith("RADIO:")) {
                        rEnabled = (line.slice(6).trim() === "enabled");
                    } else if (line.startsWith("ACTIVE:")) {
                        const rest = line.slice(7);
                        const sep = rest.indexOf(":");
                        if (sep !== -1) {
                            const rawType = rest.slice(0, sep).trim();
                            cName = rest.slice(sep + 1).trim();
                            if (rawType === "802-11-wireless" || rawType === "wifi") {
                                cType = "wifi";
                            } else if (rawType === "802-3-ethernet" || rawType === "ethernet") {
                                cType = "ethernet";
                            } else {
                                cType = "none";
                            }
                        }
                    } else if (line.startsWith("SIGNAL:")) {
                        sigVal = parseInt(line.slice(7).trim()) || 0;
                    }
                }

                root.wifiEnabled = rEnabled;
                root.connectionType = cType;
                root.ssid = cName;
                root.signal = sigVal;
            }
        }
    }

    Timer {
        interval: 4000
        running: true
        repeat: true
        triggeredOnStart: true
        onTriggered: {
            if (!checkNet.running) checkNet.running = true;
        }
    }

    function refresh() {
        if (!checkNet.running) checkNet.running = true;
    }

    function toggleWifi() {
        const target = root.wifiEnabled ? "off" : "on";
        Quickshell.execDetached(["nmcli", "radio", "wifi", target]);
        refreshTimer.restart();
    }

    function openManager() {
        // Abre nmtui como popup flotante que se cierra solo al perder el foco
        Quickshell.execDetached(["ghostty", "--class=tui.popup", "-e", "nmtui"]);
    }

    Timer {
        id: refreshTimer
        interval: 800
        onTriggered: root.refresh()
    }
}
</file>

