<file path="config/quickshell/.config/quickshell/widgets/battery/Battery.qml">
import QtQuick
import QtQuick.Layouts
import "../../services"

Item {
    id: root
    visible: Battery.available
    implicitWidth: Battery.available ? (contentRow.implicitWidth + 16) : 0
    implicitHeight: 24
    Layout.preferredWidth: implicitWidth
    Layout.preferredHeight: implicitHeight

    function batteryIcon() {
        if (Battery.charging) return "󰂄";
        if (Battery.full) return "󰁹";

        const c = Battery.capacity;
        if (c >= 95) return "󰁹";
        if (c >= 85) return "󰂂";
        if (c >= 75) return "󰂁";
        if (c >= 65) return "󰂀";
        if (c >= 55) return "󰁿";
        if (c >= 45) return "󰁾";
        if (c >= 35) return "󰁽";
        if (c >= 25) return "󰁼";
        if (c >= 15) return "󰁻";
        if (c >= 5)  return "󰁺";
        return "󰂎";
    }

    function batteryColor() {
        if (Battery.charging || Battery.full) return Theme.accent;
        if (Battery.capacity <= 15) return Theme.warn;
        if (Battery.capacity <= 30) return Theme.highlight;
        return Theme.accentSoft;
    }

    Rectangle {
        anchors.fill: parent
        radius: 6
        color: (mouseArea.containsMouse || Niri.activeBarMenu === "battery") ? Theme.cardAlt : "transparent"

        Behavior on color {
            ColorAnimation { duration: 150 }
        }
    }

    Row {
        id: contentRow
        anchors.centerIn: parent
        spacing: 5

        Text {
            anchors.verticalCenter: parent.verticalCenter
            text: root.batteryIcon()
            color: root.batteryColor()
            font.family: Theme.fontFamily
            font.pixelSize: 14

            Behavior on color { ColorAnimation { duration: 150 } }
        }
    }

    MouseArea {
        id: mouseArea
        anchors.fill: parent
        hoverEnabled: true
        cursorShape: Qt.PointingHandCursor
        onClicked: {
            Battery.refresh();
            Niri.toggleBarMenu("battery");
        }
    }
}
</file>

<file path="config/quickshell/.config/quickshell/widgets/osd/Osd.qml">
import QtQuick
import Quickshell
import Quickshell.Wayland
import "../../services"

PanelWindow {
    id: osdWindow

    anchors {
        bottom: true
    }
    margins {
        bottom: 15
    }

    implicitWidth: Math.max(190, contentRow.implicitWidth + 36)
    implicitHeight: 42
    color: "transparent"
    visible: true
    exclusionMode: ExclusionMode.Ignore
    mask: Region {}

    WlrLayershell.layer: WlrLayer.Overlay
    WlrLayershell.namespace: "quickshell-osd"

    property string mode: "audio" // "audio" | "brightness" | "capslock" | "layout"
    property bool isShown: false

    readonly property bool isBarMode: mode === "audio" || mode === "brightness"
    readonly property int currentValue: mode === "audio" ? Audio.volume : Brightness.brightness
    readonly property bool isMuted: mode === "audio" && Audio.muted

    function osdIcon() {
        if (mode === "brightness") {
            if (Brightness.brightness < 35) return "󰃞";
            if (Brightness.brightness < 70) return "󰃟";
            return "󰃠";
        }
        if (Audio.muted || Audio.volume === 0) return "󰝟";
        if (Audio.volume < 35) return "";
        if (Audio.volume < 70) return "";
        return "";
    }

    function osdAccentColor() {
        if (mode === "layout") {
            return Niri.keyboardLayoutCode === "ES" ? Theme.highlight : Theme.accentSoft;
        }
        if (mode === "capslock") {
            return CapsLock.active ? Theme.accent : Theme.sub;
        }
        if (mode === "brightness") return Theme.highlight;
        if (Audio.muted) return Theme.warn;
        return Theme.accentSoft;
    }

    function osdLabelText() {
        if (mode === "layout") {
            return Niri.keyboardLayoutCode === "ES" ? "SPANISH (LATAM)" : "ENGLISH (US)";
        }
        if (mode === "capslock") {
            return CapsLock.active ? "CAPS LOCK ON" : "CAPS LOCK OFF";
        }
        return osdWindow.isMuted ? "Mute" : (osdWindow.currentValue + "%");
    }

    function showOsd(newMode) {
        osdWindow.mode = newMode;
        osdWindow.isShown = true;
        hideTimer.restart();
    }

    Timer {
        id: hideTimer
        interval: 1400
        onTriggered: osdWindow.isShown = false
    }

    Connections {
        target: Audio
        function onOsdTriggered() { osdWindow.showOsd("audio"); }
    }

    Connections {
        target: Brightness
        function onOsdTriggered() { osdWindow.showOsd("brightness"); }
    }

    Connections {
        target: CapsLock
        function onOsdTriggered() { osdWindow.showOsd("capslock"); }
    }

    Connections {
        target: Niri
        function onKeyboardLayoutOsdTriggered() { osdWindow.showOsd("layout"); }
    }

    Rectangle {
        id: card
        anchors.fill: parent
        radius: 12
        color: Theme.bg
        border.width: 1
        border.color: Theme.cardAlt

        Behavior on color { ColorAnimation { duration: 150 } }
        Behavior on border.color { ColorAnimation { duration: 150 } }

        opacity: osdWindow.isShown ? 1.0 : 0.0
        transform: Translate {
            y: osdWindow.isShown ? 0 : 16
            Behavior on y {
                NumberAnimation { duration: 180; easing.type: Easing.OutCubic }
            }
        }

        Behavior on opacity {
            NumberAnimation { duration: 160; easing.type: Easing.OutCubic }
        }

        Row {
            id: contentRow
            anchors.centerIn: parent
            spacing: 12

            Text {
                visible: osdWindow.isBarMode
                anchors.verticalCenter: parent.verticalCenter
                text: osdWindow.osdIcon()
                color: osdWindow.osdAccentColor()
                font.family: Theme.fontFamily
                font.pixelSize: 16
            }

            Rectangle {
                visible: osdWindow.isBarMode
                anchors.verticalCenter: parent.verticalCenter
                width: 115
                height: 6
                radius: 3
                color: Theme.cardAlt

                Rectangle {
                    anchors {
                        left: parent.left
                        top: parent.top
                        bottom: parent.bottom
                    }
                    width: parent.width * (osdWindow.isMuted ? 0 : Math.min(100, Math.max(0, osdWindow.currentValue)) / 100.0)
                    radius: 3
                    color: osdWindow.osdAccentColor()

                    Behavior on width {
                        NumberAnimation { duration: 90; easing.type: Easing.OutCubic }
                    }
                    Behavior on color {
                        ColorAnimation { duration: 120 }
                    }
                }
            }

            Text {
                anchors.verticalCenter: parent.verticalCenter
                width: osdWindow.isBarMode ? 34 : implicitWidth
                horizontalAlignment: osdWindow.isBarMode ? Text.AlignRight : Text.AlignHCenter
                text: osdWindow.osdLabelText()
                color: osdWindow.isBarMode ? Theme.text : osdWindow.osdAccentColor()
                font.family: Theme.fontFamily
                font.pixelSize: osdWindow.isBarMode ? 11 : 12
                font.bold: true
                font.letterSpacing: osdWindow.isBarMode ? 0 : 0.8
            }
        }
    }
}
</file>

<file path="config/quickshell/.config/quickshell/widgets/wallpaper/WallpaperPicker.qml">
import QtQuick
import QtQuick.Effects
import Quickshell
import Quickshell.Io
import Quickshell.Wayland
import "../../services"

PanelWindow {
    id: pickerWindow

    anchors {
        top: true
        bottom: true
        left: true
        right: true
    }

    color: "transparent"
    visible: isOpen
    exclusionMode: ExclusionMode.Ignore
    mask: isOpen ? null : emptyRegion

    WlrLayershell.layer: WlrLayer.Overlay
    WlrLayershell.namespace: "quickshell-wallpaper"
    WlrLayershell.keyboardFocus: isOpen ? WlrKeyboardFocus.Exclusive : WlrKeyboardFocus.None

    readonly property string home: Quickshell.env("HOME")
    readonly property string wallpaperDir: home + "/Pictures/Wallpapers"
    readonly property string setScript: home + "/Projects/arch-niri/scripts/set-wallpaper"

    readonly property real cardWidth: 260
    readonly property real cardHeight: 156
    readonly property real centerScale: 1.12
    readonly property real sideScale: 0.85
    readonly property real cardSpacing: 26
    readonly property real targetWidth: (cardWidth * 3) + (cardSpacing * 2) + 56
    readonly property real targetHeight: (cardHeight * centerScale) + 44
    readonly property real orbSize: 22

    property bool isOpen: false
    property bool expanded: false
    property var wallpapers: []
    property int currentIndex: 0

    onIsOpenChanged: {
        Niri.notifyLauncherState(isOpen);
    }

    Region { id: emptyRegion }

    Process {
        id: scanProc
        command: [
            "bash", "-c",
            "mkdir -p \"$1\" && find -L \"$1\" -maxdepth 2 -type f " +
            "\\( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' -o -iname '*.avif' \\) " +
            "| sort -V",
            "bash", pickerWindow.wallpaperDir
        ]
        stdout: StdioCollector {
            onStreamFinished: {
                const lines = this.text.trim().split("\n").filter(l => l.length > 0);
                pickerWindow.wallpapers = lines;

                const cur = LockState.currentWallpaper;
                const idx = lines.indexOf(cur);
                if (idx >= 0) {
                    pickerWindow.currentIndex = idx;
                } else if (pickerWindow.currentIndex >= lines.length) {
                    pickerWindow.currentIndex = 0;
                }
                carouselView.positionViewAtIndex(pickerWindow.currentIndex, PathView.Center);
            }
        }
    }

    Process {
        id: applyProc
    }

    function openPicker() {
        if (pickerWindow.isOpen) return;
        scanProc.running = true;
        pickerWindow.expanded = false;
        pickerWindow.isOpen = true;
        openAnim.restart();
        keyHandler.forceActiveFocus();
    }

    function closePicker() {
        if (!pickerWindow.isOpen) return;
        openAnim.stop();
        closeAnim.restart();
    }

    function move(delta) {
        if (wallpapers.length === 0) return;
        if (delta < 0) carouselView.decrementCurrentIndex();
        else if (delta > 0) carouselView.incrementCurrentIndex();
    }

    function applySelected() {
        if (wallpapers.length === 0) return;
        const selected = wallpapers[carouselView.currentIndex];
        if (!selected) return;

        pickerWindow.currentIndex = carouselView.currentIndex;
        LockState.currentWallpaper = selected;
        applyProc.running = false;
        applyProc.command = ["bash", pickerWindow.setScript, selected];
        applyProc.running = true;
        closePicker();
    }

    IpcHandler {
        target: "wallpaper"
        function toggle(): void {
            if (!pickerWindow.isOpen) {
                pickerWindow.openPicker();
            } else {
                pickerWindow.closePicker();
            }
        }
    }

    SequentialAnimation {
        id: openAnim

        ScriptAction {
            script: {
                morphBox.width = 16;
                morphBox.height = 54;
                morphBox.radius = 8;
                morphBox.motionBlur = 0.85;
                morphBox.centerOffsetY = (pickerWindow.height / 2) + 40;
                morphBox.boxOpacity = 0.0;
                pickerWindow.expanded = false;
            }
        }

        ParallelAnimation {
            NumberAnimation { target: morphBox; property: "centerOffsetY"; to: 0; duration: 210; easing.type: Easing.OutCubic }
            NumberAnimation { target: morphBox; property: "boxOpacity"; to: 1.0; duration: 110; easing.type: Easing.OutQuad }
            NumberAnimation { target: morphBox; property: "width"; to: pickerWindow.orbSize; duration: 210; easing.type: Easing.OutBack }
            NumberAnimation { target: morphBox; property: "height"; to: pickerWindow.orbSize; duration: 210; easing.type: Easing.OutBack }
            NumberAnimation { target: morphBox; property: "radius"; to: pickerWindow.orbSize / 2; duration: 210; easing.type: Easing.OutCubic }
            NumberAnimation { target: morphBox; property: "motionBlur"; to: 0.0; duration: 200; easing.type: Easing.OutQuad }
        }

        ParallelAnimation {
            NumberAnimation { target: morphBox; property: "width"; to: pickerWindow.targetWidth; duration: 230; easing.type: Easing.OutExpo }
            NumberAnimation { target: morphBox; property: "height"; to: pickerWindow.targetHeight; duration: 230; easing.type: Easing.OutExpo }
            NumberAnimation { target: morphBox; property: "radius"; to: 18; duration: 210; easing.type: Easing.OutCubic }
        }

        ScriptAction {
            script: {
                pickerWindow.expanded = true;
                keyHandler.forceActiveFocus();
            }
        }
    }

    SequentialAnimation {
        id: closeAnim

        ScriptAction {
            script: pickerWindow.expanded = false
        }

        ParallelAnimation {
            NumberAnimation { target: morphBox; property: "width"; to: pickerWindow.orbSize; duration: 160; easing.type: Easing.InCubic }
            NumberAnimation { target: morphBox; property: "height"; to: pickerWindow.orbSize; duration: 160; easing.type: Easing.InCubic }
            NumberAnimation { target: morphBox; property: "radius"; to: pickerWindow.orbSize / 2; duration: 160; easing.type: Easing.InCubic }
        }

        ParallelAnimation {
            NumberAnimation { target: morphBox; property: "centerOffsetY"; to: (pickerWindow.height / 2) + 40; duration: 190; easing.type: Easing.InCubic }
            NumberAnimation { target: morphBox; property: "width"; to: 16; duration: 190; easing.type: Easing.InCubic }
            NumberAnimation { target: morphBox; property: "height"; to: 54; duration: 190; easing.type: Easing.InCubic }
            NumberAnimation { target: morphBox; property: "radius"; to: 8; duration: 190 }
            NumberAnimation { target: morphBox; property: "motionBlur"; to: 0.85; duration: 170; easing.type: Easing.InQuad }
            NumberAnimation { target: morphBox; property: "boxOpacity"; to: 0.0; duration: 180; easing.type: Easing.InQuad }
        }

        ScriptAction {
            script: {
                morphBox.motionBlur = 0.0;
                pickerWindow.isOpen = false;
                pickerWindow.wallpapers = [];
            }
        }
    }

    MouseArea {
        anchors.fill: parent
        enabled: pickerWindow.isOpen
        onClicked: pickerWindow.closePicker()
    }

    Rectangle {
        id: morphBox

        property real centerOffsetY: 0
        property real boxOpacity: 0
        property real motionBlur: 0

        anchors.horizontalCenter: parent.horizontalCenter
        anchors.verticalCenter: parent.verticalCenter
        anchors.verticalCenterOffset: centerOffsetY

        width: pickerWindow.orbSize
        height: pickerWindow.orbSize
        radius: pickerWindow.orbSize / 2
        opacity: boxOpacity
        visible: pickerWindow.isOpen && boxOpacity > 0.01

        color: pickerWindow.expanded ? Theme.bg : Theme.accent
        border.width: 2
        border.color: Theme.accent
        clip: true

        layer.enabled: motionBlur > 0.01
        layer.effect: MultiEffect {
            blurEnabled: true
            blurMax: 28
            blur: morphBox.motionBlur
            autoPaddingEnabled: true
        }

        Behavior on color { ColorAnimation { duration: 160 } }

        MouseArea {
            anchors.fill: parent
        }

        Item {
            id: keyHandler
            anchors.fill: parent
            focus: pickerWindow.isOpen

            Keys.onLeftPressed: pickerWindow.move(-1)
            Keys.onRightPressed: pickerWindow.move(1)
            Keys.onPressed: event => {
                if (event.key === Qt.Key_H) {
                    pickerWindow.move(-1);
                    event.accepted = true;
                } else if (event.key === Qt.Key_L) {
                    pickerWindow.move(1);
                    event.accepted = true;
                } else if (event.key === Qt.Key_Return || event.key === Qt.Key_Enter) {
                    pickerWindow.applySelected();
                    event.accepted = true;
                } else if (event.key === Qt.Key_Escape) {
                    pickerWindow.closePicker();
                    event.accepted = true;
                }
            }
        }

        PathView {
            id: carouselView
            anchors.fill: parent
            visible: pickerWindow.expanded && pickerWindow.wallpapers.length > 0
            opacity: pickerWindow.expanded ? 1.0 : 0.0
            clip: true

            model: pickerWindow.wallpapers
            currentIndex: pickerWindow.currentIndex
            onCurrentIndexChanged: pickerWindow.currentIndex = currentIndex

            pathItemCount: Math.min(5, Math.max(1, pickerWindow.wallpapers.length))
            preferredHighlightBegin: 0.5
            preferredHighlightEnd: 0.5
            highlightRangeMode: PathView.StrictlyEnforceRange
            highlightMoveDuration: 260
            snapMode: PathView.SnapToItem
            interactive: true
            dragMargin: height

            readonly property real stepX: pickerWindow.cardWidth + pickerWindow.cardSpacing
            readonly property real spanX: stepX * (pathItemCount / 2.0)

            Behavior on opacity {
                NumberAnimation { duration: 150; easing.type: Easing.OutCubic }
            }

            WheelHandler {
                acceptedDevices: PointerDevice.Mouse | PointerDevice.TouchPad
                onWheel: event => {
                    const delta = Math.abs(event.angleDelta.x) > Math.abs(event.angleDelta.y)
                        ? event.angleDelta.x
                        : event.angleDelta.y;
                    if (delta > 0) carouselView.decrementCurrentIndex();
                    else if (delta < 0) carouselView.incrementCurrentIndex();
                }
            }

            path: Path {
                startX: (carouselView.width / 2) - carouselView.spanX
                startY: carouselView.height / 2

                PathAttribute { name: "cardScale"; value: 0.72 }
                PathAttribute { name: "cardOpacity"; value: 0.0 }
                PathAttribute { name: "cardZ"; value: 0 }

                PathLine { x: (carouselView.width / 2) - carouselView.stepX; y: carouselView.height / 2 }
                PathAttribute { name: "cardScale"; value: pickerWindow.sideScale }
                PathAttribute { name: "cardOpacity"; value: 0.55 }
                PathAttribute { name: "cardZ"; value: 1 }

                PathLine { x: carouselView.width / 2; y: carouselView.height / 2 }
                PathAttribute { name: "cardScale"; value: pickerWindow.centerScale }
                PathAttribute { name: "cardOpacity"; value: 1.0 }
                PathAttribute { name: "cardZ"; value: 3 }

                PathLine { x: (carouselView.width / 2) + carouselView.stepX; y: carouselView.height / 2 }
                PathAttribute { name: "cardScale"; value: pickerWindow.sideScale }
                PathAttribute { name: "cardOpacity"; value: 0.55 }
                PathAttribute { name: "cardZ"; value: 1 }

                PathLine { x: (carouselView.width / 2) + carouselView.spanX; y: carouselView.height / 2 }
                PathAttribute { name: "cardScale"; value: 0.72 }
                PathAttribute { name: "cardOpacity"; value: 0.0 }
                PathAttribute { name: "cardZ"; value: 0 }
            }

            delegate: Item {
                id: cardDelegate
                required property string modelData
                required property int index

                readonly property bool isCenter: PathView.isCurrentItem
                readonly property real vScale: PathView.cardScale !== undefined ? PathView.cardScale : pickerWindow.sideScale
                readonly property real vOpacity: PathView.cardOpacity !== undefined ? PathView.cardOpacity : 0.55

                width: pickerWindow.cardWidth
                height: pickerWindow.cardHeight
                scale: vScale
                opacity: vOpacity
                z: PathView.cardZ !== undefined ? PathView.cardZ : 1

                Rectangle {
                    anchors.fill: parent
                    radius: 14
                    color: Theme.card
                }

                Image {
                    id: thumb
                    anchors.fill: parent
                    anchors.margins: 2
                    visible: false
                    source: cardDelegate.modelData !== "" ? "file://" + cardDelegate.modelData : ""
                    fillMode: Image.PreserveAspectCrop
                    asynchronous: true
                    cache: false
                    sourceSize.width: 520
                    sourceSize.height: 312
                }

                Rectangle {
                    id: roundMask
                    anchors.fill: thumb
                    radius: 12
                    visible: false
                    layer.enabled: true
                }

                MultiEffect {
                    anchors.fill: thumb
                    source: thumb
                    visible: thumb.status === Image.Ready
                    maskEnabled: true
                    maskSource: roundMask
                    maskThresholdMin: 0.5
                    maskSpreadAtMin: 1.0
                }

                Rectangle {
                    anchors.fill: parent
                    radius: 14
                    color: "transparent"
                    border.width: cardDelegate.isCenter ? 2 : 1
                    border.color: cardDelegate.isCenter ? Theme.accent : Theme.border

                    Behavior on border.color {
                        ColorAnimation { duration: 150 }
                    }
                }

                MouseArea {
                    anchors.fill: parent
                    cursorShape: Qt.PointingHandCursor
                    onClicked: {
                        if (cardDelegate.isCenter) {
                            pickerWindow.applySelected();
                        } else {
                            carouselView.currentIndex = cardDelegate.index;
                        }
                    }
                }
            }
        }
    }
}
