alias gds='git diff --staged'
alias gl="git log --graph --pretty=format:'%C(auto)%h%d %s %C(dim)%an, %ar' -20"
alias gla="git log --graph --all --pretty=format:'%C(auto)%h%d %s %C(dim)%an, %ar'"
alias gp='git push'
alias gpf='git push --force-with-lease'
alias gpl='git pull --rebase --autostash'
alias gf='git fetch --all --prune'
alias gst='git stash'
alias gstp='git stash pop'
alias grb='git rebase'
alias gcp='git cherry-pick'
alias gundo='git reset --soft HEAD~1'      # deshace el último commit conservando los cambios

# Añadir todo y commitear:  gac "mensaje"      (gacp además hace push)
gac()  { git add -A && git commit -m "$*"; }
gacp() { git add -A && git commit -m "$*" && git push; }

# Ir a la raíz del repo
groot() { cd "$(git rev-parse --show-toplevel)" || return; }

# Clonar y entrar:  gcl https://github.com/usuario/repo.git
gcl() {
  git clone "$@" || return
  local d="${${@[-1]:t}%.git}"
  [[ -d $d ]] && cd "$d"
}

# Borra las ramas locales ya fusionadas (salvo main/master/develop)
gbclean() {
  git branch --merged | grep -vE '^\*|^\s*(main|master|develop)$' | xargs -r git branch -d
}

if (( $+commands[fzf] )); then
  # Cambiar de rama con vista previa del historial
  gcb() {
    local b
    b=$(git for-each-ref --format='%(refname:short)' refs/heads refs/remotes | grep -v '/HEAD$' \
        | fzf --prompt='rama ❯ ' --preview 'git log --oneline --graph --color=always -20 {}') || return
    git switch "${b#origin/}"
  }
  # Explorar el historial (Enter abre el commit)
  glf() {
    git log --oneline --color=always --decorate \
      | fzf --ansi --no-sort --reverse --prompt='commit ❯ ' \
            --preview 'git show --color=always {1}' \
            --bind 'enter:execute(git show --color=always {1} | less -R)'
  }
  # Elegir qué archivos añadir (Tab = varios)
  gaf() {
    git -c color.status=always status --short \
      | fzf -m --ansi --prompt='add ❯ ' --preview 'git diff --color=always -- {2}' \
      | awk '{print $2}' | xargs -r git add
    git status -sb
  }
fi
</file>

<file path="config/zsh/.config/zsh/conf.d/60-functions.zsh">
# ── 60-functions ──────────────────────────────────────────────────────────────

mkcd() { mkdir -p -- "$1" && cd -- "$1"; }                 # crea la carpeta y entra
up()   { local p=; repeat ${1:-1} p+=../; cd "${p:-.}"; }   # up 3 = cd ../../..
backup() { cp -a -- "$1" "$1.bak-$(date +%F-%H%M%S)"; }
serve()  { python -m http.server "${1:-8000}"; }            # sirve la carpeta actual
ports()  { ss -tulpn; }                                     # puertos en escucha
path()   { print -l $path; }                                # PATH, uno por línea
wttr()   { curl -s "wttr.in/${1:-}?format=3"; }
ztime()  { local i; for i in 1 2 3; do ( time zsh -i -c exit ) 2>&1 | grep total; done; }   # tiempo de arranque

# Descomprime casi cualquier cosa:  extract archivo.tar.gz otro.zip
extract() {
  (( $# )) || { print -u2 "uso: extract <archivo>..."; return 1; }
  local f
  for f in "$@"; do
    [[ -f $f ]] || { print -u2 "extract: no existe: $f"; continue; }
    if (( $+commands[ouch] )); then ouch decompress "$f"; continue; fi
    case ${f:l} in
      *.tar.gz|*.tgz)   tar xzf "$f" ;;
      *.tar.bz2|*.tbz2) tar xjf "$f" ;;
      *.tar.xz|*.txz)   tar xJf "$f" ;;
      *.tar.zst)        tar --zstd -xf "$f" ;;
      *.tar)            tar xf "$f" ;;
      *.zip)            unzip "$f" ;;
      *.7z)             7z x "$f" ;;
      *.rar)            unrar x "$f" ;;
      *.gz)             gunzip -k "$f" ;;
      *.bz2)            bunzip2 -k "$f" ;;
      *.xz)             unxz -k "$f" ;;
      *.zst)            unzstd "$f" ;;
      *) print -u2 "extract: formato no soportado: $f" ;;
    esac
  done
}

if (( $+commands[yazi] )); then
  y() {
    local tmp cwd
    tmp="$(mktemp -t yazi-cwd.XXXXXX)"
    command yazi "$@" --cwd-file="$tmp"
    IFS= read -r -d '' cwd < "$tmp"
    [[ -n $cwd && $cwd != $PWD && -d $cwd ]] && builtin cd -- "$cwd"
    rm -f -- "$tmp"
  }
  alias yazi='y'
fi

# Paleta ANSI del terminal (para ver el tema activo de Aether)
colors() {
  local i
  for i in {0..15}; do
    printf '\e[48;5;%sm %3s \e[0m' $i $i
    (( i == 7 || i == 15 )) && printf '\n'
  done
}

# Cambiar de tema de Aether:  theme  (elige con fzf)   |   theme <nombre>
theme() {
  local s="$DOTFILES/scripts" t=$1
  if [[ -z $t ]]; then
    (( $+commands[fzf] )) || { print -u2 "uso: theme <nombre>"; return 1; }
    t=$(bash "$s/list-themes.sh" | awk -F'\t' '!/^#ACTIVE/ {print $1}' \
        | fzf --prompt='tema ❯ ' --header "activo: $(cat ~/.config/aether/theme/.active-theme 2>/dev/null)") || return
  fi
  bash "$s/switch-theme.sh" "$t"
}
_theme() { compadd -- ${(f)"$(ls ~/.config/aether/themes 2>/dev/null)"}; }
compdef _theme theme

if (( $+commands[fzf] )); then
  _fd_dirs() { if (( $+commands[fd] )); then fd --type d --hidden --exclude .git "$@"; else find "${1:-.}" -type d -not -path '*/.git/*'; fi }
  _fd_files() { if (( $+commands[fd] )); then fd --type f --hidden --exclude .git "$@"; else find "${1:-.}" -type f -not -path '*/.git/*'; fi }

  # Entrar a una carpeta buscándola con fzf
  fcd() {
    local d
    d=$(_fd_dirs ${1:-.} | fzf --prompt='cd ❯ ' --preview 'eza --tree --level=2 --icons=auto --color=always {} 2>/dev/null') && cd -- "$d"
  }
  # Abrir archivos en $EDITOR buscándolos con fzf (Tab = varios)
  fe() {
    local prev='head -n 200 {}' ; local -a f
    (( $+commands[bat] )) && prev='bat --color=always --style=numbers --line-range=:200 {}'
    f=("${(@f)$(_fd_files ${1:-.} | fzf -m --prompt='editar ❯ ' --preview "$prev")}")
    [[ -n $f[1] ]] && ${EDITOR:-nvim} "${f[@]}"
  }
  # Buscar texto con ripgrep y abrir el resultado en nvim en esa línea:  rgf patrón
  if (( $+commands[rg] )); then
    rgf() {
      rg --line-number --no-heading --color=always --smart-case "$@" \
        | fzf --ansi --delimiter : --prompt='rg ❯ ' \
              --preview 'bat --color=always --highlight-line {2} {1}' \
              --preview-window='right,60%,+{2}+3/3' \
              --bind 'enter:become(${EDITOR:-nvim} {1} +{2})'
    }
  fi
  # Matar procesos eligiéndolos (Tab = varios):  fkill [señal]
  fkill() {
    local pids
    pids=$(ps -u "$USER" -o pid=,comm=,args= | fzf -m --prompt='kill ❯ ' | awk '{print $1}') || return
    [[ -n $pids ]] && print -l $pids | xargs kill -"${1:-15}"
  }
fi

# Instalar / desinstalar paquetes con fzf (Tab = varios)
pacs() {
  local helper='sudo pacman'; (( $+commands[yay] )) && helper='yay'
  local -a sel
  sel=("${(@f)$( { (( $+commands[yay] )) && yay -Slq || pacman -Slq; } 2>/dev/null | sort -u \
      | fzf -m --prompt='instalar ❯ ' --preview 'pacman -Si {1} 2>/dev/null || yay -Si {1} 2>/dev/null')}")
  [[ -n $sel[1] ]] && ${=helper} -S --needed "${sel[@]}"
}
pacr() {
  pacman -Qq | fzf -m --prompt='quitar ❯ ' --preview 'pacman -Qi {1}' | xargs -ro sudo pacman -Rns
}
</file>

<file path="config/zsh/.config/zsh/conf.d/70-prompt.zsh">
# ── 70-prompt ─────────────────────────────────────────────────────────────────
#  ┌─ usuario@equipo │ ~/carpeta │  rama ⇡1 +2 !3 ?1 │ venv
#  └─ ❯                                              ✘ 127  󰔟 12s  14:32
#
# - Los colores son índices de la paleta ANSI del terminal: cambian solos con el tema de Aether.
# - Git: UNA sola llamada (`git status --porcelain=v2 --branch`) por prompt.
#     ⇡/⇣ commits por enviar/recibir · = conflictos · + preparados (staged) · ! modificados · ? sin seguimiento · ✔ limpio
# - El prompt se construye como texto fijo (sin PROMPT_SUBST): un nombre de rama con `$(...)` no puede ejecutar nada.
# - Ajustes (ponlos en ~/.config/zsh/local.zsh):
#     PROMPT_GIT=0              desactiva la info de git (repos enormes)
#     PROMPT_SPACING=0          sin línea en blanco entre prompts
#     PROMPT_DURATION_MIN=3     segundos a partir de los cuales se muestra la duración
#     PROMPT_C_USER/HOST/DIR/GIT/SEP = índice de color 0-15

autoload -Uz add-zsh-hook
zmodload zsh/datetime 2>/dev/null     # EPOCHREALTIME

: ${PROMPT_GIT:=1}
: ${PROMPT_SPACING:=1}
: ${PROMPT_DURATION_MIN:=3}
: ${PROMPT_C_USER:=4}
: ${PROMPT_C_HOST:=5}
: ${PROMPT_C_DIR:=6}
: ${PROMPT_C_GIT:=5}
: ${PROMPT_C_SEP:=8}

typeset -g _p_rc=0 _p_start= _p_seen= _p_git= _p_dur=

# Debe ser el PRIMER precmd: guarda el código de salida del comando anterior
_prompt_capture() { _p_rc=$?; }
_prompt_preexec() { _p_start=$EPOCHREALTIME; }

# Escapa % para que el texto dinámico no se interprete como secuencia del prompt
_p_esc() { REPLY=${1//\%/%%}; }

_prompt_git() {
  _p_git=
  [[ $PROMPT_GIT == 1 ]] || return
  local out
  out=$(command git --no-optional-locks status --porcelain=v2 --branch 2>/dev/null) || return

  local line oid= branch= ab
  local -i ahead=0 behind=0 staged=0 changed=0 untracked=0 conflicts=0
  for line in "${(@f)out}"; do
    case $line in
      '# branch.oid '*)  oid=${line#'# branch.oid '} ;;
      '# branch.head '*) branch=${line#'# branch.head '} ;;
      '# branch.ab '*)   ab=(${=${line#'# branch.ab '}}); ahead=${ab[1]#+}; behind=${ab[2]#-} ;;
      '1 '*|'2 '*)       [[ ${line[3]} != . ]] && (( staged++ )); [[ ${line[4]} != . ]] && (( changed++ )) ;;
      'u '*)             (( conflicts++ )) ;;
      '? '*)             (( untracked++ )) ;;
    esac
  done
  [[ $branch == '(detached)' ]] && branch="${oid[1,7]}"
  _p_esc "$branch"; branch=$REPLY

  local g=" %F{$PROMPT_C_SEP}│%f %F{$PROMPT_C_GIT}"$''" ${branch}%f"
  (( ahead ))     && g+=" %F{2}⇡${ahead}%f"
  (( behind ))    && g+=" %F{1}⇣${behind}%f"
  (( conflicts )) && g+=" %F{1}=${conflicts}%f"
  (( staged ))    && g+=" %F{2}+${staged}%f"
  (( changed ))   && g+=" %F{3}!${changed}%f"
  (( untracked )) && g+=" %F{6}?${untracked}%f"
  (( !conflicts && !staged && !changed && !untracked )) && g+=" %F{2}✔%f"
  _p_git=$g
}

_prompt_precmd() {
  # Duración del último comando
  _p_dur=
  if [[ -n $_p_start ]]; then
    local -F d=$(( EPOCHREALTIME - _p_start )); _p_start=
    if (( d >= PROMPT_DURATION_MIN )); then
      local -i s=$d
      if   (( s >= 3600 )); then _p_dur="$(( s/3600 ))h$(( s%3600/60 ))m"
      elif (( s >= 60 ));   then _p_dur="$(( s/60 ))m$(( s%60 ))s"
      else                       _p_dur="${s}s"
      fi
    fi
  fi

  _prompt_git

  # Segmentos opcionales
  local extra=
  local venv=${VIRTUAL_ENV:t}; [[ -z $venv ]] && venv=$CONDA_DEFAULT_ENV
  if [[ -n $venv ]]; then _p_esc "$venv"; extra+=" %F{$PROMPT_C_SEP}│%f %F{3}${REPLY}%f"; fi
  [[ -n $SSH_CONNECTION ]] && extra+=" %F{$PROMPT_C_SEP}│%f %F{1}ssh%f"

  local arrow user
  if (( _p_rc == 0 )); then arrow="%F{$PROMPT_C_USER}"; else arrow='%F{1}'; fi
  user="%(!.%F{1}.%F{$PROMPT_C_USER})%n%F{$PROMPT_C_SEP}@%F{$PROMPT_C_HOST}%m%f"

  PROMPT="%F{$PROMPT_C_SEP}┌─%f ${user} %F{$PROMPT_C_SEP}│%f %F{$PROMPT_C_DIR}%(5~|%-1~/…/%3~|%~)%f${_p_git}${extra}"$'\n'"%F{$PROMPT_C_SEP}└─%f ${arrow}%(!.#.❯)%f "

  # Derecha (en la línea de ❯): error · duración · trabajos en segundo plano · hora
  local r=
  (( _p_rc != 0 )) && r+="%F{1}✘ ${_p_rc}%f  "
  [[ -n $_p_dur ]] && r+="%F{3}"$''" ${_p_dur}%f  "
  r+="%(1j.%F{6}✦%j%f  .)%F{$PROMPT_C_SEP}%T%f"
  RPROMPT=$r

  # Línea en blanco entre prompts (no antes del primero)
  [[ $PROMPT_SPACING == 1 && -n $_p_seen ]] && print
  _p_seen=1
}

PROMPT2="%F{$PROMPT_C_SEP}  ∙%f "
ZLE_RPROMPT_INDENT=0
setopt TRANSIENT_RPROMPT            # la hora/duración desaparecen del historial de pantalla

add-zsh-hook preexec _prompt_preexec
add-zsh-hook precmd  _prompt_precmd
precmd_functions=(_prompt_capture ${precmd_functions:#_prompt_capture})
</file>

