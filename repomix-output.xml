<file path="config/mpv/.config/mpv/mpv.conf">
include=/home/nobelc/.config/mpv/aether.conf
# ~/.config/mpv/mpv.conf
# mpv al máximo en Arch Linux (uosc + thumbfast como interfaz)

# --- Base de render ---
# NOTA: se eliminó "profile=gpu-hq" (obsoleto en mpv recientes); todo está explícito abajo.
vo=gpu-next
gpu-api=vulkan
gpu-context=auto
# Si Vulkan da problemas en tu GPU: gpu-api=opengl  (o vo=gpu)

# --- Interfaz (uosc reemplaza al OSC por defecto) ---
osc=no
osd-bar=no
border=no

# --- Decodificación ---
hwdec=auto-safe
hwdec-codecs=all
vd-lavc-dr=yes

# --- Comportamiento general ---
keep-open=yes
save-position-on-quit=yes
watch-later-directory=~/.cache/mpv/watch_later
autofit-larger=90%x90%
force-window=immediate
cursor-autohide=1000
osd-duration=1500
osd-font-size=32
terminal=yes
icc-profile-auto=yes

# --- Idiomas preferidos ---
alang=spa,es,eng,en,jpn,ja
slang=spa,es,eng,en

# --- Caché ---
cache=yes
demuxer-max-bytes=1024M
demuxer-max-back-bytes=256M
cache-secs=120
prefetch-playlist=yes

# --- Vídeo: máxima calidad de escalado ---
scale=ewa_lanczossharp
cscale=ewa_lanczossharp
dscale=mitchell
scale-antiring=0.6
cscale-antiring=0.6
correct-downscaling=yes
linear-downscaling=yes
sigmoid-upscaling=yes
dither-depth=auto
dither=fruit
temporal-dither=no
blend-subtitles=yes

# --- Movimiento suave (efecto "soap opera": pulsa z para desactivar) ---
video-sync=display-resample
interpolation=yes
tscale=oversample

# --- Color / HDR ---
target-prim=auto
target-trc=auto
tone-mapping=auto
hdr-compute-peak=auto
# Monitor HDR real: descomenta
# target-colorspace-hint=yes

# --- Audio ---
volume=100
volume-max=150
audio-pitch-correction=yes
audio-normalize-downmix=yes
audio-channels=auto-safe
audio-file-auto=fuzzy
# Receptor AV con passthrough:
# audio-spdif=ac3,dts,dtshd,eac3,truehd

# --- Subtítulos ---
sub-auto=fuzzy
sub-file-paths=~/Subtitles
sub-font-size=48
sub-color="#FFFFFF"
sub-border-color="#000000"
sub-border-size=2.0
sub-shadow-offset=0.5
sub-use-margins=yes
sub-ass-force-margins=yes
sub-ass-use-video-data=all
demuxer-mkv-subtitle-preroll=yes

# --- Capturas ---
screenshot-directory=~/Pictures/mpv-screenshots
screenshot-format=png
screenshot-high-bit-depth=yes
screenshot-template="%f-%n"

# --- Streaming / yt-dlp ---
ytdl-format=bestvideo+bestaudio/best
# Limitar a 4K si va pesado:
# ytdl-format=bestvideo[height<=?2160]+bestaudio/best

# --- Perfiles automáticos por tipo de archivo ---
[extension.gif]
loop-file=inf
profile-restore=copy

[extension.png]
loop-file=inf
video-sync=audio
interpolation=no

[extension.jpg]
loop-file=inf
video-sync=audio
interpolation=no

[extension.webp]
loop-file=inf
video-sync=audio
interpolation=no

# --- Perfiles manuales (F1-F4) ---

[high-quality]
profile-desc=Calidad máxima
hwdec=auto-safe
hwdec-codecs=all
scale=ewa_lanczossharp
cscale=ewa_lanczossharp
dscale=mitchell
correct-downscaling=yes
linear-downscaling=yes
sigmoid-upscaling=yes
video-sync=display-resample
interpolation=yes
tscale=oversample
deband=no
temporal-dither=no

[fast]
profile-desc=Rendimiento alto, calidad menor
hwdec=auto-safe
hwdec-codecs=all
scale=bilinear
cscale=bilinear
dscale=bilinear
correct-downscaling=no
linear-downscaling=no
sigmoid-upscaling=no
video-sync=audio
interpolation=no
deband=no

[anime]
profile-desc=Calidad alta + deband para anime/animación
hwdec=auto-safe
hwdec-codecs=all
scale=ewa_lanczossharp
cscale=ewa_lanczossharp
dscale=mitchell
correct-downscaling=yes
linear-downscaling=yes
sigmoid-upscaling=yes
video-sync=display-resample
interpolation=yes
tscale=oversample
deband=yes
deband-iterations=2
deband-threshold=35
deband-range=16
deband-grain=5

[hdr-to-sdr]
