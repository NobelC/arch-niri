<file path="config/quickshell/.config/quickshell/widgets/ribbon/RibbonDock.qml">
import QtQuick
import Quickshell
import "../../services"
import "."

PanelWindow {
    id: dockWindow

    anchors {
        bottom: true
        left: true
        right: true
    }

    exclusionMode: ExclusionMode.Ignore
    color: "transparent"

    readonly property int dockHeight: 42
    readonly property int topRadius: 12
    readonly property int scoopRadius: 7
    readonly property int horizontalPadding: 18
    readonly property int bodyWidth: Math.max(84, iconsRow.implicitWidth + horizontalPadding * 2)
    readonly property int totalWidth: bodyWidth + (scoopRadius * 2)

    implicitHeight: dockHeight + 6
    visible: true

    property bool isShown: false

    Timer {
        id: hideTimer
        interval: 1400
        onTriggered: {
            if (!hoverArea.containsMouse) {
                dockWindow.isShown = false;
            }
        }
    }

    Connections {
        target: Niri

        function onOverviewOpenChanged() {
            if (Niri.overviewOpen) {
                hideTimer.stop();
                dockWindow.isShown = false;
            }
        }

        function onLauncherOpenChanged() {
            if (Niri.launcherOpen) {
                hideTimer.stop();
                dockWindow.isShown = false;
            }
        }

        function onRibbonActivity() {
            if (Niri.launcherOpen || Niri.suppressDock || Niri.overviewOpen) {
                dockWindow.isShown = false;
                return;
            }

            if (Niri.activeRibbonWindows.length > 0) {
                dockWindow.isShown = true;
                hideTimer.restart();
            } else {
                dockWindow.isShown = false;
            }
        }

        function onActiveRibbonWindowsChanged() {
            if (Niri.activeRibbonWindows.length === 0) {
                dockWindow.isShown = false;
            }
        }
    }

    Connections {
        target: Theme
        function onBgChanged() { bgCanvas.requestPaint(); }
        function onCardAltChanged() { bgCanvas.requestPaint(); }
    }

    Item {
        id: dockContainer
        width: dockWindow.totalWidth
        height: dockWindow.dockHeight
        anchors.horizontalCenter: parent.horizontalCenter

        y: dockWindow.isShown ? (parent.height - height) : parent.height

        Behavior on y {
            NumberAnimation {
                id: slideAnim
                duration: 220
                easing.type: Easing.OutCubic
            }
        }

        Behavior on width {
            NumberAnimation { duration: 180; easing.type: Easing.OutCubic }
        }

        onWidthChanged: bgCanvas.requestPaint()
        onHeightChanged: bgCanvas.requestPaint()

        Canvas {
            id: bgCanvas
            anchors.fill: parent
            antialiasing: true

            onPaint: {
                const ctx = getContext("2d");
                ctx.reset();

                const w = width;
                const h = height;
                const rTop = dockWindow.topRadius;
                const rBot = dockWindow.scoopRadius;

                ctx.beginPath();
                ctx.moveTo(0, h);
                ctx.quadraticCurveTo(rBot, h, rBot, h - rBot);
                ctx.lineTo(rBot, rTop);
                ctx.quadraticCurveTo(rBot, 0, rBot + rTop, 0);
                ctx.lineTo(w - rBot - rTop, 0);
                ctx.quadraticCurveTo(w - rBot, 0, w - rBot, rTop);
                ctx.lineTo(w - rBot, h - rBot);
                ctx.quadraticCurveTo(w - rBot, h, w, h);
                ctx.closePath();

                ctx.fillStyle = Theme.bg.toString();
                ctx.fill();

                ctx.strokeStyle = Theme.cardAlt.toString();
                ctx.lineWidth = 1;
                ctx.stroke();
            }
        }

        Row {
            id: iconsRow
            anchors.centerIn: parent
            anchors.verticalCenterOffset: 2
            spacing: 12

            Repeater {
                model: Niri.activeRibbonWindows

                delegate: Item {
                    width: 28
                    height: 28

                    readonly property bool isFocused: modelData.is_focused

                    Rectangle {
                        anchors.fill: parent
                        radius: 8
                        color: isFocused ? Theme.cardAlt : "transparent"
                        border.width: isFocused ? 1 : 0
                        border.color: Theme.accentSoft

                        Behavior on color { ColorAnimation { duration: 150 } }
                        Behavior on border.color { ColorAnimation { duration: 150 } }
                    }

                    Text {
                        anchors.centerIn: parent
                        text: AppGlyphs.resolve(modelData.app_id, modelData.title)
                        color: isFocused ? Theme.accentSoft : Theme.sub
                        font.family: Theme.fontFamily
                        font.pixelSize: 16

                        Behavior on color { ColorAnimation { duration: 150 } }
                    }

                    MouseArea {
                        anchors.fill: parent
                        enabled: dockWindow.isShown
                        cursorShape: Qt.PointingHandCursor
                        onClicked: Niri.focusWindow(modelData.id)
                    }
                }
            }
        }

        MouseArea {
            id: hoverArea
            anchors.fill: parent
            enabled: dockWindow.isShown && !Niri.launcherOpen && !Niri.suppressDock && !Niri.overviewOpen
            hoverEnabled: true
            acceptedButtons: Qt.NoButton
            onExited: hideTimer.restart()
        }
    }
}
</file>

<file path="config/quickshell/.config/quickshell/widgets/BarDrawer.qml">
import QtQuick
import Quickshell
import Quickshell.Wayland
import "../services"

PanelWindow {
    id: drawerWindow

    required property string menuName
    required property real contentHeight
    property real panelWidth: 340
    property real rightOffset: 12
    property bool centered: false

    readonly property bool isOpen: Niri.activeBarMenu === menuName
    readonly property real topConcave: 12
    readonly property real bottomRadius: 16
    readonly property real targetHeight: contentHeight + 28

    anchors {
        top: true
        bottom: true
        left: true
        right: true
    }

    margins {
        top: 30
    }

    color: "transparent"
    visible: isOpen || drawerContainer.height > 0.5
    exclusionMode: ExclusionMode.Ignore
    mask: isOpen ? null : emptyRegion

    WlrLayershell.layer: WlrLayer.Overlay
    WlrLayershell.namespace: "quickshell-bar-drawer"
    WlrLayershell.keyboardFocus: isOpen ? WlrKeyboardFocus.OnDemand : WlrKeyboardFocus.None

    default property alias body: innerContent.data

    Region { id: emptyRegion }

    MouseArea {
        anchors.fill: parent
        enabled: drawerWindow.isOpen
        onClicked: Niri.closeBarMenu()
    }

    Item {
        id: drawerContainer
        anchors.top: parent.top
        anchors.right: drawerWindow.centered ? undefined : parent.right
        anchors.rightMargin: drawerWindow.centered ? 0 : Math.max(0, drawerWindow.rightOffset - drawerWindow.topConcave)
        anchors.horizontalCenter: drawerWindow.centered ? parent.horizontalCenter : undefined

        width: drawerWindow.panelWidth + (drawerWindow.topConcave * 2)
        height: drawerWindow.isOpen ? drawerWindow.targetHeight : 0
        visible: height > 0.5
        clip: true

        // Estirado fluido al desplegar desde la barra y recogida rápida al guardar
        Behavior on height {
            NumberAnimation {
                duration: drawerWindow.isOpen ? 260 : 200
                easing.type: drawerWindow.isOpen ? Easing.OutExpo : Easing.InCubic
            }
        }

        Connections {
            target: Theme
            function onBgChanged() { bgCanvas.requestPaint(); }
            function onCardAltChanged() { bgCanvas.requestPaint(); }
        }

        function syncSeamGap() {
            if (drawerWindow.isOpen || height > 0.5) {
                Niri.activeBarDrawerX = x;
                Niri.activeBarDrawerWidth = width;
            } else if (Niri.activeBarMenu === "") {
                Niri.activeBarDrawerWidth = 0;
            }
        }

        onXChanged: syncSeamGap()
        onWidthChanged: {
            bgCanvas.requestPaint();
            syncSeamGap();
        }
        onHeightChanged: {
            bgCanvas.requestPaint();
            syncSeamGap();
        }

        Canvas {
            id: bgCanvas
            anchors.fill: parent
            antialiasing: true

            onPaint: {
                const ctx = getContext("2d");
                ctx.reset();

                const w = width;
                const h = height;
                if (h <= 0.5) return;

                // Escala proporcionalmente las curvas cuando el cajón está casi cerrado
                const c = Math.min(drawerWindow.topConcave, h * 0.45);
                const r = Math.min(drawerWindow.bottomRadius, Math.max(0, h - c));
                const leftX = c;
                const rightX = w - c;

                function buildOutline() {
                    ctx.beginPath();
                    ctx.moveTo(0, 0);
                    ctx.quadraticCurveTo(leftX, 0, leftX, c);
                    ctx.lineTo(leftX, h - r);
                    ctx.quadraticCurveTo(leftX, h, leftX + r, h);
                    ctx.lineTo(rightX - r, h);
                    ctx.quadraticCurveTo(rightX, h, rightX, h - r);
                    ctx.lineTo(rightX, c);
                    ctx.quadraticCurveTo(rightX, 0, w, 0);
                }

                buildOutline();
                ctx.closePath();
                ctx.fillStyle = Theme.bg.toString();
                ctx.fill();

                buildOutline();
                ctx.strokeStyle = Theme.cardAlt.toString();
                ctx.lineWidth = 1;
                ctx.stroke();
            }
        }

        MouseArea {
            anchors.fill: parent
        }

        // Anclado al borde inferior del cajón: el contenido emerge desde la barra al estirarse
        // y se guarda hacia arriba sin aplastarse
        Item {
            id: innerContent
            anchors {
                bottom: parent.bottom
                left: parent.left
                right: parent.right
                bottomMargin: 18
                leftMargin: drawerWindow.topConcave + 14
                rightMargin: drawerWindow.topConcave + 14
            }
            height: drawerWindow.contentHeight
        }
    }
}
</file>

<file path="scripts/set-wallpaper">
#!/usr/bin/env bash
set -euo pipefail

WALL="${1:-}"
if [ -z "$WALL" ] || [ ! -f "$WALL" ]; then
    echo "Uso: set-wallpaper /ruta/a/imagen" >&2
    exit 1
fi

ABS_WALL="$(realpath "$WALL")"
STATE_DIR="$HOME/.local/state/quickshell"
OVERVIEW_WALL="$STATE_DIR/overview-wallpaper.jpg"
mkdir -p "$STATE_DIR"

# 1. Actualiza enlace de estado para LockScreen y persistencia
ln -sf "$ABS_WALL" "$STATE_DIR/current-wallpaper"

# 2. Aplica wallpaper nítido en el escritorio con awww
if command -v awww >/dev/null 2>&1; then
    if ! pgrep -x awww-daemon >/dev/null 2>&1; then
        awww-daemon --format xrgb >/dev/null 2>&1 &
        sleep 0.3
    fi
    awww img "$ABS_WALL" --transition-type grow --transition-pos 0.5,0.5 --transition-duration 0.9 --transition-fps 60
fi

# 3. Genera versión difuminada con textura y contraste para el backdrop del Overview
if command -v swaybg >/dev/null 2>&1; then
    if command -v magick >/dev/null 2>&1; then
        magick "$ABS_WALL" -resize 1920x1080^ -gravity center -extent 1920x1080 \
               -blur 0x9 -modulate 68,110,100 "$OVERVIEW_WALL" 2>/dev/null || cp "$ABS_WALL" "$OVERVIEW_WALL"
    else
        cp "$ABS_WALL" "$OVERVIEW_WALL"
    fi

    OLD_PID=$(pgrep -x swaybg || true)
    setsid -f swaybg -i "$OVERVIEW_WALL" -m fill >/dev/null 2>&1
    sleep 0.15
    if [ -n "$OLD_PID" ]; then
        kill $OLD_PID 2>/dev/null || true
    fi
fi

# 4. Extrae paleta dinámica con matugen (con soporte garantizado para WebP/AVIF)
if command -v matugen >/dev/null 2>&1; then
    mkdir -p "$HOME/.config/niri" "$HOME/.local/state/matugen"
    if ! matugen image "$ABS_WALL" --source-color-index 0 2>/dev/null; then
        TMP_PNG="/tmp/matugen-wallpaper-fallback.png"
        if command -v dwebp >/dev/null 2>&1; then
            dwebp "$ABS_WALL" -o "$TMP_PNG" >/dev/null 2>&1
        elif command -v ffmpeg >/dev/null 2>&1; then
            ffmpeg -y -i "$ABS_WALL" -vframes 1 "$TMP_PNG" >/dev/null 2>&1
        fi
        [ -f "$TMP_PNG" ] && matugen image "$TMP_PNG" --source-color-index 0
    fi
fi
</file>

<file path="config/niri/.config/niri/modules/07-binds-user.kdl">
binds {
    // --- AYUDA ---
    // Muestra la ventana emergente con el resumen de atajos activos
    Mod+Shift+Slash { show-hotkey-overlay; }

    // --- APLICACIONES PRINCIPALES ---
    Mod+Return hotkey-overlay-title="Open terminal" { spawn "ghostty"; }
    Mod+Alt+B hotkey-overlay-title="OpenBrowser" { spawn "firefox"; }
    Mod+F { spawn "ghostty" "-e" "zsh" "-ic" "y; exec zsh"; }
    Mod+W { spawn "ghostty" "-e" "btop";}

   // --- QUICKSHELL --
    Mod+Space { spawn "qs" "ipc" "call" "launcher" "toggle"; }
    Mod+Alt+L { spawn "qs" "ipc" "call" "lock" "lock"; }
    Mod+Shift+W hotkey-overlay-title="Selector de wallpapers" { spawn "qs" "ipc" "call" "wallpaper" "toggle"; }
    Mod+M hotkey-overlay-title="Reproductor multimedia" { spawn "qs" "ipc" "call" "media" "toggle"; }
    // Ejemplo para lanzar una función de Bash interactiva en Ghostty (como tu selector de proyectos):
    // Mod+Alt+P hotkey-overlay-title="Selector de proyectos" { spawn "ghostty" "-e" "bash" "-ic" "pp; exec bash"; }

    // --- GESTIÓN BÁSICA DE VENTANAS Y COLUMNAS ---
    Mod+Q repeat=false { close-window; }
    Mod+O repeat=false { toggle-overview; }

    // Maximizar columna (respeta gaps y barras) vs Pantalla completa real
    Mod+Alt+F       { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+C       { center-column; }

    // Alternar entre los anchos predefinidos en 03-layout.kdl (33%, 50%, 66%, 100%)
    Mod+R       { switch-preset-column-width; }
    Mod+Shift+R { switch-preset-column-width-back; }

    // Ajuste fino de ancho y alto
    Mod+Minus       { set-column-width "-10%"; }
    Mod+Equal       { set-column-width "+10%"; }
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }

    // Ventanas flotantes y pestañas dentro de una columna
    Mod+V       { toggle-window-floating; }
    Mod+Shift+V { switch-focus-between-floating-and-tiling; }
    Mod+Alt+W       { toggle-column-tabbed-display; }

    // Agrupar/expulsar ventanas dentro de una misma columna vertical
    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }

    // --- NAVEGACIÓN DE FOCO (Flechas y estilo Vim) ---
    Mod+Left  { focus-column-left; }
    Mod+Down  { focus-window-down; }
    Mod+Up    { focus-window-up; }
    Mod+Right { focus-column-right; }

    Mod+H { focus-column-left; }
    Mod+J { focus-window-down; }
    Mod+K { focus-window-up; }
    Mod+L { focus-column-right; }

    // --- MOVER VENTANAS / COLUMNAS ---
    Mod+Ctrl+Left  { move-column-left; }
    Mod+Ctrl+Down  { move-window-down; }
    Mod+Ctrl+Up    { move-window-up; }
    Mod+Ctrl+Right { move-column-right; }

    Mod+Ctrl+H { move-column-left; }
    Mod+Ctrl+J { move-window-down; }
    Mod+Ctrl+K { move-window-up; }
    Mod+Ctrl+L { move-column-right; }

    // --- ESPACIOS DE TRABAJO (Workspaces verticales) ---
    // Cambiar entre workspaces (arriba/abajo)
    Mod+Page_Down { focus-workspace-down; }
    Mod+Page_Up   { focus-workspace-up; }
    Mod+U         { focus-workspace-down; }
    Mod+I         { focus-workspace-up; }

    // Mover columna al workspace superior/inferior
    Mod+Ctrl+Page_Down { move-column-to-workspace-down; }
    Mod+Ctrl+Page_Up   { move-column-to-workspace-up; }
    Mod+Ctrl+U         { move-column-to-workspace-down; }
    Mod+Ctrl+I         { move-column-to-workspace-up; }

    // Acceso directo por número (1 al 9)
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }

    Mod+Ctrl+1 { move-column-to-workspace 1; }
    Mod+Ctrl+2 { move-column-to-workspace 2; }
    Mod+Ctrl+3 { move-column-to-workspace 3; }
    Mod+Ctrl+4 { move-column-to-workspace 4; }
    Mod+Ctrl+5 { move-column-to-workspace 5; }
    Mod+Ctrl+6 { move-column-to-workspace 6; }
    Mod+Ctrl+7 { move-column-to-workspace 7; }
    Mod+Ctrl+8 { move-column-to-workspace 8; }
    Mod+Ctrl+9 { move-column-to-workspace 9; }

    // Alternar rápidamente con el workspace anterior
    Mod+Tab { focus-workspace-previous; }

    // --- RUEDA DEL RATÓN / TOUCHPAD CON MOD ---
    Mod+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp   cooldown-ms=150 { focus-workspace-up; }
    Mod+WheelScrollRight                { focus-column-right; }
    Mod+WheelScrollLeft                 { focus-column-left; }
  }
