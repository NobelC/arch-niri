<file path="config/quickshell/.config/quickshell/widgets/battery/BatteryMenu.qml">
import QtQuick
import QtQuick.Layouts
import Quickshell
import "../../services"
import "../"

BarDrawer {
    id: drawer
    menuName: "battery"
    panelWidth: 320
    rightOffset: 62
    contentHeight: root.implicitHeight

    ColumnLayout {
        id: root
        width: parent.width
        spacing: 10

        readonly property color stateColor: {
            if (Battery.charging || Battery.full) return Theme.accent;
            if (Battery.capacity <= 15) return Theme.warn;
            if (Battery.capacity <= 30) return Theme.highlight;
            return Theme.accentSoft;
        }

        readonly property string statusSubtitle: {
            if (Battery.full) return "Fully charged";
            if (Battery.charging) {
                return Battery.timeFormatted !== ""
                    ? ("Charging  ·  " + Battery.timeFormatted + " until full")
                    : "Charging";
            }
            if (Battery.timeFormatted !== "") {
                return Battery.timeFormatted + " remaining";
            }
            return Battery.status;
        }

        function batteryIcon() {
            if (Battery.charging) return "󰂄";
            if (Battery.full) return "󰁹";
            const c = Battery.capacity;
            if (c >= 90) return "󰁹";
            if (c >= 75) return "󰂁";
            if (c >= 55) return "󰁿";
            if (c >= 35) return "󰁽";
            if (c >= 15) return "󰁻";
            return "󰂎";
        }

        // ---------- Cabecera integrada ----------
        RowLayout {
            Layout.fillWidth: true
            spacing: 10

            Rectangle {
                width: 32
                height: 32
                radius: 9
                color: Theme.cardAlt

                Text {
                    anchors.centerIn: parent
                    text: root.batteryIcon()
                    color: root.stateColor
                    font.family: Theme.fontFamily
                    font.pixelSize: 15
                }
            }

            ColumnLayout {
                Layout.fillWidth: true
                spacing: 1

                Text {
                    text: "Battery  ·  " + Battery.capacity + "%"
                    color: Theme.text
                    font.family: Theme.fontFamily
                    font.pixelSize: 13
                    font.bold: true
                }
                Text {
                    Layout.fillWidth: true
                    text: root.statusSubtitle
                    color: Theme.sub
                    font.family: Theme.fontFamily
                    font.pixelSize: 11
                    elide: Text.ElideRight
                }
            }
        }

        // ---------- Tarjeta de carga y métricas ----------
        Rectangle {
            Layout.fillWidth: true
            implicitHeight: statsCol.implicitHeight + 22
            radius: 12
            color: Theme.card

            ColumnLayout {
                id: statsCol
                anchors.left: parent.left
                anchors.right: parent.right
                anchors.top: parent.top
                anchors.margins: 11
                spacing: 9

                // Barra de progreso de batería
                Rectangle {
                    Layout.fillWidth: true
                    implicitHeight: 6
                    radius: 3
                    color: Theme.cardAlt

                    Rectangle {
                        width: parent.width * Math.max(0, Math.min(1, Battery.capacity / 100.0))
                        height: parent.height
                        radius: 3
                        color: root.stateColor

                        Behavior on width { NumberAnimation { duration: 250; easing.type: Easing.OutCubic } }
                        Behavior on color { ColorAnimation { duration: 200 } }
                    }
                }

                // Métricas: Consumo, Salud, Ciclos
                RowLayout {
                    Layout.fillWidth: true

                    Text {
                        Layout.fillWidth: true
                        text: Battery.charging ? "Charge rate" : "Power draw"
                        color: Theme.muted
                        font.family: Theme.fontFamily
                        font.pixelSize: 11
                    }
                    Text {
                        text: Battery.powerWatts > 0 ? (Battery.powerWatts.toFixed(1) + " W") : "—"
                        color: Theme.text
                        font.family: Theme.fontFamily
                        font.pixelSize: 11
                        font.bold: true
                    }
                }

                RowLayout {
                    Layout.fillWidth: true

                    Text {
                        Layout.fillWidth: true
                        text: "Battery health"
                        color: Theme.muted
                        font.family: Theme.fontFamily
                        font.pixelSize: 11
                    }
                    Text {
                        text: Battery.healthPercent + "%" + (Battery.cycleCount > 0 ? "  (" + Battery.cycleCount + " cycles)" : "")
                        color: Battery.healthPercent < 80 ? Theme.warn : Theme.text
                        font.family: Theme.fontFamily
                        font.pixelSize: 11
                    }
                }
            }
        }

        // ---------- Selector de Perfil de Energía (powerprofilesctl) ----------
        Text {
            visible: Battery.hasPowerProfiles
            text: "Power profile"
            color: Theme.sub
            font.family: Theme.fontFamily
            font.pixelSize: 11
        }

        RowLayout {
            visible: Battery.hasPowerProfiles
            Layout.fillWidth: true
            spacing: 6

            Repeater {
                model: [
                    { id: "power-saver", label: "Saver", glyph: "󰌪" },
                    { id: "balanced",    label: "Balanced", glyph: "󰗑" },
                    { id: "performance", label: "Perf", glyph: "󱐋" }
                ]

                delegate: Rectangle {
                    id: profBtn
                    required property var modelData
                    readonly property bool selected: Battery.activeProfile === modelData.id

                    Layout.fillWidth: true
                    implicitHeight: 36
                    radius: 9
                    color: selected ? Theme.accent : (profHover.containsMouse ? Theme.cardAlt : Theme.card)

                    Behavior on color { ColorAnimation { duration: 150 } }

                    Row {
                        anchors.centerIn: parent
                        spacing: 5

                        Text {
                            anchors.verticalCenter: parent.verticalCenter
                            text: profBtn.modelData.glyph
                            color: profBtn.selected ? Theme.bg : Theme.accentSoft
                            font.family: Theme.fontFamily
                            font.pixelSize: 13
                        }
                        Text {
                            anchors.verticalCenter: parent.verticalCenter
                            text: profBtn.modelData.label
                            color: profBtn.selected ? Theme.bg : Theme.text
                            font.family: Theme.fontFamily
                            font.pixelSize: 11
                            font.bold: profBtn.selected
                        }
                    }

                    MouseArea {
                        id: profHover
                        anchors.fill: parent
                        hoverEnabled: true
                        cursorShape: Qt.PointingHandCursor
                        onClicked: Battery.setPowerProfile(profBtn.modelData.id)
                    }
                }
            }
        }
    }
}
</file>

<file path="config/quickshell/.config/quickshell/widgets/bluetooth/BluetoothMenu.qml">
import QtQuick
import QtQuick.Layouts
import Quickshell
import Quickshell.Bluetooth as QsBt
import "../../services"
import "../"

BarDrawer {
    id: drawer
    menuName: "bluetooth"
    panelWidth: 340
    rightOffset: 18
    contentHeight: root.implicitHeight

    ColumnLayout {
        id: root
        width: parent.width
        spacing: 10

        readonly property bool active: drawer.isOpen
        readonly property real maxListHeight: 5 * 52

        readonly property var adapter: QsBt.Bluetooth.defaultAdapter
        readonly property bool hasAdapter: adapter !== null && adapter !== undefined
        readonly property bool adapterOn: hasAdapter && adapter.enabled
        readonly property bool scanning: adapterOn && adapter.discovering

        readonly property var devices: {
            if (!adapter)
                return [];

            const list = adapter.devices.values.slice();
            list.sort((a, b) => {
                if (a.connected !== b.connected)
                    return a.connected ? -1 : 1;
                if (a.paired !== b.paired)
                    return a.paired ? -1 : 1;
                return (a.name || "").localeCompare(b.name || "");
            });
            return list;
        }

        readonly property var connectedList: devices.filter(d => d.connected)
        readonly property int connectedCount: connectedList.length

        readonly property string subtitle: {
            if (!hasAdapter)
                return "No adapter";
            if (!adapterOn)
                return "Off";
            if (connectedCount === 1)
                return connectedList[0].name && connectedList[0].name.length > 0 ? connectedList[0].name : connectedList[0].address;
            if (connectedCount > 1)
                return connectedCount + " devices connected";
            return scanning ? "Searching…" : "On  ·  nothing connected";
        }

        // ---------- Utilidades ----------
        function glyphFor(dev) {
            const i = (dev.icon || "").toLowerCase();
            if (i.indexOf("headset") >= 0 || i.indexOf("headphone") >= 0)
                return "";
            if (i.indexOf("audio") >= 0 || i.indexOf("speaker") >= 0)
                return "";
            if (i.indexOf("keyboard") >= 0)
                return "";
            if (i.indexOf("mouse") >= 0)
                return "";
            if (i.indexOf("gaming") >= 0 || i.indexOf("joystick") >= 0)
                return "";
            if (i.indexOf("phone") >= 0)
                return "";
            if (i.indexOf("computer") >= 0 || i.indexOf("laptop") >= 0)
                return "";
            if (i.indexOf("display") >= 0 || i.indexOf("tv") >= 0)
                return "";
            if (i.indexOf("printer") >= 0)
                return "";
            if (i.indexOf("camera") >= 0)
                return "";
            return "";
        }

        function deviceName(dev) {
            return dev.name && dev.name.length > 0 ? dev.name : dev.address;
        }

        function updateDiscovery() {
            if (adapter)
                adapter.discovering = root.active && root.adapterOn;
        }

        onActiveChanged: root.updateDiscovery()
        onAdapterOnChanged: root.updateDiscovery()
        Component.onCompleted: root.updateDiscovery()
        Component.onDestruction: {
            if (adapter)
                adapter.discovering = false;
        }

        // ---------- Aviso reutilizable ----------
        component Hint: Rectangle {
            id: hint
            property string hintIcon: ""
            property string hintText: ""
            property string hintSub: ""

            Layout.fillWidth: true
            implicitHeight: hintCol.implicitHeight + 24
            radius: 12
            color: Theme.card

            Column {
                id: hintCol
                anchors.centerIn: parent
                spacing: 3

                Text {
                    anchors.horizontalCenter: parent.horizontalCenter
                    visible: hint.hintIcon !== ""
                    text: hint.hintIcon
                    color: Theme.muted
                    font.family: Theme.fontFamily
                    font.pixelSize: 20
                }
                Text {
                    anchors.horizontalCenter: parent.horizontalCenter
                    text: hint.hintText
                    color: Theme.text
                    font.family: Theme.fontFamily
                    font.pixelSize: 12
                }
                Text {
                    anchors.horizontalCenter: parent.horizontalCenter
                    visible: hint.hintSub !== ""
                    text: hint.hintSub
                    color: Theme.muted
                    font.family: Theme.fontFamily
                    font.pixelSize: 10
                }
            }
        }

        // ---------- Cabecera integrada ----------
        RowLayout {
            Layout.fillWidth: true
            spacing: 10

            Rectangle {
                width: 32
                height: 32
                radius: 9
                color: (root.adapterOn && root.connectedCount > 0) ? Theme.cardAlt : Theme.card

                Text {
                    anchors.centerIn: parent
                    text: (root.adapterOn && root.connectedCount > 0) ? "󰂱" : ""
                    color: (root.adapterOn && root.connectedCount > 0) ? Theme.highlight : Theme.muted
                    font.family: Theme.fontFamily
                    font.pixelSize: 15
                }
            }

            ColumnLayout {
                Layout.fillWidth: true
                spacing: 1

                Text {
                    text: "Bluetooth"
                    color: Theme.text
                    font.family: Theme.fontFamily
                    font.pixelSize: 13
                    font.bold: true
                }
                Text {
                    Layout.fillWidth: true
                    text: root.subtitle
                    color: Theme.sub
                    font.family: Theme.fontFamily
                    font.pixelSize: 11
                    elide: Text.ElideRight
                }
            }

            // Botón respaldo técnico (bluetui)
            Rectangle {
                width: 26
                height: 26
                radius: 7
                color: tuiHover.containsMouse ? Theme.cardAlt : "transparent"

                Text {
                    anchors.centerIn: parent
                    text: ""
                    color: Theme.sub
                    font.family: Theme.fontFamily
                    font.pixelSize: 13
                }

                MouseArea {
                    id: tuiHover
                    anchors.fill: parent
                    hoverEnabled: true
                    cursorShape: Qt.PointingHandCursor
                    onClicked: {
                        Niri.closeBarMenu();
                        Bluetooth.openManager();
                    }
                }
            }

            // Interruptor On/Off
            Rectangle {
                width: 40
                height: 22
                radius: 11
                opacity: root.hasAdapter ? 1.0 : 0.4
                color: root.adapterOn ? Theme.accent : Theme.cardAlt

                Behavior on color { ColorAnimation { duration: 150 } }

                Rectangle {
                    width: 16
                    height: 16
                    radius: 8
                    y: 3
                    x: root.adapterOn ? 21 : 3
                    color: root.adapterOn ? Theme.bg : Theme.sub

                    Behavior on x { NumberAnimation { duration: 150; easing.type: Easing.OutCubic } }
                }

                MouseArea {
                    anchors.fill: parent
                    enabled: root.hasAdapter
                    cursorShape: Qt.PointingHandCursor
                    onClicked: root.adapter.enabled = !root.adapter.enabled
                }
            }
        }

        // ---------- Avisos de estado ----------
        Hint {
            visible: !root.hasAdapter
            hintIcon: "󰂲"
            hintText: "No Bluetooth adapter found"
        }
        Hint {
            visible: root.hasAdapter && !root.adapterOn
            hintIcon: "󰂲"
            hintText: "Bluetooth is off"
            hintSub: "Turn it on to connect your devices"
        }

        // ---------- Título de sección + buscar ----------
        RowLayout {
            visible: root.adapterOn
            Layout.fillWidth: true

            Text {
                Layout.fillWidth: true
                text: root.devices.length > 0 ? "Devices  ·  " + root.devices.length : "Devices"
                color: Theme.sub
                font.family: Theme.fontFamily
                font.pixelSize: 11
            }

            Rectangle {
                implicitWidth: scanText.implicitWidth + 20
                implicitHeight: 24
                radius: 8
                color: root.scanning ? Theme.accent : (scanArea.containsMouse ? Theme.cardAlt : Theme.card)

                Text {
                    id: scanText
                    anchors.centerIn: parent
                    text: root.scanning ? "Stop" : "Scan"
                    color: root.scanning ? Theme.bg : Theme.text
                    font.family: Theme.fontFamily
                    font.pixelSize: 11
                    font.bold: root.scanning
                }
                MouseArea {
                    id: scanArea
                    anchors.fill: parent
                    hoverEnabled: true
                    cursorShape: Qt.PointingHandCursor
                    onClicked: root.adapter.discovering = !root.adapter.discovering
                }
            }
        }

        // ---------- Lista ----------
        ListView {
            id: list
            visible: root.adapterOn && root.devices.length > 0
            Layout.fillWidth: true
            Layout.preferredHeight: Math.min(contentHeight, root.maxListHeight)
            clip: true
            spacing: 3
            boundsBehavior: Flickable.StopAtBounds
            model: root.devices

            delegate: Rectangle {
                id: row
                required property var modelData
                readonly property var dev: modelData
                readonly property bool lowBattery: dev.batteryAvailable && dev.battery <= 0.2

                width: list.width
                height: 49
                radius: 10
                color: dev.connected ? Theme.card : (rowArea.containsMouse ? Theme.cardAlt : "transparent")

                Rectangle {
                    id: tile
                    anchors.left: parent.left
                    anchors.leftMargin: 8
                    anchors.verticalCenter: parent.verticalCenter
                    width: 32
                    height: 32
                    radius: 10
                    color: row.dev.connected ? Theme.accent : Theme.cardAlt

                    Text {
                        anchors.centerIn: parent
                        text: root.glyphFor(row.dev)
                        color: row.dev.connected ? Theme.bg : Theme.muted
                        font.family: Theme.fontFamily
                        font.pixelSize: 14
                    }
                }

                Column {
                    anchors.left: tile.right
                    anchors.leftMargin: 10
                    anchors.right: actionButton.left
                    anchors.rightMargin: 8
                    anchors.verticalCenter: parent.verticalCenter
                    spacing: 1

                    Text {
                        width: parent.width
                        elide: Text.ElideRight
                        text: root.deviceName(row.dev)
                        color: row.dev.connected ? Theme.text : Theme.sub
                        font.family: Theme.fontFamily
                        font.pixelSize: 12
                        font.bold: row.dev.connected
                    }

                    Row {
                        spacing: 6

                        Text {
                            text: row.dev.connected ? "Connected" : (row.dev.paired ? "Paired" : "Available")
                            color: Theme.muted
                            font.family: Theme.fontFamily
                            font.pixelSize: 10
                        }

                        Row {
                            visible: row.dev.connected && row.dev.batteryAvailable
                            spacing: 4
                            anchors.verticalCenter: parent.verticalCenter

                            Rectangle {
                                anchors.verticalCenter: parent.verticalCenter
                                width: 20
                                height: 6
                                radius: 3
                                color: Theme.cardAlt

                                Rectangle {
                                    width: parent.width * Math.max(0, Math.min(1, row.dev.battery))
                                    height: parent.height
                                    radius: 3
                                    color: row.lowBattery ? Theme.warn : Theme.accent
                                }
                            }
                            Text {
                                text: Math.round(row.dev.battery * 100) + "%"
                                color: row.lowBattery ? Theme.warn : Theme.muted
                                font.family: Theme.fontFamily
                                font.pixelSize: 10
                            }
                        }
                    }
                }

                Rectangle {
                    id: actionButton
                    anchors.right: parent.right
                    anchors.rightMargin: 8
                    anchors.verticalCenter: parent.verticalCenter
                    width: 84
                    height: 28
                    radius: 8
                    color: actionArea.containsMouse ? Theme.border : (row.dev.connected ? Theme.cardAlt : Theme.card)

                    Text {
                        anchors.centerIn: parent
                        text: row.dev.connected ? "Disconnect" : (row.dev.paired ? "Connect" : "Pair")
                        color: Theme.text
                        font.family: Theme.fontFamily
                        font.pixelSize: 10
                        font.bold: true
                    }

                    MouseArea {
                        id: actionArea
                        anchors.fill: parent
                        hoverEnabled: true
                        cursorShape: Qt.PointingHandCursor
                        onClicked: {
                            if (row.dev.connected)
                                row.dev.disconnect();
                            else if (row.dev.paired)
                                row.dev.connect();
                            else
                                row.dev.pair();
                        }
                    }
                }

                MouseArea {
                    id: rowArea
                    anchors.fill: parent
                    hoverEnabled: true
                    acceptedButtons: Qt.NoButton
                }
            }
        }

        Hint {
            visible: root.adapterOn && root.devices.length === 0
            hintIcon: "󰂲"
            hintText: root.scanning ? "Searching for devices…" : "No devices found"
            hintSub: root.scanning ? "" : "Press Scan to look again"
        }
    }
}
</file>

<file path="config/quickshell/.config/quickshell/widgets/clock/DashboardMenu.qml">
import QtQuick
import QtQuick.Layouts
import Quickshell
import "../../services"
import "../"

BarDrawer {
    id: drawer
    menuName: "dashboard"
    centered: true
    panelWidth: 720
    contentHeight: root.implicitHeight

    Item {
        id: root
        width: parent.width
        implicitHeight: 300

        readonly property real gap: 12
        readonly property real colA: 150
        readonly property real colB: 290
        readonly property real colC: width - colA - colB - gap * 2

        SystemClock {
            id: clock
            precision: SystemClock.Minutes
        }

        readonly property var weekdays: ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"]
        readonly property var months: ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"]

        readonly property int daysLeft: {
            const d = clock.date;
            const end = new Date(d.getFullYear(), 11, 31);
            const today = new Date(d.getFullYear(), d.getMonth(), d.getDate());
            return Math.round((end - today) / 86400000);
        }

        // ---------- Componentes internos ----------
        component ResBar: Column {
            property real value: 0
            property string glyph: ""
            property color barColor: Theme.accent
            property real barHeight: 70

            spacing: 5

            Rectangle {
                anchors.horizontalCenter: parent.horizontalCenter
                width: 14
                height: barHeight
                radius: 7
                color: Theme.cardAlt

                Rectangle {
                    anchors.bottom: parent.bottom
                    width: parent.width
                    height: Math.max(width, parent.height * Math.max(0, Math.min(1, value)))
                    radius: width / 2
                    color: barColor

                    Behavior on height {
                        NumberAnimation {
                            duration: 400
                            easing.type: Easing.OutCubic
                        }
                    }
                }
            }
            Text {
                anchors.horizontalCenter: parent.horizontalCenter
                text: glyph
                color: Theme.sub
                font.family: Theme.fontFamily
                font.pixelSize: 13
            }
            Text {
                anchors.horizontalCenter: parent.horizontalCenter
                text: Math.round(value * 100) + "%"
                color: Theme.text
                font.family: Theme.fontFamily
                font.pixelSize: 10
            }
        }

        component InfoTile: Column {
            property string glyph: ""
            property string label: ""
            property string value: ""

            spacing: 2

            Row {
                spacing: 6

                Text {
                    text: glyph
                    color: Theme.accent
                    font.family: Theme.fontFamily
                    font.pixelSize: 11
                }
                Text {
                    text: label
                    color: Theme.muted
                    font.family: Theme.fontFamily
                    font.pixelSize: 10
                }
            }
            Text {
                width: parent.width
                text: value !== "" ? value : "--"
                elide: Text.ElideRight
                color: Theme.text
                font.family: Theme.fontFamily
                font.pixelSize: 12
            }
        }

        // ================= Columna A: reloj + recursos =================
        Rectangle {
            id: clockCard
            x: 0
            y: 0
            width: root.colA
            height: 144
            radius: 16
            color: Theme.card

            Column {
                anchors.centerIn: parent
                spacing: 2

                Text {
                    anchors.horizontalCenter: parent.horizontalCenter
                    text: Qt.formatDateTime(clock.date, "HH")
                    color: Theme.text
                    font.family: Theme.fontFamily
                    font.pixelSize: 32
                    font.weight: Font.Light
                }
                Row {
                    anchors.horizontalCenter: parent.horizontalCenter
                    spacing: 5

                    Repeater {
                        model: 3
                        Rectangle {
                            width: 5
                            height: 5
                            radius: 2.5
                            color: Theme.accent
                        }
                    }
                }
                Text {
                    anchors.horizontalCenter: parent.horizontalCenter
                    text: Qt.formatDateTime(clock.date, "mm")
                    color: Theme.text
                    font.family: Theme.fontFamily
                    font.pixelSize: 32
                    font.weight: Font.Light
                }
                Text {
                    anchors.horizontalCenter: parent.horizontalCenter
                    topPadding: 4
                    text: root.weekdays[(clock.date.getDay() + 6) % 7] + ", " + clock.date.getDate() + " " + root.months[clock.date.getMonth()].slice(0, 3)
                    color: Theme.sub
                    font.family: Theme.fontFamily
                    font.pixelSize: 11
                }
                Text {
                    anchors.horizontalCenter: parent.horizontalCenter
                    text: root.daysLeft === 0 ? "Last day of the year" : root.daysLeft + (root.daysLeft === 1 ? " day left" : " days left")
                    color: Theme.muted
                    font.family: Theme.fontFamily
                    font.pixelSize: 10
                }
            }
        }

        Rectangle {
            x: 0
            y: clockCard.height + root.gap
            width: root.colA
            height: root.height - y
            radius: 16
            color: Theme.card

            Row {
                anchors.centerIn: parent
                spacing: 16

                ResBar {
                    barHeight: Math.max(40, parent.parent.height - 74)
                    value: SystemStats.cpuUsage
                    glyph: "\uf2db"
                    barColor: Theme.accent
                }
                ResBar {
                    barHeight: Math.max(40, parent.parent.height - 74)
                    value: SystemStats.memFraction
                    glyph: "\uf233"
                    barColor: Theme.accentSoft
                }
                ResBar {
                    barHeight: Math.max(40, parent.parent.height - 74)
                    value: SystemStats.diskFraction
                    glyph: "\uf1c0"
                    barColor: Theme.highlight
                }
            }
        }

        // ================= Columna B: calendario =================
        Rectangle {
            id: cal
            x: root.colA + root.gap
            y: 0
            width: root.colB
            height: root.height
            radius: 16
            color: Theme.card

            property var view: new Date(clock.date.getFullYear(), clock.date.getMonth(), 1)

            function shift(n) {
                cal.view = new Date(cal.view.getFullYear(), cal.view.getMonth() + n, 1);
            }

            function reset() {
                cal.view = new Date(clock.date.getFullYear(), clock.date.getMonth(), 1);
            }

            readonly property var cells: {
                const y = cal.view.getFullYear();
                const m = cal.view.getMonth();
                const t = clock.date;
                const offset = (new Date(y, m, 1).getDay() + 6) % 7;
                const out = [];
                for (let i = 0; i < 42; i++) {
                    const d = new Date(y, m, 1 - offset + i);
                    out.push({
                        day: d.getDate(),
                        other: d.getMonth() !== m,
                        today: d.getFullYear() === t.getFullYear() && d.getMonth() === t.getMonth() && d.getDate() === t.getDate()
                    });
                }
                return out;
            }

            ColumnLayout {
                anchors.fill: parent
                anchors.margins: 14
                spacing: 6

                RowLayout {
                    Layout.fillWidth: true
                    spacing: 4

                    Text {
                        Layout.fillWidth: true
                        text: root.months[cal.view.getMonth()] + " " + cal.view.getFullYear()
                        color: Theme.text
                        font.family: Theme.fontFamily
                        font.pixelSize: 14
                        font.bold: true

                        MouseArea {
                            anchors.fill: parent
                            cursorShape: Qt.PointingHandCursor
                            onClicked: cal.reset()
                        }
                    }

                    Repeater {
                        model: [
                            { glyph: "\uf053", step: -1 },
                            { glyph: "\uf054", step: 1 }
                        ]

                        delegate: Item {
                            required property var modelData
                            Layout.preferredWidth: 26
                            Layout.preferredHeight: 26

                            Rectangle {
                                anchors.fill: parent
                                radius: 13
                                color: navArea.containsMouse ? Theme.cardAlt : "transparent"
                            }
                            Text {
                                anchors.centerIn: parent
                                text: parent.modelData.glyph
                                color: Theme.sub
                                font.family: Theme.fontFamily
                                font.pixelSize: 11
                            }
                            MouseArea {
                                id: navArea
                                anchors.fill: parent
                                hoverEnabled: true
                                cursorShape: Qt.PointingHandCursor
                                onClicked: cal.shift(parent.modelData.step)
                            }
                        }
                    }
                }

                GridLayout {
                    Layout.alignment: Qt.AlignHCenter
                    columns: 7
                    columnSpacing: 0
                    rowSpacing: 2

                    Repeater {
                        model: root.weekdays

                        Text {
                            required property string modelData
                            Layout.preferredWidth: 36
                            Layout.preferredHeight: 24
                            horizontalAlignment: Text.AlignHCenter
                            verticalAlignment: Text.AlignVCenter
                            text: modelData
                            color: Theme.text
                            font.family: Theme.fontFamily
                            font.pixelSize: 11
                            font.bold: true
                        }
                    }

                    Repeater {
                        model: cal.cells

                        delegate: Item {
                            required property var modelData
                            Layout.preferredWidth: 36
                            Layout.preferredHeight: 32

                            Rectangle {
                                anchors.centerIn: parent
                                width: 28
                                height: 28
                                radius: 14
                                visible: parent.modelData.today
                                color: Theme.accent
                            }
                            Text {
                                anchors.centerIn: parent
                                text: parent.modelData.day
                                color: parent.modelData.today ? Theme.bg : (parent.modelData.other ? Theme.muted : Theme.text)
                                font.family: Theme.fontFamily
                                font.pixelSize: 12
                                font.bold: parent.modelData.today
                            }
                        }
                    }
                }

                Item {
                    Layout.fillHeight: true
                }
            }
        }

        // ================= Columna C: información del sistema =================
        Rectangle {
            x: root.colA + root.colB + root.gap * 2
            y: 0
            width: root.colC
            height: root.height
            radius: 16
            color: Theme.card

            ColumnLayout {
                anchors.fill: parent
                anchors.margins: 16
                spacing: 10

                RowLayout {
                    Layout.fillWidth: true
                    spacing: 12

                    Text {
                        text: "\uf303"
                        color: Theme.accent
                        font.family: Theme.fontFamily
                        font.pixelSize: 34
                    }
                    ColumnLayout {
                        Layout.fillWidth: true
                        spacing: 1

                        Text {
                            Layout.fillWidth: true
                            text: SystemStats.userName !== "" ? SystemStats.userName + "@" + SystemStats.hostName : "--"
                            elide: Text.ElideRight
                            color: Theme.text
                            font.family: Theme.fontFamily
                            font.pixelSize: 13
                            font.bold: true
                        }
                        Text {
                            Layout.fillWidth: true
                            text: SystemStats.osName
                            elide: Text.ElideRight
                            color: Theme.sub
                            font.family: Theme.fontFamily
                            font.pixelSize: 11
                        }
                    }
                }

                Rectangle {
                    Layout.fillWidth: true
                    Layout.preferredHeight: 1
                    color: Theme.cardAlt
                }

                GridLayout {
                    Layout.fillWidth: true
                    columns: 2
                    columnSpacing: 12
                    rowSpacing: 12

                    InfoTile {
                        Layout.fillWidth: true
                        Layout.preferredWidth: 1
                        glyph: "\uf17c"
                        label: "Kernel"
                        value: SystemStats.kernel
                    }
                    InfoTile {
                        Layout.fillWidth: true
                        Layout.preferredWidth: 1
                        glyph: "\uf2d0"
                        label: "WM"
                        value: SystemStats.wmName
                    }
                    InfoTile {
                        Layout.fillWidth: true
                        Layout.preferredWidth: 1
                        glyph: "\uf120"
                        label: "Shell"
                        value: SystemStats.shellName
                    }
                    InfoTile {
                        Layout.fillWidth: true
                        Layout.preferredWidth: 1
                        glyph: "\uf017"
                        label: "Uptime"
                        value: SystemStats.uptimeShort
                    }
                    InfoTile {
                        Layout.fillWidth: true
                        Layout.preferredWidth: 1
                        glyph: "\uf187"
                        label: "Packages"
                        value: SystemStats.pkgCount
                    }
                    InfoTile {
                        Layout.fillWidth: true
                        Layout.preferredWidth: 1
                        glyph: "\uf2db"
                        label: "Threads"
                        value: SystemStats.coreCount
                    }
                }

                Item {
                    Layout.fillHeight: true
                }

                Rectangle {
                    Layout.fillWidth: true
                    Layout.preferredHeight: 1
                    color: Theme.cardAlt
                }

                Text {
                    Layout.fillWidth: true
                    text: SystemStats.cpuModel !== "" ? SystemStats.cpuModel : "--"
                    elide: Text.ElideRight
                    color: Theme.sub
                    font.family: Theme.fontFamily
                    font.pixelSize: 10
                }
            }
        }

        Connections {
            target: Niri
            function onActiveBarMenuChanged() {
                if (Niri.activeBarMenu === "dashboard") {
                    cal.reset();
                    SystemStats.refresh();
                }
            }
        }
    }
}
