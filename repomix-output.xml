<file path="scripts/auto-permission-add">
#!/usr/bin/env bash
set -euo pipefail

SCRIPTS_DIR="$HOME/Projects/arch-niri/scripts"
BIN_TARGET="$HOME/.local/bin"

mkdir -p "$BIN_TARGET"

# Si pasas nombres como argumentos, valida solo esos; si no, revisa toda la carpeta scripts/
if [ $# -gt 0 ]; then
  TARGETS=()
  for arg in "$@"; do
    if [ -f "$arg" ]; then
      TARGETS+=("$(realpath "$arg")")
    elif [ -f "$SCRIPTS_DIR/$arg" ]; then
      TARGETS+=("$SCRIPTS_DIR/$arg")
    else
      echo "✗ No encontrado: $arg" >&2
    fi
  done
else
  mapfile -t TARGETS < <(find "$SCRIPTS_DIR" -maxdepth 1 -type f | sort)
fi

validate_syntax() {
  local file="$1"
  local first_line
  first_line=$(head -n 1 "$file")

  case "$first_line" in
    *bash*)
      bash -n "$file" || return 1
      if command -v shellcheck &>/dev/null; then
        shellcheck --severity=warning "$file" || return 1
      fi
      ;;
    *sh*)
      sh -n "$file" || return 1
      if command -v shellcheck &>/dev/null; then
        shellcheck --severity=warning "$file" || return 1
      fi
      ;;
    *python*)
      python3 -m py_compile "$file" || return 1
      ;;
    *)
      echo "  ⚠ Sin shebang reconocido en $file (se omitirá validación estricta)"
      return 0
      ;;
  esac
}
for script in "${TARGETS[@]}"; do
  name=$(basename "$script")
  clean_name="${name%.*}" # Permite tener script.sh en el repo y llamarlo 'script' en terminal

  if validate_syntax "$script"; then
    chmod +x "$script"
    ln -sf "$script" "$BIN_TARGET/$clean_name"
    echo "✓ [$name] Sintaxis válida -> Permisos +x y enlazado como '$clean_name'"
  else
    chmod -x "$script" 2>/dev/null || true
    echo "✗ [$name] Error de sintaxis -> Permisos denegados" >&2
  fi
done
</file>

<file path="scripts/auto-stow">
#!/usr/bin/env bash
set -euo pipefail

DOTFILES_DIR="$HOME/Projects/arch-niri"
CONFIG_DIR="$DOTFILES_DIR/config"
SCRIPTS_DIR="$DOTFILES_DIR/scripts"

# 1. Limpia enlaces simbólicos rotos que apunten al repositorio
find "$HOME" -maxdepth 3 -xtype l -lname "*Projects/arch-niri*" -delete 2>/dev/null || true

# 2. Enlaza los paquetes dentro de config/ hacia $HOME
if [ $# -gt 0 ]; then
  PACKAGES=("$@")
else
  mapfile -t PACKAGES < <(find "$CONFIG_DIR" -mindepth 1 -maxdepth 1 -type d -printf "%f\n" | sort)
fi

echo "-> Enlazando paquetes desde config/: ${PACKAGES[*]}"
stow -R -v -d "$CONFIG_DIR" -t "$HOME" "${PACKAGES[@]}"

# 3. Valida sintaxis, otorga +x y enlaza todos los scripts mediante auto-permission-add
echo "-> Validando y enlazando scripts..."
bash "$SCRIPTS_DIR/auto-permission-add"

echo "✓ Dotfiles y scripts actualizados correctamente."
</file>

