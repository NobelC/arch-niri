<file path="config/quickshell/.config/quickshell/widgets/BarDrawer.qml">
import QtQuick
import Quickshell
import Quickshell.Wayland
import "../services"

PanelWindow {
    id: drawerWindow

    required property string menuName
    required property real contentHeight
    property real panelWidth: 340
    property real rightOffset: 12

    readonly property bool isOpen: Niri.activeBarMenu === menuName
    readonly property real topConcave: 12
    readonly property real bottomRadius: 16
    readonly property real targetHeight: contentHeight + 28

    anchors {
        top: true
        bottom: true
        left: true
        right: true
    }

    margins.top: 30 // Justo debajo de Bar.qml (implicitHeight: 30)
    color: "transparent"
    visible: true
    exclusionMode: ExclusionMode.Ignore
    mask: isOpen ? null : emptyRegion

    WlrLayershell.layer: WlrLayer.Overlay
    WlrLayershell.namespace: "quickshell-bar-drawer"
    WlrLayershell.keyboardFocus: isOpen ? WlrKeyboardFocus.OnDemand : WlrKeyboardFocus.None

    Region { id: emptyRegion }

    // Cierra el menú al hacer clic fuera
    MouseArea {
        anchors.fill: parent
        enabled: drawerWindow.isOpen
        onClicked: Niri.closeBarMenu()
    }

    Item {
        id: drawerContainer
        anchors.top: parent.top
        anchors.right: parent.right
        anchors.rightMargin: Math.max(0, drawerWindow.rightOffset - drawerWindow.topConcave)

        width: drawerWindow.panelWidth + (drawerWindow.topConcave * 2)
        height: drawerWindow.isOpen ? drawerWindow.targetHeight : 0
        opacity: drawerWindow.isOpen ? 1.0 : 0.0
        visible: height > 1 || opacity > 0.01
        clip: true

        Behavior on height {
            NumberAnimation {
                duration: 210
                easing.type: drawerWindow.isOpen ? Easing.OutCubic : Easing.InCubic
            }
        }

        Behavior on opacity {
            NumberAnimation { duration: 150 }
        }

        Connections {
            target: Theme
            function onBgChanged() { bgCanvas.requestPaint(); }
            function onCardAltChanged() { bgCanvas.requestPaint(); }
        }

        onWidthChanged: bgCanvas.requestPaint()
        onHeightChanged: bgCanvas.requestPaint()

        // Silueta con esquinas superiores cóncavas hacia afuera y borde superior abierto
        Canvas {
            id: bgCanvas
            anchors.fill: parent
            antialiasing: true

            onPaint: {
                const ctx = getContext("2d");
                ctx.reset();

                const w = width;
                const h = height;
                if (h <= 2) return;

                const c = drawerWindow.topConcave;
                const r = Math.min(drawerWindow.bottomRadius, (h - c) / 2);
                const leftX = c;
                const rightX = w - c;

                function buildOutline() {
                    ctx.beginPath();
                    // Empieza en extremo superior izquierdo (falda cóncava)
                    ctx.moveTo(0, 0);
                    ctx.quadraticCurveTo(leftX, 0, leftX, c);
                    // Baja hasta esquina inferior izquierda redondeada
                    ctx.lineTo(leftX, h - r);
                    ctx.quadraticCurveTo(leftX, h, leftX + r, h);
                    // Borde inferior
                    ctx.lineTo(rightX - r, h);
                    // Esquina inferior derecha redondeada
                    ctx.quadraticCurveTo(rightX, h, rightX, h - r);
                    // Sube hasta falda cóncava superior derecha
                    ctx.lineTo(rightX, c);
                    ctx.quadraticCurveTo(rightX, 0, w, 0);
                }

                // Relleno fundido con la barra
                buildOutline();
                ctx.closePath();
                ctx.fillStyle = Theme.bg.toString();
                ctx.fill();

                // Trazo solo en laterales y abajo (sin línea arriba para fusionarse con Bar)
                buildOutline();
                ctx.strokeStyle = Theme.cardAlt.toString();
                ctx.lineWidth = 1;
                ctx.stroke();
            }
        }

        // Bloquea clics internos para que no cierren el menú
        MouseArea {
            anchors.fill: parent
        }

        default property alias body: innerContent.data

        Item {
            id: innerContent
            anchors {
                top: parent.top
                left: parent.left
                right: parent.right
                topMargin: 10
                leftMargin: drawerWindow.topConcave + 14
                rightMargin: drawerWindow.topConcave + 14
            }
            height: drawerWindow.contentHeight
        }
