Ctrl+RIGHT frame-step

# Playlist
> playlist-next
< playlist-prev
Ctrl+p script-message-to playlistmanager playlistmanager show playlist

# Velocidad
[ add speed -0.1
] add speed 0.1
BS set speed 1.0

# Bucle A-B
l ab-loop

# Volumen/audio
9 add volume -5
0 add volume 5
WHEEL_UP add volume 2
WHEEL_DOWN add volume -2
m cycle mute
+ add audio-delay 0.1
- add audio-delay -0.1

# Pistas
j cycle sub
J cycle sub down
k cycle audio
K cycle audio down
v cycle sub-visibility
u cycle-values sub-scale 0.8 1.0 1.2 1.5

# Aspecto
