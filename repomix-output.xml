<file path="config/niri/.config/niri/modules/05-window-rules.kdl">
// --- REGLAS GENERALES ---

// Aplica esquinas redondeadas, fuerza el modo columna (sin fullscreen ni flotante por defecto) y usa el 100% de ancho
window-rule {
    geometry-corner-radius 10
    clip-to-geometry true
    open-floating false
    open-fullscreen false
    default-column-width { proportion 1.0; }
}

// --- REGLAS ESPECÍFICAS ---

// Abre utilidades de audio, red y Bluetooth como ventanas flotantes
window-rule {
    match app-id=r#"^(pavucontrol|nm-connection-editor|blueman-manager)$"#
    open-floating true
}

// Mantiene flotantes las ventanas Picture-in-Picture del navegador
window-rule {
    match title="^Picture-in-Picture$"
    open-floating true
}

// Oculta KeePassXC al compartir pantalla o grabar video
window-rule {
    match app-id=r#"^org\.keepassxc\.KeePassXC$"#
    block-out-from "screen-capture"
}

window-rule {
    match app-id=r#"^mpv$"#
    open-fullscreen true
}

window-rule {
    match app-id=r#"^tui\.(float|popup)$"#
    open-floating true
    default-column-width { proportion 0.50; }
    default-window-height { proportion 0.60; }
}

window-rule {
    match app-id="^(wps|wpp|et|wpspdf)$"
    open-maximized true
}

window-rule {
    match app-id="^(wps|wpp|et|wpspdf|wpsoffice)$" title=".*(License|Agreement|Settings|Options|Save|Open).*"
    open-floating true
}

// Ventana principal de Steam en mosaico / maximizada
window-rule {
    match app-id="^steam$" title="^Steam$"
    open-maximized true
}

// Ventanas emergentes de Steam (Amigos, Chat, Ofertas/Anuncios, Ajustes) flotantes
window-rule {
    match app-id="^steam$"
    exclude title="^Steam$"
    open-floating true
}
</file>

<file path="config/niri/.config/niri/modules/06-binds-system.kdl">
binds {
    // --- AUDIO (PipeWire / WirePlumber) ---
    // "-l 1.0" evita que el volumen supere el 100% para no distorsionar los altavoces
    XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.05+ -l 1.0"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.05-"; }
    XF86AudioMute        allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"; }
    XF86AudioMicMute     allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"; }

    // --- BRILLO DE PANTALLA (backlight) ---
    XF86MonBrightnessUp   allow-when-locked=true { spawn "brightnessctl" "--class=backlight" "set" "+5%"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "--class=backlight" "set" "5%-"; }

    // --- MULTIMEDIA (MPRIS / playerctl) ---
    XF86AudioPlay  allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioPause allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioStop  allow-when-locked=true { spawn "playerctl" "stop"; }
    XF86AudioPrev  allow-when-locked=true { spawn "playerctl" "previous"; }
    XF86AudioNext  allow-when-locked=true { spawn "playerctl" "next"; }

    // --- CAPTURAS DE PANTALLA ---
    Print      { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print  { screenshot-window; }

    // --- ENERGÍA Y BLOQUEO DE PANTALLA ---
    // Apaga el panel al instante (se enciende al mover el ratón o pulsar cualquier tecla)
    Mod+Shift+P { power-off-monitors; }

    // Bloqueo manual inmediato con swaylock
    Mod+Alt+L hotkey-overlay-title="Bloquear pantalla" { spawn "swaylock" "-f"; }

    // Salir de Niri (muestra confirmación para evitar cierres accidentales)
    Mod+Shift+E     { quit; }
    Ctrl+Alt+Delete { quit; }
}
</file>

<file path="config/niri/.config/niri/modules/07-binds-user.kdl">
binds {
    // --- AYUDA ---
    // Muestra la ventana emergente con el resumen de atajos activos
    Mod+Shift+Slash { show-hotkey-overlay; }

    // --- APLICACIONES PRINCIPALES ---
    Mod+Return hotkey-overlay-title="Open terminal" { spawn "ghostty"; }
    Mod+Alt+B hotkey-overlay-title="OpenBrowser" { spawn "firefox"; }
    Mod+F { spawn "ghostty" "-e" "yazi"; }
    Mod+W { spawn "ghostty" "-e" "btop";}

    // --- QUICKSHELL --
    Mod+Space { spawn "qs" "ipc" "call" "launcher" "toggle"; }
    Mod+Alt+L { spawn "qs" "ipc" "call" "lock" "lock"; }

    // Ejemplo para lanzar una función de Bash interactiva en Ghostty (como tu selector de proyectos):
    // Mod+Alt+P hotkey-overlay-title="Selector de proyectos" { spawn "ghostty" "-e" "bash" "-ic" "pp; exec bash"; }

    // --- GESTIÓN BÁSICA DE VENTANAS Y COLUMNAS ---
    Mod+Q repeat=false { close-window; }
    Mod+O repeat=false { toggle-overview; }

    // Maximizar columna (respeta gaps y barras) vs Pantalla completa real
    Mod+Alt+F       { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+C       { center-column; }

    // Alternar entre los anchos predefinidos en 03-layout.kdl (33%, 50%, 66%, 100%)
    Mod+R       { switch-preset-column-width; }
    Mod+Shift+R { switch-preset-column-width-back; }

    // Ajuste fino de ancho y alto
    Mod+Minus       { set-column-width "-10%"; }
    Mod+Equal       { set-column-width "+10%"; }
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }

    // Ventanas flotantes y pestañas dentro de una columna
    Mod+V       { toggle-window-floating; }
    Mod+Shift+V { switch-focus-between-floating-and-tiling; }
    Mod+Alt+W       { toggle-column-tabbed-display; }

    // Agrupar/expulsar ventanas dentro de una misma columna vertical
    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }

    // --- NAVEGACIÓN DE FOCO (Flechas y estilo Vim) ---
    Mod+Left  { focus-column-left; }
    Mod+Down  { focus-window-down; }
    Mod+Up    { focus-window-up; }
    Mod+Right { focus-column-right; }

    Mod+H { focus-column-left; }
    Mod+J { focus-window-down; }
    Mod+K { focus-window-up; }
    Mod+L { focus-column-right; }

    // --- MOVER VENTANAS / COLUMNAS ---
    Mod+Ctrl+Left  { move-column-left; }
    Mod+Ctrl+Down  { move-window-down; }
    Mod+Ctrl+Up    { move-window-up; }
    Mod+Ctrl+Right { move-column-right; }

    Mod+Ctrl+H { move-column-left; }
    Mod+Ctrl+J { move-window-down; }
    Mod+Ctrl+K { move-window-up; }
    Mod+Ctrl+L { move-column-right; }

    // --- ESPACIOS DE TRABAJO (Workspaces verticales) ---
    // Cambiar entre workspaces (arriba/abajo)
    Mod+Page_Down { focus-workspace-down; }
    Mod+Page_Up   { focus-workspace-up; }
    Mod+U         { focus-workspace-down; }
    Mod+I         { focus-workspace-up; }

    // Mover columna al workspace superior/inferior
    Mod+Ctrl+Page_Down { move-column-to-workspace-down; }
    Mod+Ctrl+Page_Up   { move-column-to-workspace-up; }
    Mod+Ctrl+U         { move-column-to-workspace-down; }
    Mod+Ctrl+I         { move-column-to-workspace-up; }

    // Acceso directo por número (1 al 9)
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }

    Mod+Ctrl+1 { move-column-to-workspace 1; }
    Mod+Ctrl+2 { move-column-to-workspace 2; }
    Mod+Ctrl+3 { move-column-to-workspace 3; }
    Mod+Ctrl+4 { move-column-to-workspace 4; }
    Mod+Ctrl+5 { move-column-to-workspace 5; }
    Mod+Ctrl+6 { move-column-to-workspace 6; }
    Mod+Ctrl+7 { move-column-to-workspace 7; }
    Mod+Ctrl+8 { move-column-to-workspace 8; }
    Mod+Ctrl+9 { move-column-to-workspace 9; }

    // Alternar rápidamente con el workspace anterior
    Mod+Tab { focus-workspace-previous; }

    // --- RUEDA DEL RATÓN / TOUCHPAD CON MOD ---
    Mod+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp   cooldown-ms=150 { focus-workspace-up; }
    Mod+WheelScrollRight                { focus-column-right; }
    Mod+WheelScrollLeft                 { focus-column-left; }
  }
</file>

