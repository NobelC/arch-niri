<file path="scripts/install-system">
#!/usr/bin/env bash
set -euo pipefail

if [[ $EUID -ne 0 ]]; then
  echo "✗ Este script debe ejecutarse con sudo:" >&2
  echo "  sudo bash $0" >&2
  exit 1
fi

REAL_USER="${SUDO_USER:-}"
if [[ -z "$REAL_USER" || "$REAL_USER" == "root" ]]; then
  echo "✗ Ejecuta el script usando 'sudo' desde tu usuario normal (no directamente como root)." >&2
  exit 1
fi

REAL_HOME="$(getent passwd "$REAL_USER" | cut -d: -f6)"
DOTFILES_DIR="$REAL_HOME/Projects/arch-niri"
PACKAGES_DIR="$DOTFILES_DIR/packages"
SCRIPTS_DIR="$DOTFILES_DIR/scripts"
ICONS_DIR="$REAL_HOME/Pictures/WebAppIcons"

run_as_user() {
  sudo -u "$REAL_USER" HOME="$REAL_HOME" "$@"
}

read_pkg_list() {
  local file="$1"
  [[ -f "$file" ]] || return 0
  sed -E 's/#.*$//; s/^[[:space:]]+//; s/[[:space:]]+$//' "$file" | grep -v '^$' || true
}

install_pacman_hook() {
  mkdir -p /etc/pacman.d/hooks
  cat > /etc/pacman.d/hooks/99-arch-niri-packages.hook <<EOF
[Trigger]
Operation = Install
Operation = Upgrade
Operation = Remove
Type = Package
Target = *

[Action]
Description = Sincronizando listas de paquetes explícitos en arch-niri...
When = PostTransaction
Exec = /usr/bin/env SUDO_USER=$REAL_USER /usr/bin/bash $SCRIPTS_DIR/sync-packages
EOF
}

echo "============================================================"
echo "  Despliegue completo arch-niri (Usuario: $REAL_USER)"
echo "============================================================"

# 1. Crea carpeta de iconos de WebApps en Pictures
run_as_user mkdir -p "$ICONS_DIR"

# 2. Actualiza repositorios e instala paquetes oficiales (pacman)
mapfile -t PACMAN_PKGS < <(read_pkg_list "$PACKAGES_DIR/pacman.txt")
if [[ ${#PACMAN_PKGS[@]} -gt 0 ]]; then
  echo "-> [1/5] Instalando paquetes de pacman (${#PACMAN_PKGS[@]})..."
  pacman -Syu --needed --noconfirm "${PACMAN_PKGS[@]}"
fi

# 3. Verifica o compila 'paru' si aún no está instalado
if ! command -v paru &>/dev/null; then
  echo "-> [2/5] Instalando paru desde AUR..."
  pacman -S --needed --noconfirm base-devel git
  TMP_PARU="/tmp/paru-build-$REAL_USER"
  rm -rf "$TMP_PARU"
  run_as_user git clone https://aur.archlinux.org/paru.git "$TMP_PARU"
  (
    cd "$TMP_PARU"
    run_as_user makepkg -si --noconfirm
  )
  rm -rf "$TMP_PARU"
fi

# 4. Instala paquetes de AUR con paru (ejecutado como usuario real)
mapfile -t PARU_PKGS < <(read_pkg_list "$PACKAGES_DIR/paru.txt")
if [[ ${#PARU_PKGS[@]} -gt 0 ]]; then
  echo "-> [3/5] Instalando paquetes de AUR con paru (${#PARU_PKGS[@]})..."
  run_as_user paru -S --needed --noconfirm "${PARU_PKGS[@]}"
fi

# 5. Ejecuta auto-stow (enlaza dotfiles + valida y enlaza scripts)
echo "-> [4/5] Enlazando dotfiles y scripts con auto-stow..."
run_as_user bash "$SCRIPTS_DIR/auto-stow"

# 6. Sincroniza e instala todas las WebApps declaradas con Pake
echo "-> [5/5] Sincronizando WebApps de Pake..."
run_as_user bash "$SCRIPTS_DIR/webapp" sync

# 7. Instala el hook de pacman para mantener pacman.txt y paru.txt siempre al día
install_pacman_hook
run_as_user bash "$SCRIPTS_DIR/sync-packages"

# 8. Habilita servicios base del sistema
systemctl enable --now NetworkManager bluetooth 2>/dev/null || true
systemctl enable --now power-profiles-daemon 2>/dev/null || true

echo "============================================================"
echo "✓ Instalación completa finalizada sin errores."
echo "============================================================"
</file>

<file path="scripts/sync-packages">
#!/usr/bin/env bash
set -euo pipefail

# Detecta el usuario real si el hook de pacman lo ejecuta como root
if [[ $EUID -eq 0 && -n "${SUDO_USER:-}" ]]; then
  REAL_USER="$SUDO_USER"
elif [[ $EUID -eq 0 ]]; then
  REAL_USER="NobelC"
else
  REAL_USER="$(id -un)"
fi

REAL_HOME="$(getent passwd "$REAL_USER" | cut -d: -f6)"
DOTFILES_DIR="$REAL_HOME/Projects/arch-niri"
PACKAGES_DIR="$DOTFILES_DIR/packages"
WEBAPPS_FILE="$PACKAGES_DIR/webapps.tsv"

[[ -d "$DOTFILES_DIR" ]] || exit 0
mkdir -p "$PACKAGES_DIR"

# Construye lista de slugs de webapps para excluirlos de paru.txt (ya viven en webapps.tsv)
declare -A WEBAPP_SLUGS=()
if [[ -f "$WEBAPPS_FILE" ]]; then
  while IFS=$'\t' read -r name _rest; do
    [[ -z "$name" || "$name" =~ ^# ]] && continue
    slug=$(echo "$name" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/-/g; s/^-+|-+$//g')
    WEBAPP_SLUGS["$slug"]=1
    WEBAPP_SLUGS["webapp-$slug"]=1
  done < "$WEBAPPS_FILE"
fi

# 1. Paquetes explícitos de repositorios oficiales (sin dependencias)
TMP_PAC="$(mktemp)"
{
  echo "# Paquetes explícitos de repositorios oficiales (generado automáticamente)"
  pacman -Qqen | sort -u
} > "$TMP_PAC"

# 2. Paquetes explícitos de AUR / externos (sin dependencias ni webapps de Pake)
TMP_AUR="$(mktemp)"
{
  echo "# Paquetes explícitos de AUR (generado automáticamente)"
  while IFS= read -r pkg; do
    [[ -z "$pkg" ]] && continue
    if [[ -z "${WEBAPP_SLUGS[$pkg]:-}" ]]; then
      echo "$pkg"
    fi
  done < <(pacman -Qqem | sort -u)
} > "$TMP_AUR"

mv "$TMP_PAC" "$PACKAGES_DIR/pacman.txt"
mv "$TMP_AUR" "$PACKAGES_DIR/paru.txt"
chown "$REAL_USER":"$REAL_USER" "$PACKAGES_DIR/pacman.txt" "$PACKAGES_DIR/paru.txt" 2>/dev/null || true
</file>

<file path="scripts/webapp">
#!/usr/bin/env bash
set -euo pipefail

DOTFILES_DIR="$HOME/Projects/arch-niri"
PACKAGES_DIR="$DOTFILES_DIR/packages"
WEBAPPS_FILE="$PACKAGES_DIR/webapps.tsv"
ICONS_DIR="$HOME/Pictures/WebAppIcons"
BUILD_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/pake-builds"

mkdir -p "$PACKAGES_DIR" "$ICONS_DIR" "$BUILD_DIR"
touch "$WEBAPPS_FILE"

usage() {
  cat <<'EOF'
Uso:
  webapp add "<Nombre>" "<URL>" [nombre_icono] [flags_pake]
  webapp remove "<Nombre>"
  webapp sync
  webapp list

Ejemplos:
  webapp add "Syncthing" "http://127.0.0.1:8384/"
  webapp add "Spotify" "https://open.spotify.com" "spotify" "--width 1280 --height 820"
EOF
}

slugify() {
  echo "$1" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/-/g; s/^-+|-+$//g'
}

resolve_icon() {
  local icon_arg="${1:-}"
  local slug="$2"
  local found=""

  if [[ -n "$icon_arg" ]]; then
    if [[ -f "$icon_arg" ]]; then
      realpath "$icon_arg"
      return 0
    elif [[ -f "$ICONS_DIR/$icon_arg" ]]; then
      realpath "$ICONS_DIR/$icon_arg"
      return 0
    fi

    found=$(find "$ICONS_DIR" -maxdepth 1 -type f \( -iname "$icon_arg" -o -iname "$icon_arg.*" \) | head -n 1 || true)
    if [[ -n "$found" ]]; then
      realpath "$found"
      return 0
    fi
  fi

  found=$(find "$ICONS_DIR" -maxdepth 1 -type f -iname "$slug.*" | head -n 1 || true)
  if [[ -n "$found" ]]; then
    realpath "$found"
    return 0
  fi

  echo ""
}

build_and_install_one() {
  local name="$1"
  local url="$2"
  local icon_raw="${3:-}"
  local extra_flags="${4:-}"
  local slug
  slug="$(slugify "$name")"
  local pkg_name="webapp-$slug"

  if ! command -v pake &>/dev/null; then
    echo "✗ 'pake' no está instalado. Instálalo primero (paru -S pake-cli)." >&2
    exit 1
  fi

  local resolved_icon
  resolved_icon="$(resolve_icon "$icon_raw" "$slug")"

  local workdir="$BUILD_DIR/$slug"
  rm -rf "$workdir"
  mkdir -p "$workdir"

  echo "-> Construyendo WebApp '$name' ($url) como '$pkg_name' con Pake..."
  local pake_cmd=(pake "$url" --name "$pkg_name" --targets zst)

  if [[ -n "$resolved_icon" ]]; then
    echo "   Icono: $resolved_icon"
    pake_cmd+=(--icon "$resolved_icon")
  fi

  if [[ -n "$extra_flags" ]]; then
    local -a flags_arr=()
    read -ra flags_arr <<< "$extra_flags"
    pake_cmd+=("${flags_arr[@]}")
  fi

  (
    cd "$workdir"
    "${pake_cmd[@]}"
  )

  local pkg_file
  pkg_file=$(find "$workdir" -maxdepth 3 -type f -name "*.pkg.tar.*" | head -n 1 || true)

  if [[ -n "$pkg_file" ]]; then
    echo "-> Instalando paquete generado: $(basename "$pkg_file")"
    sudo pacman -U --noconfirm "$pkg_file"
  else
    echo "✗ No se encontró el paquete generado en $workdir" >&2
    return 1
  fi

  echo "✓ WebApp '$name' instalada correctamente como paquete '$pkg_name'."
}

register_webapp() {
  local name="$1"
  local url="$2"
  local icon_raw="${3:-}"
  local extra_flags="${4:-}"
  local slug
  slug="$(slugify "$name")"

  local stored_icon="$icon_raw"
  local resolved
  resolved="$(resolve_icon "$icon_raw" "$slug")"
  if [[ -n "$resolved" ]]; then
    if [[ "$resolved" == "$ICONS_DIR/"* ]]; then
      stored_icon="$(basename "$resolved")"
    else
      stored_icon="${resolved/#$HOME\//~/}"
    fi
  fi

  grep -v -F "${name}"$'\t' "$WEBAPPS_FILE" > "$WEBAPPS_FILE.tmp" || true
  mv "$WEBAPPS_FILE.tmp" "$WEBAPPS_FILE"

  printf "%s\t%s\t%s\t%s\n" "$name" "$url" "$stored_icon" "$extra_flags" >> "$WEBAPPS_FILE"
  echo "✓ Registrada en packages/webapps.tsv"
}

subcmd="${1:-}"
case "$subcmd" in
  add)
    [[ $# -lt 3 ]] && { usage; exit 1; }
    name="$2"
    url="$3"
    icon="${4:-}"
    extra_flags="${5:-}"
    register_webapp "$name" "$url" "$icon" "$extra_flags"
    build_and_install_one "$name" "$url" "$icon" "$extra_flags"
    bash "$DOTFILES_DIR/scripts/sync-packages"
    ;;
  remove)
    [[ $# -lt 2 ]] && { usage; exit 1; }
    name="$2"
    slug="$(slugify "$name")"
    grep -v -F "${name}"$'\t' "$WEBAPPS_FILE" > "$WEBAPPS_FILE.tmp" || true
    mv "$WEBAPPS_FILE.tmp" "$WEBAPPS_FILE"
    sudo pacman -Rns --noconfirm "webapp-$slug" 2>/dev/null || sudo pacman -Rns --noconfirm "$slug" 2>/dev/null || true
    bash "$DOTFILES_DIR/scripts/sync-packages"
    echo "✓ WebApp '$name' eliminada del sistema y del repositorio."
    ;;
  sync)
    while IFS=$'\t' read -r name url icon extra_flags; do
      [[ -z "$name" || "$name" =~ ^# ]] && continue
      slug="$(slugify "$name")"
      icon_expanded="${icon/#\~\//$HOME/}"
      if pacman -Qi "webapp-$slug" &>/dev/null; then
        echo "· [$name] Ya instalada, omitiendo."
      else
        build_and_install_one "$name" "$url" "${icon_expanded:-}" "${extra_flags:-}"
      fi
    done < "$WEBAPPS_FILE"
    ;;
  list)
    column -t -s $'\t' "$WEBAPPS_FILE" 2>/dev/null || cat "$WEBAPPS_FILE"
    ;;
  *)
    usage
    exit 1
    ;;
esac
</file>

