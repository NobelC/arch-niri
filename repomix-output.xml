import Quickshell.Bluetooth as QsBt

Singleton {
    id: root

    readonly property var adapter: QsBt.Bluetooth.defaultAdapter
    readonly property bool powered: adapter !== null && adapter !== undefined && adapter.enabled

    readonly property var connectedDevices: {
        if (!adapter) return [];
        return adapter.devices.values.filter(d => d.connected);
    }

    readonly property int connectedCount: connectedDevices.length
    readonly property bool connected: connectedCount > 0
    readonly property string deviceName: connectedCount > 0
        ? (connectedDevices[0].name || connectedDevices[0].address)
        : ""

    function refresh() {}

    function togglePower() {
        if (adapter) adapter.enabled = !adapter.enabled;
    }

    function openManager() {
        if (adapter && !adapter.enabled) adapter.enabled = true;
        Quickshell.execDetached(["ghostty", "--class=tui.popup", "-e", "bluetui"]);
    }
}
</file>

<file path="config/quickshell/.config/quickshell/services/Brightness.qml">
pragma Singleton
import QtQuick
import Quickshell
import Quickshell.Io

Singleton {
    id: root

    property string deviceDir: ""
    property int maxBrightness: 100
    property int brightness: 0
    property bool initialized: false

    signal osdTriggered()

    Process {
        id: detectDevice
        running: true
        command: [
            "bash", "-c",
            "d=$(ls -d /sys/class/backlight/* 2>/dev/null | head -n1); " +
            "if [ -n \"$d\" ]; then echo \"$d\"; cat \"$d/max_brightness\" 2>/dev/null || echo 100; fi"
        ]
        stdout: StdioCollector {
            onStreamFinished: {
                const lines = this.text.trim().split("\n");
                if (lines.length >= 2 && lines[0] !== "") {
                    root.maxBrightness = Math.max(1, parseInt(lines[1]) || 100);
                    root.deviceDir = lines[0];
                }
            }
        }
    }

    FileView {
        id: curFile
        path: root.deviceDir !== "" ? (root.deviceDir + "/brightness") : ""
        watchChanges: true
        onFileChanged: reload()
        onLoaded: {
            const raw = parseInt(this.text().trim());
            if (!isNaN(raw)) {
                const pct = Math.round((raw * 100) / root.maxBrightness);
                if (root.initialized && pct !== root.brightness) {
                    root.brightness = pct;
                    root.osdTriggered();
                } else {
                    root.brightness = pct;
                    root.initialized = true;
                }
            }
        }
    }

    function refresh() {
        if (root.deviceDir !== "") curFile.reload();
    }
}
</file>

<file path="config/quickshell/.config/quickshell/services/CapsLock.qml">
pragma Singleton
import QtQuick
import Quickshell
import Quickshell.Io

Singleton {
    id: root

    property string ledPath: ""
    property bool active: false
    property bool initialized: false

    signal osdTriggered()

    Process {
        id: detectLed
        running: true
        command: ["bash", "-c", "ls /sys/class/leds/*::capslock/brightness 2>/dev/null | head -n1"]
        stdout: StdioCollector {
            onStreamFinished: {
                const p = this.text.trim();
                if (p !== "") root.ledPath = p;
            }
        }
    }

    FileView {
        id: ledFile
        path: root.ledPath
        watchChanges: true
        onFileChanged: reload()
        onLoaded: {
            const newState = (this.text().trim() === "1");
            if (root.initialized && newState !== root.active) {
                root.active = newState;
                root.osdTriggered();
            } else {
                root.active = newState;
                root.initialized = true;
            }
        }
    }
}
</file>

<file path="config/quickshell/.config/quickshell/services/LockState.qml">
pragma Singleton

import Quickshell
import Quickshell.Io
import Quickshell.Services.Pam
import QtQuick

Singleton {
    id: root

    property string pamService: "login"
    readonly property string home: Quickshell.env("HOME")
    readonly property string stateWallpaperFile: home + "/.local/state/quickshell/current-wallpaper"

    property bool locked: false
    property string buffer: ""
    property string status: "idle"
    property string message: ""
    readonly property bool busy: status === "checking"
    signal failed

    readonly property string user: Quickshell.env("USER") || "usuario"
    property string realName: ""
    readonly property string displayName: {
        const n = realName.trim();
        const base = n !== "" ? n.split(/\s+/)[0] : user;
        return base.charAt(0).toUpperCase() + base.slice(1);
    }

    Process {
        id: nameProc
        running: true
        command: ["sh", "-c", "getent passwd \"$USER\" | cut -d: -f5 | cut -d, -f1"]
        stdout: StdioCollector {
            onStreamFinished: root.realName = text.trim()
        }
    }

    property string currentWallpaper: ""

    Process {
        id: wallQueryProc
        command: ["readlink", "-f", root.stateWallpaperFile]
        stdout: StdioCollector {
            onStreamFinished: {
                const p = this.text.trim();
                if (p !== "") root.currentWallpaper = p;
            }
        }
    }

    FileView {
        id: wallStateWatcher
        path: root.stateWallpaperFile
        watchChanges: true
        onFileChanged: root.refreshWallpaper()
    }

    function refreshWallpaper() {
        if (!wallQueryProc.running) wallQueryProc.running = true;
    }

    Component.onCompleted: refreshWallpaper()

    function lock() {
        if (locked) return;
        refreshWallpaper();
        buffer = "";
        status = "idle";
        message = "";
        locked = true;
    }

    function type(ch) {
        if (busy) return;
        if (status === "error") status = "idle";
        buffer += ch;
    }

    function backspace() {
        if (busy) return;
        buffer = buffer.slice(0, -1);
    }

    function clear() {
        if (busy) return;
        buffer = "";
        if (status === "error") status = "idle";
    }

    function submit() {
        if (busy || buffer.length === 0) return;
        status = "checking";
        message = "";
        pam.config = root.pamService;
        pam.start();
    }

    PamContext {
        id: pam
        config: root.pamService

        onPamMessage: {
            if (responseRequired) respond(root.buffer);
        }

        onCompleted: result => {
            if (result === PamResult.Success) {
                root.buffer = "";
                root.status = "idle";
                root.message = "";
                root.locked = false;
            } else {
                root.buffer = "";
                root.status = "error";
                root.message = result === PamResult.MaxTries ? "Too many attempts" : "Incorrect password";
                root.failed();
            }
        }

        onError: err => {
            root.buffer = "";
            root.status = "error";
            root.message = "Authentication error";
            root.failed();
        }
    }

    IpcHandler {
        target: "lock"
        function lock(): void { root.lock(); }
        function isLocked(): bool { return root.locked; }
    }
}
</file>

<file path="config/quickshell/.config/quickshell/services/Network.qml">
pragma Singleton
import QtQuick
import Quickshell
import Quickshell.Networking

Singleton {
    id: root

    readonly property bool wifiEnabled: Networking.wifiEnabled !== false

    readonly property var activeDevice: {
        const devs = Networking.devices.values;
        for (let i = 0; i < devs.length; i++) {
            if (devs[i].connected) return devs[i];
        }
        return null;
    }

    readonly property string connectionType: {
        if (!activeDevice) return "none";
        if (activeDevice.type === DeviceType.Wifi) return "wifi";
        return "ethernet";
    }

    readonly property var activeWifiNet: {
        if (connectionType !== "wifi" || !activeDevice) return null;
        const nets = activeDevice.networks.values;
        for (let i = 0; i < nets.length; i++) {
            if (nets[i].connected) return nets[i];
        }
        return null;
    }

    readonly property string ssid: activeWifiNet ? activeWifiNet.name : ""
    readonly property int signal: activeWifiNet ? Math.round(activeWifiNet.signalStrength * 100) : 0

    function refresh() {}

    function toggleWifi() {
        if (Networking.wifiEnabled !== undefined) {
            Networking.wifiEnabled = !Networking.wifiEnabled;
        } else {
            Quickshell.execDetached(["nmcli", "radio", "wifi", wifiEnabled ? "off" : "on"]);
        }
    }

    function openManager() {
        Quickshell.execDetached(["ghostty", "--class=tui.popup", "-e", "nmtui"]);
    }
}
</file>

