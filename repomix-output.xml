<file path="config/quickshell/.config/quickshell/widgets/osd/Osd.qml">
import QtQuick
import Quickshell
import Quickshell.Wayland
import "../../services"

PanelWindow {
    id: osdWindow

    anchors {
        bottom: true
    }
    margins {
        bottom: 15
    }

    implicitWidth: Math.max(190, contentRow.implicitWidth + 36)
    implicitHeight: 42
    color: "transparent"
    visible: true
    exclusionMode: ExclusionMode.Ignore
    mask: Region {}

    WlrLayershell.layer: WlrLayer.Overlay
    WlrLayershell.namespace: "quickshell-osd"

    property string mode: "audio" // "audio" | "brightness" | "capslock" | "layout"
    property bool isShown: false

    readonly property bool isBarMode: mode === "audio" || mode === "brightness"
    readonly property int currentValue: mode === "audio" ? Audio.volume : Brightness.brightness
    readonly property bool isMuted: mode === "audio" && Audio.muted

    function osdIcon() {
        if (mode === "brightness") {
            if (Brightness.brightness < 35) return "󰃞";
            if (Brightness.brightness < 70) return "󰃟";
            return "󰃠";
        }
        if (Audio.muted || Audio.volume === 0) return "󰝟";
        if (Audio.volume < 35) return "";
        if (Audio.volume < 70) return "";
        return "";
    }

    function osdAccentColor() {
        if (mode === "layout") {
            return Niri.keyboardLayoutCode === "ES" ? Theme.highlight : Theme.accentSoft;
        }
        if (mode === "capslock") {
            return CapsLock.active ? Theme.accent : Theme.sub;
        }
        if (mode === "brightness") return Theme.highlight;
        if (Audio.muted) return Theme.warn;
        return Theme.accentSoft;
    }

    function osdLabelText() {
        if (mode === "layout") {
            return Niri.keyboardLayoutCode === "ES" ? "SPANISH (LATAM)" : "ENGLISH (US)";
        }
        if (mode === "capslock") {
            return CapsLock.active ? "CAPS LOCK ON" : "CAPS LOCK OFF";
        }
        return osdWindow.isMuted ? "Mute" : (osdWindow.currentValue + "%");
    }

    function showOsd(newMode) {
        osdWindow.mode = newMode;
        osdWindow.isShown = true;
        hideTimer.restart();
    }

    Timer {
        id: hideTimer
        interval: 1400
        onTriggered: osdWindow.isShown = false
    }

    Connections {
        target: Audio
        function onOsdTriggered() { osdWindow.showOsd("audio"); }
    }

    Connections {
        target: Brightness
        function onOsdTriggered() { osdWindow.showOsd("brightness"); }
    }

    Connections {
        target: CapsLock
        function onOsdTriggered() { osdWindow.showOsd("capslock"); }
    }

    Connections {
        target: Niri
        function onKeyboardLayoutOsdTriggered() { osdWindow.showOsd("layout"); }
    }

    Rectangle {
        id: card
        anchors.fill: parent
        radius: 12
        color: Theme.bg
        border.width: 1
        border.color: Theme.cardAlt

        Behavior on color { ColorAnimation { duration: 150 } }
        Behavior on border.color { ColorAnimation { duration: 150 } }

        opacity: osdWindow.isShown ? 1.0 : 0.0
        transform: Translate {
            y: osdWindow.isShown ? 0 : 16
            Behavior on y {
                NumberAnimation { duration: 180; easing.type: Easing.OutCubic }
            }
        }

        Behavior on opacity {
            NumberAnimation { duration: 160; easing.type: Easing.OutCubic }
        }

        Row {
            id: contentRow
            anchors.centerIn: parent
            spacing: 12

            Text {
                visible: osdWindow.isBarMode
                anchors.verticalCenter: parent.verticalCenter
                text: osdWindow.osdIcon()
                color: osdWindow.osdAccentColor()
                font.family: Theme.fontFamily
                font.pixelSize: 16
            }

            Rectangle {
                visible: osdWindow.isBarMode
                anchors.verticalCenter: parent.verticalCenter
                width: 115
                height: 6
                radius: 3
                color: Theme.cardAlt

                Rectangle {
                    anchors {
                        left: parent.left
                        top: parent.top
                        bottom: parent.bottom
                    }
                    width: parent.width * (osdWindow.isMuted ? 0 : Math.min(100, Math.max(0, osdWindow.currentValue)) / 100.0)
                    radius: 3
                    color: osdWindow.osdAccentColor()

                    Behavior on width {
                        NumberAnimation { duration: 90; easing.type: Easing.OutCubic }
                    }
                    Behavior on color {
                        ColorAnimation { duration: 120 }
                    }
                }
            }

            Text {
                anchors.verticalCenter: parent.verticalCenter
                width: osdWindow.isBarMode ? 34 : implicitWidth
                horizontalAlignment: osdWindow.isBarMode ? Text.AlignRight : Text.AlignHCenter
                text: osdWindow.osdLabelText()
                color: osdWindow.isBarMode ? Theme.text : osdWindow.osdAccentColor()
                font.family: Theme.fontFamily
                font.pixelSize: osdWindow.isBarMode ? 11 : 12
                font.bold: true
                font.letterSpacing: osdWindow.isBarMode ? 0 : 0.8
            }
        }
    }
}
</file>

<file path="config/quickshell/.config/quickshell/widgets/ribbon/RibbonDock.qml">
import QtQuick
import Quickshell
import "../../services"
import "."

PanelWindow {
    id: dockWindow

    anchors {
        bottom: true
        left: true
        right: true
    }

    exclusionMode: ExclusionMode.Ignore
    color: "transparent"

    readonly property int dockHeight: 42
    readonly property int topRadius: 12
    readonly property int scoopRadius: 7
    readonly property int horizontalPadding: 18
    readonly property int bodyWidth: Math.max(84, iconsRow.implicitWidth + horizontalPadding * 2)
    readonly property int totalWidth: bodyWidth + (scoopRadius * 2)

    implicitHeight: dockHeight + 6
    visible: true

    property bool isShown: false

    Timer {
        id: hideTimer
        interval: 1400
        onTriggered: {
            if (!hoverArea.containsMouse) {
                dockWindow.isShown = false;
            }
        }
    }

    Connections {
        target: Niri

        function onLauncherOpenChanged() {
            if (Niri.launcherOpen) {
                hideTimer.stop();
                dockWindow.isShown = false;
            }
        }

        function onRibbonActivity() {
            if (Niri.launcherOpen || Niri.suppressDock) {
                dockWindow.isShown = false;
                return;
            }

            if (Niri.activeRibbonWindows.length > 0) {
                dockWindow.isShown = true;
                hideTimer.restart();
            } else {
                dockWindow.isShown = false;
            }
        }

        function onActiveRibbonWindowsChanged() {
            if (Niri.activeRibbonWindows.length === 0) {
                dockWindow.isShown = false;
            }
        }
    }

    Connections {
        target: Theme
        function onBgChanged() { bgCanvas.requestPaint(); }
        function onCardAltChanged() { bgCanvas.requestPaint(); }
    }

    Item {
        id: dockContainer
        width: dockWindow.totalWidth
        height: dockWindow.dockHeight
        anchors.horizontalCenter: parent.horizontalCenter

        y: dockWindow.isShown ? (parent.height - height) : parent.height

        Behavior on y {
            NumberAnimation {
                id: slideAnim
                duration: 220
                easing.type: Easing.OutCubic
            }
        }

        Behavior on width {
            NumberAnimation { duration: 180; easing.type: Easing.OutCubic }
        }

        onWidthChanged: bgCanvas.requestPaint()
        onHeightChanged: bgCanvas.requestPaint()

        Canvas {
            id: bgCanvas
            anchors.fill: parent
            antialiasing: true

            onPaint: {
                const ctx = getContext("2d");
                ctx.reset();

                const w = width;
                const h = height;
                const rTop = dockWindow.topRadius;
                const rBot = dockWindow.scoopRadius;

                ctx.beginPath();
                ctx.moveTo(0, h);
                ctx.quadraticCurveTo(rBot, h, rBot, h - rBot);
                ctx.lineTo(rBot, rTop);
                ctx.quadraticCurveTo(rBot, 0, rBot + rTop, 0);
                ctx.lineTo(w - rBot - rTop, 0);
                ctx.quadraticCurveTo(w - rBot, 0, w - rBot, rTop);
                ctx.lineTo(w - rBot, h - rBot);
                ctx.quadraticCurveTo(w - rBot, h, w, h);
                ctx.closePath();

                ctx.fillStyle = Theme.bg.toString();
                ctx.fill();

                ctx.strokeStyle = Theme.cardAlt.toString();
                ctx.lineWidth = 1;
                ctx.stroke();
            }
        }

        Row {
            id: iconsRow
            anchors.centerIn: parent
            anchors.verticalCenterOffset: 2
            spacing: 12

            Repeater {
                model: Niri.activeRibbonWindows

                delegate: Item {
                    width: 28
                    height: 28

                    readonly property bool isFocused: modelData.is_focused

                    Rectangle {
                        anchors.fill: parent
                        radius: 8
                        color: isFocused ? Theme.cardAlt : "transparent"
                        border.width: isFocused ? 1 : 0
                        border.color: Theme.accentSoft

                        Behavior on color { ColorAnimation { duration: 150 } }
                        Behavior on border.color { ColorAnimation { duration: 150 } }
                    }

                    Text {
                        anchors.centerIn: parent
                        text: AppGlyphs.resolve(modelData.app_id, modelData.title)
                        color: isFocused ? Theme.accentSoft : Theme.sub
                        font.family: Theme.fontFamily
                        font.pixelSize: 16

                        Behavior on color { ColorAnimation { duration: 150 } }
                    }

                    MouseArea {
                        anchors.fill: parent
                        enabled: dockWindow.isShown
                        cursorShape: Qt.PointingHandCursor
                        onClicked: Niri.focusWindow(modelData.id)
                    }
                }
            }
        }

        MouseArea {
            id: hoverArea
            anchors.fill: parent
            enabled: dockWindow.isShown && !Niri.launcherOpen && !Niri.suppressDock
            hoverEnabled: true
            acceptedButtons: Qt.NoButton
            onExited: hideTimer.restart()
        }
    }
}
</file>

<file path="config/quickshell/.config/quickshell/widgets/wallpaper/WallpaperPicker.qml">
import QtQuick
import QtQuick.Effects
import Quickshell
import Quickshell.Io
import Quickshell.Wayland
import "../../services"

PanelWindow {
    id: pickerWindow

    anchors {
        top: true
        bottom: true
        left: true
        right: true
    }

    color: "transparent"
    visible: true
    exclusionMode: ExclusionMode.Ignore
    mask: isOpen ? null : emptyRegion

    WlrLayershell.layer: WlrLayer.Overlay
    WlrLayershell.namespace: "quickshell-wallpaper"
    WlrLayershell.keyboardFocus: isOpen ? WlrKeyboardFocus.Exclusive : WlrKeyboardFocus.None

    // ---------- Configuración ----------
    readonly property string home: Quickshell.env("HOME")
    readonly property string wallpaperDir: home + "/Pictures/Wallpapers"
    readonly property string setScript: home + "/Projects/arch-niri/scripts/set-wallpaper"

    // Dimensiones (la tarjeta central escala a 1.12x y sobresale visualmente)
    readonly property real cardWidth: 260
    readonly property real cardHeight: 156
    readonly property real centerScale: 1.12
    readonly property real sideScale: 0.85
    readonly property real cardSpacing: 26
    readonly property real targetWidth: (cardWidth * 3) + (cardSpacing * 2) + 56
    readonly property real targetHeight: (cardHeight * centerScale) + 44
    readonly property real orbSize: 22

    // ---------- Estado ----------
    property bool isOpen: false
    property bool expanded: false
    property var wallpapers: []
    property int currentIndex: 0

    // Evita que RibbonDock se active al abrir o cerrar el overlay
    onIsOpenChanged: {
        Niri.notifyLauncherState(isOpen);
    }

    Region { id: emptyRegion }

    // Escanea la carpeta de wallpapers
    Process {
        id: scanProc
        command: [
            "bash", "-c",
            "mkdir -p \"$1\" && find -L \"$1\" -maxdepth 2 -type f " +
            "\\( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' -o -iname '*.avif' \\) " +
            "| sort -V",
            "bash", pickerWindow.wallpaperDir
        ]
        stdout: StdioCollector {
            onStreamFinished: {
                const lines = this.text.trim().split("\n").filter(l => l.length > 0);
                pickerWindow.wallpapers = lines;

                const cur = LockState.currentWallpaper;
                const idx = lines.indexOf(cur);
                if (idx >= 0) {
                    pickerWindow.currentIndex = idx;
                } else if (pickerWindow.currentIndex >= lines.length) {
                    pickerWindow.currentIndex = 0;
                }
            }
        }
    }

    // Proceso dedicado para aplicar el wallpaper (awww + symlink + matugen)
    Process {
        id: applyProc
    }

    function openPicker() {
        if (pickerWindow.isOpen) return;
        scanProc.running = true;
        pickerWindow.expanded = false;
        pickerWindow.isOpen = true;
        openAnim.restart();
        keyHandler.forceActiveFocus();
    }

    function closePicker() {
        if (!pickerWindow.isOpen) return;
        openAnim.stop();
        closeAnim.restart();
    }

    function move(delta) {
        const len = wallpapers.length;
        if (len === 0) return;
        currentIndex = (currentIndex + delta + len) % len;
    }

    function applySelected() {
        if (wallpapers.length === 0) return;
        const selected = wallpapers[currentIndex];
        if (!selected) return;

        LockState.currentWallpaper = selected;
        applyProc.running = false;
        applyProc.command = ["bash", pickerWindow.setScript, selected];
        applyProc.running = true;
        closePicker();
    }

    // IPC: qs ipc call wallpaper toggle
    IpcHandler {
        target: "wallpaper"
        function toggle(): void {
            if (!pickerWindow.isOpen) {
                pickerWindow.openPicker();
            } else {
                pickerWindow.closePicker();
            }
        }
    }

    // ---------- Animación de Apertura (Estela difuminada -> círculo nítido -> expansión) ----------
    SequentialAnimation {
        id: openAnim

        // Estado inicial: estela estirada y difuminada bajo el borde inferior
        ScriptAction {
            script: {
                morphBox.width = 16;
                morphBox.height = 54;
                morphBox.radius = 8;
                morphBox.motionBlur = 0.85;
                morphBox.centerOffsetY = (pickerWindow.height / 2) + 40;
                morphBox.boxOpacity = 0.0;
                pickerWindow.expanded = false;
            }
        }

        // Fase 1: Sube como una estela luminosa con motion blur
        ParallelAnimation {
            NumberAnimation {
                target: morphBox
                property: "centerOffsetY"
                to: 0
                duration: 210
                easing.type: Easing.OutCubic
            }
            NumberAnimation {
                target: morphBox
                property: "boxOpacity"
                to: 1.0
                duration: 110
                easing.type: Easing.OutQuad
            }
            // Se condensa en el círculo perfecto justo al frenar en el centro
            NumberAnimation {
                target: morphBox
                property: "width"
                to: pickerWindow.orbSize
                duration: 210
                easing.type: Easing.OutBack
            }
            NumberAnimation {
                target: morphBox
                property: "height"
                to: pickerWindow.orbSize
                duration: 210
                easing.type: Easing.OutBack
            }
            NumberAnimation {
                target: morphBox
                property: "radius"
                to: pickerWindow.orbSize / 2
                duration: 210
                easing.type: Easing.OutCubic
            }
            NumberAnimation {
                target: morphBox
                property: "motionBlur"
                to: 0.0
                duration: 200
                easing.type: Easing.OutQuad
            }
        }

        // Fase 2: Expansión al rectángulo de 3 wallpapers
        ParallelAnimation {
            NumberAnimation {
                target: morphBox
                property: "width"
                to: pickerWindow.targetWidth
                duration: 230
                easing.type: Easing.OutExpo
            }
            NumberAnimation {
                target: morphBox
                property: "height"
                to: pickerWindow.targetHeight
                duration: 230
                easing.type: Easing.OutExpo
            }
            NumberAnimation {
                target: morphBox
                property: "radius"
                to: 18
                duration: 210
                easing.type: Easing.OutCubic
            }
        }

        ScriptAction {
            script: {
                pickerWindow.expanded = true;
                keyHandler.forceActiveFocus();
            }
        }
    }

    // ---------- Animación de Cierre (Círculo -> estela difuminada hacia abajo) ----------
    SequentialAnimation {
        id: closeAnim

        ScriptAction {
            script: pickerWindow.expanded = false
        }

        ParallelAnimation {
            NumberAnimation {
                target: morphBox
                property: "width"
                to: pickerWindow.orbSize
                duration: 160
                easing.type: Easing.InCubic
            }
            NumberAnimation {
                target: morphBox
                property: "height"
                to: pickerWindow.orbSize
                duration: 160
                easing.type: Easing.InCubic
            }
            NumberAnimation {
                target: morphBox
                property: "radius"
                to: pickerWindow.orbSize / 2
                duration: 160
                easing.type: Easing.InCubic
            }
        }

        ParallelAnimation {
            NumberAnimation {
                target: morphBox
                property: "centerOffsetY"
                to: (pickerWindow.height / 2) + 40
                duration: 190
                easing.type: Easing.InCubic
            }
            NumberAnimation {
                target: morphBox
                property: "width"
                to: 16
                duration: 190
                easing.type: Easing.InCubic
            }
            NumberAnimation {
                target: morphBox
                property: "height"
                to: 54
                duration: 190
                easing.type: Easing.InCubic
            }
            NumberAnimation {
                target: morphBox
                property: "radius"
                to: 8
                duration: 190
            }
            NumberAnimation {
                target: morphBox
                property: "motionBlur"
                to: 0.85
                duration: 170
                easing.type: Easing.InQuad
            }
            NumberAnimation {
                target: morphBox
                property: "boxOpacity"
                to: 0.0
                duration: 180
                easing.type: Easing.InQuad
            }
        }

        ScriptAction {
            script: {
                morphBox.motionBlur = 0.0;
                pickerWindow.isOpen = false;
            }
        }
    }

    MouseArea {
        anchors.fill: parent
        enabled: pickerWindow.isOpen
        onClicked: pickerWindow.closePicker()
    }

    // ---------- Contenedor Morphing ----------
    Rectangle {
        id: morphBox

        property real centerOffsetY: 0
        property real boxOpacity: 0
        property real motionBlur: 0

        anchors.horizontalCenter: parent.horizontalCenter
        anchors.verticalCenter: parent.verticalCenter
        anchors.verticalCenterOffset: centerOffsetY

        width: pickerWindow.orbSize
        height: pickerWindow.orbSize
        radius: pickerWindow.orbSize / 2
        opacity: boxOpacity
        visible: pickerWindow.isOpen && boxOpacity > 0.01

        color: pickerWindow.expanded ? Theme.bg : Theme.accent
        border.width: 2
        border.color: Theme.accent
        clip: true

        // Desenfoque de movimiento mientras la cápsula viaja
        layer.enabled: motionBlur > 0.01
        layer.effect: MultiEffect {
            blurEnabled: true
            blurMax: 28
            blur: morphBox.motionBlur
            autoPaddingEnabled: true
        }

        Behavior on color { ColorAnimation { duration: 160 } }

        MouseArea {
            anchors.fill: parent
        }

        Item {
            id: keyHandler
            anchors.fill: parent
            focus: pickerWindow.isOpen

            Keys.onLeftPressed: pickerWindow.move(-1)
            Keys.onRightPressed: pickerWindow.move(1)
            Keys.onPressed: event => {
                if (event.key === Qt.Key_H) {
                    pickerWindow.move(-1);
                    event.accepted = true;
                } else if (event.key === Qt.Key_L) {
                    pickerWindow.move(1);
                    event.accepted = true;
                } else if (event.key === Qt.Key_Return || event.key === Qt.Key_Enter) {
                    pickerWindow.applySelected();
                    event.accepted = true;
                } else if (event.key === Qt.Key_Escape) {
                    pickerWindow.closePicker();
                    event.accepted = true;
                }
            }
        }

        // ---------- Cinta infinita centrada (solo imágenes) ----------
        Row {
            id: stripRow
            anchors.centerIn: parent
            spacing: pickerWindow.cardSpacing
            visible: pickerWindow.expanded && pickerWindow.wallpapers.length > 0
            opacity: pickerWindow.expanded ? 1.0 : 0.0

            Behavior on opacity {
                NumberAnimation { duration: 150; easing.type: Easing.OutCubic }
            }

            Repeater {
                model: [-1, 0, 1]

                delegate: Item {
                    id: slotItem
                    required property int modelData

                    readonly property int len: pickerWindow.wallpapers.length
                    readonly property int wallIdx: len > 0
                        ? (pickerWindow.currentIndex + modelData + len) % len
                        : -1
                    readonly property string wallPath: wallIdx >= 0 ? pickerWindow.wallpapers[wallIdx] : ""
                    readonly property bool isCenter: modelData === 0

                    width: pickerWindow.cardWidth
                    height: pickerWindow.cardHeight
                    z: isCenter ? 2 : 1

                    Item {
                        id: cardContainer
                        anchors.centerIn: parent
                        width: parent.width
                        height: parent.height

                        scale: slotItem.isCenter ? pickerWindow.centerScale : pickerWindow.sideScale
                        opacity: slotItem.isCenter ? 1.0 : 0.50

                        Behavior on scale {
                            NumberAnimation { duration: 200; easing.type: Easing.OutCubic }
                        }
                        Behavior on opacity {
                            NumberAnimation { duration: 200; easing.type: Easing.OutCubic }
                        }

                        // Fondo de la tarjeta
                        Rectangle {
                            anchors.fill: parent
                            radius: 14
                            color: Theme.card
                        }

                        // Imagen fuente oculta (se renderiza recortada por MultiEffect)
                        Image {
                            id: thumb
                            anchors.fill: parent
                            anchors.margins: 2
                            visible: false
                            source: slotItem.wallPath !== "" ? "file://" + slotItem.wallPath : ""
                            fillMode: Image.PreserveAspectCrop
                            asynchronous: true
                            cache: true
                            sourceSize.width: 640
                            sourceSize.height: 384
                        }

                        // Máscara redondeada para recortar las esquinas de la imagen
                        Rectangle {
                            id: roundMask
                            anchors.fill: thumb
                            radius: 12
                            visible: false
                            layer.enabled: true
                        }

                        MultiEffect {
                            anchors.fill: thumb
                            source: thumb
                            visible: thumb.status === Image.Ready
                            maskEnabled: true
                            maskSource: roundMask
                            maskThresholdMin: 0.5
                            maskSpreadAtMin: 1.0
                        }

                        // Borde exterior encima de la imagen ya recortada
                        Rectangle {
                            anchors.fill: parent
                            radius: 14
                            color: "transparent"
                            border.width: slotItem.isCenter ? 2 : 1
                            border.color: slotItem.isCenter ? Theme.accent : Theme.border

                            Behavior on border.color {
                                ColorAnimation { duration: 150 }
                            }
                        }

                        MouseArea {
                            anchors.fill: parent
                            cursorShape: Qt.PointingHandCursor
                            onClicked: {
                                if (slotItem.isCenter) {
                                    pickerWindow.applySelected();
                                } else {
                                    pickerWindow.move(slotItem.modelData);
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
</file>

